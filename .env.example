# ──────────────────────────────────────────────
# SkooleeAI - Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────

# ── Database (Supabase / PostgreSQL) ──────────
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require&pgbouncer=true"
POSTGRES_PRISMA_URL="postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWT_SECRET=""

# ── Application ───────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET=""  # Generate with: openssl rand -base64 32

# ── Tenant isolation ──────────────────────────
# Postgres row-level security as a second layer behind the application guard.
# Off by default. Read the header of prisma/rls.sql before turning this on —
# it requires a dedicated non-BYPASSRLS database role, and enabling the
# policies while connected as `postgres` silently does nothing.
# TENANT_RLS="on"

# ── AI Providers ──────────────────────────────
# Provider selection: "auto" tries providers in order, or pick one explicitly.
# Default order is OpenAI only, on purpose: this app sends student data to the
# model, and OpenAI is contractually bound (DPA, no training on API data by
# default). Do NOT add pollinations here — it is an unauthenticated public
# endpoint with no data-processing agreement, and children's data must not
# reach it. Prompts are pseudonymized either way (src/lib/ai/pseudonymize.ts)
# and a PII scan blocks any send that still contains a phone/email/CNIC.
AI_PROVIDER="auto"
AI_PROVIDER_ORDER="openai"

# OpenAI (optional)
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Ollama (local, optional)
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# ── Email / SMTP ──────────────────────────────
EMAIL_DEV_MODE="true"        # Set to "false" for real delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""                 # Gmail: use an App Password
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Skoolee AI"

# ── Redis / BullMQ (background workers) ──────
REDIS_URL="redis://localhost:6379"

# ── Payment Gateways ──────────────────────────
# Stripe (for international / US LLC setups)
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_CONNECT_WEBHOOK_SECRET=""  # For /api/stripe/connect-webhook (account.updated)
# STRIPE_BASIC_PRICE_ID=""
# STRIPE_PRO_PRICE_ID=""

# SafePay (HBL's digital payment gateway for Pakistan)
# Get credentials from HBL SafePay Merchant Portal
# SAFEPAY_MERCHANT_ID=""
# SAFEPAY_API_KEY=""
# SAFEPAY_SECRET_KEY=""
# SAFEPAY_PRODUCTION="false"  # Set to "true" for live mode

# ── S3 / R2 Report Storage (optional) ────────
# When not configured, PDFs are stored on local disk.
# S3_REGION="us-east-1"
# S3_ENDPOINT=""             # Set for R2/MinIO compatibility
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME="skooleeai-reports"

# ── WhatsApp Cloud API (optional) ─────────────
# WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_VERIFY_TOKEN=""   # For inbound webhook verification
