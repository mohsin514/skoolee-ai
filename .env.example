# ──────────────────────────────────────────────
# SkooleeAI - Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────

# ── Database (Supabase / PostgreSQL) ──────────
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require&pgbouncer=true"
POSTGRES_PRISMA_URL="postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWT_SECRET=""

# ── Application ───────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET=""  # Generate with: openssl rand -base64 32
# AUTH_SECRET also derives the key that encrypts stored authenticator (MFA)
# secrets. Every deployment that shares a database must use the SAME value, or
# authenticator codes fail there. Never rotate it without setting
# MFA_ENCRYPTION_KEY_PREVIOUS to the old value first.
# Optional dedicated key (at least 32 random bytes: openssl rand -base64 32).
# When rotating, move the old value to MFA_ENCRYPTION_KEY_PREVIOUS.
# MFA_ENCRYPTION_KEY=
# MFA_ENCRYPTION_KEY_PREVIOUS=

# ── Tenant isolation ──────────────────────────
# Postgres row-level security as a second layer behind the application guard.
# Off by default. Read the header of prisma/rls.sql before turning this on —
# it requires a dedicated non-BYPASSRLS database role, and enabling the
# policies while connected as `postgres` silently does nothing.
# TENANT_RLS="on"

# ── AI Providers ──────────────────────────────
# Provider selection: "auto" uses the exact allowlisted order; unknown entries
# fail closed. Only select a destination covered by your school's agreement.
# The public Pollinations service requires the explicit AI_ALLOW_PUBLIC_PROVIDER
# opt-in and must not receive school or child data.
AI_PROVIDER="auto"
AI_PROVIDER_ORDER="openai"
AI_TIMEOUT_MS="20000"
# AI_ALLOW_PUBLIC_PROVIDER="true"   # Explicit public endpoint approval only
# AI_APPROVED_OLLAMA_HOSTS="ollama.school.example:11434" # Exact HTTPS hosts

# OpenAI (optional)
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Ollama (local, optional)
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# ── Email / SMTP ──────────────────────────────
EMAIL_DEV_MODE="true"        # Set to "false" for real delivery
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""                 # Gmail: use an App Password
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Skoolee AI"

# ── Redis / BullMQ (background workers) ──────
REDIS_URL="redis://localhost:6379"

# ── Payment Gateways ──────────────────────────
# Stripe (for international / US LLC setups)
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_CONNECT_WEBHOOK_SECRET=""  # For /api/stripe/connect-webhook (account.updated)
# STRIPE_BASIC_PRICE_ID=""
# STRIPE_PRO_PRICE_ID=""

# SafePay (HBL's digital payment gateway for Pakistan)
# Get credentials from HBL SafePay Merchant Portal
# SAFEPAY_MERCHANT_ID=""
# SAFEPAY_API_KEY=""
# SAFEPAY_SECRET_KEY=""
# SAFEPAY_PRODUCTION="false"  # Set to "true" for live mode

# ── S3 / R2 Report Storage (optional) ────────
# When not configured, PDFs are stored on local disk.
# S3_REGION="us-east-1"
# S3_ENDPOINT=""             # Set for R2/MinIO compatibility
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME="skooleeai-reports"

# ── WhatsApp Cloud API (optional) ─────────────
# WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_VERIFY_TOKEN=""   # For inbound webhook verification

# SKO-457: only for self-hosting behind your own reverse proxies (not needed on Vercel).
# The number of proxies you run in front of the app; rate limits use the client address that
# many entries from the right of X-Forwarded-For. Unset in production off Vercel = no header trusted.
# TRUSTED_PROXY_HOPS=1

# SKO-460: private School AI conversations untouched for this many days are deleted by
# POST /api/cron/conversation-retention (minimum 30, default 365).
# SCHOOL_AI_CONVERSATION_RETENTION_DAYS=365

# Development-only test checkout (src/lib/payments/test-checkout.ts): with `next dev` and no payment keys,
# paid packages open a fake payment page (Pay / Decline / Cancel). Ignored outside NODE_ENV=development.
# ALLOW_TEST_CHECKOUT=true

# Knowledge-library semantic indexing uses the approved OpenAI configuration.
# Set false for keyword-only retrieval; generation still uses the configured AI gateway.
# RAG_EMBEDDINGS_ENABLED=true
# See docs/qa/rag-implementation-2026-10-24.md for publication, media extraction and QA setup.
