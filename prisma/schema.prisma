// Staff records depth: payroll, bank, documents and timeline for faculty.
// Bank details are sensitive — only served by admin-gated routes.
model StaffProfile {
  id                String  @id @default(uuid())
  schoolId          String  @default("") @map("school_id")
  school            School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId            String  @unique @map("user_id")
  designation       String?
  contractType      String? @map("contract_type") // PERMANENT | CONTRACT | PART_TIME
  basicSalary       Int     @default(0) @map("basic_salary") // paisa
  allowancesJson    Json?   @map("allowances_json")
  deductionsJson    Json?   @map("deductions_json")
  bankAccountName   String? @map("bank_account_name")
  bankAccountNumber String? @map("bank_account_number")
  bankName          String? @map("bank_name")
  socialLinksJson   Json?   @map("social_links_json")

  // ─── Where this person sits in the institution ─────────────
  // `designation` above is the legacy free-text label and is mirrored from
  // designationRef on every write, so older screens keep rendering.
  designationId  String?           @map("designation_id")
  designationRef StaffDesignation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  // Cached from the designation so the org chart can sort by seniority, and
  // rank-filter, without loading the ladder. Rewritten whenever the rank moves.
  seniorityLevel Int?              @map("seniority_level")

  primaryDepartmentId String?     @map("primary_department_id")
  primaryDepartment   Department? @relation(fields: [primaryDepartmentId], references: [id], onDelete: SetNull)

  // The solid reporting line, and the only one the chart lays out as structure.
  // Secondary and functional lines live in StaffReportingLine.
  reportsToId String? @map("reports_to_id")
  reportsTo   User?   @relation("StaffManager", fields: [reportsToId], references: [id], onDelete: SetNull)
  // SKO-399: teaching periods per week this person is contracted for. NULL means unknown, and workload
  // then shows the count without a percentage rather than inventing a capacity.
  contractedPeriodsPerWeek Int? @map("contracted_periods_per_week")

  employeeCode     String?               @map("employee_code")
  employmentType   StaffEmploymentType   @default(FULL_TIME) @map("employment_type")
  employmentStatus StaffEmploymentStatus @default(ACTIVE) @map("employment_status")
  probationEndsAt  DateTime?             @map("probation_ends_at")
  contractEndsAt   DateTime?             @map("contract_ends_at")
  // When this person entered their CURRENT rank — the clock that a designation's
  // minYearsInRank is measured against when flagging who is due for promotion.
  rankSince        DateTime?             @map("rank_since")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, seniorityLevel])
  @@index([reportsToId])
  @@index([primaryDepartmentId])
  @@map("staff_profiles")
}

model StaffDocument {
  id         String   @id @default(uuid())
  schoolId   String   @default("") @map("school_id")
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  kind       String // CV | CNIC | DEGREE | CONTRACT | PHOTO | OTHER
  fileKey    String   @map("file_key")
  fileName   String   @map("file_name")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, uploadedAt])
  @@index([schoolId])
  @@map("staff_documents")
}

model StaffTimelineEvent {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  kind      String // PROFILE | SALARY | DESIGNATION | CONTRACT | BANK | DOCUMENT | NOTE
  title     String
  detail    String?
  actorId   String?  @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([schoolId])
  @@map("staff_timeline_events")
}

// ─── Staff hierarchy (Module 8b) ─────────────────────────────
// No two institutions rank their staff the same way. A school has "Senior
// Teacher" over "Teacher"; a college has "Associate Professor"; a university
// nests a "Chairperson" under a "Dean" under a "Vice Chancellor". None of that
// can be an enum without picking a winner, so the ladder itself is DATA: every
// school defines its own designations, and everything downstream — seniority
// order, who may head a department, what a promotion moves someone into — is
// read off those rows rather than hard-coded here.

/**
 * Which side of the institution a rank belongs to.
 */
enum StaffTrack {
  LEADERSHIP // Principal, Dean, Vice Chancellor — runs the institution
  ACADEMIC // teaching faculty
  ADMINISTRATIVE // registrar, accounts, admissions, front desk
  SUPPORT // lab assistants, drivers, security, maintenance
}

enum DepartmentKind {
  FACULTY // university faculty ("Faculty of Science")
  SCHOOL // a school inside a faculty ("School of Computing")
  DEPARTMENT // the common case
  SECTION // Primary / Middle / Senior section of a K-12 school
  ADMIN_UNIT // Accounts, Admissions, IT, Transport — non-teaching
}

enum DepartmentRole {
  HEAD
  DEPUTY_HEAD
  COORDINATOR
  MEMBER
}

enum StaffEmploymentType {
  FULL_TIME
  PART_TIME
  VISITING
  ADJUNCT
  CONTRACT
  INTERN
  VOLUNTEER
}

enum StaffEmploymentStatus {
  PROBATION
  ACTIVE
  ON_LEAVE
  SECONDED
  SUSPENDED
  NOTICE_PERIOD
  RESIGNED
  RETIRED
  TERMINATED
}

/**
 * Why an appointment record was written. Drives the wording of the history.
 */
enum StaffChangeKind {
  JOINED
  CONFIRMED // probation passed
  PROMOTION
  DEMOTION
  LATERAL_MOVE // same level, different post
  DEPARTMENT_TRANSFER
  CAMPUS_TRANSFER
  REPORTING_CHANGE
  ACTING_ASSIGNMENT // holding a post without the rank
  ACTING_ENDED
  CONTRACT_RENEWAL
  SUSPENDED
  REINSTATED
  RESIGNED
  RETIRED
  TERMINATED
}

/**
 * A second reporting line, alongside the solid one on StaffProfile.
 */
enum ReportingLineKind {
  DOTTED // ongoing secondary manager
  FUNCTIONAL // for one function — exams, discipline, admissions
  PROJECT // time-boxed
}

// The rank ladder. School-scoped, not campus-scoped: a group's campuses share
// one vocabulary of ranks even when they staff them differently.
model StaffDesignation {
  id        String  @id @default(uuid())
  schoolId  String  @default("") @map("school_id")
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  shortName String? @map("short_name")

  // Seniority, where LOWER is MORE senior — the head of the institution sits
  // at the smallest number. Presets step by 10 so a school can slot a new rank
  // between two existing ones without renumbering the whole ladder.
  level Int
  track StaffTrack @default(ACADEMIC)

  // What the rank is ALLOWED to be, which is not the same as what it is called.
  // "Senior Teacher" may head a department at one school and not at another.
  canHeadDepartment Boolean @default(false) @map("can_head_department")
  // The root of the org chart. At most one active designation per school.
  isInstitutionHead Boolean @default(false) @map("is_institution_head")

  // The rank this one normally promotes into — a default the promote dialog
  // pre-selects, never a restriction on where someone may be promoted.
  promotesToId String?            @map("promotes_to_id")
  promotesTo   StaffDesignation?  @relation("DesignationLadder", fields: [promotesToId], references: [id], onDelete: SetNull)
  promotesFrom StaffDesignation[] @relation("DesignationLadder")

  // Years normally served before promotion out of this rank. Advisory: it
  // flags who is due, it does not block anything.
  minYearsInRank Int?     @map("min_years_in_rank")
  colorToken     String?  @map("color_token")
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  staffProfiles StaffProfile[]
  appointments  StaffAppointment[]

  @@unique([schoolId, name])
  @@index([schoolId, level])
  @@map("staff_designations")
}

// The unit tree: Faculty → School → Department → Section. A K-12 school uses
// one flat level of it; a university uses all four.
model Department {
  id       String @id @default(uuid())
  schoolId String @default("") @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId String @map("campus_id")
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  parentId String?      @map("parent_id")
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")

  name String
  code String?
  kind DepartmentKind @default(DEPARTMENT)

  // Denormalised pointer to the current head, kept in step with the HEAD row
  // in DepartmentMember. Reading it saves a join on every org-chart render.
  headId String? @map("head_id")
  head   User?   @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  description String?
  colorToken  String?  @map("color_token")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members       DepartmentMember[]
  staffProfiles StaffProfile[]
  appointments  StaffAppointment[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@index([campusId, parentId])
  @@map("departments")
}

// Who belongs to a department, and in what capacity. Separate from the
// reporting line because a teacher can sit in three departments and still
// report to one person.
model DepartmentMember {
  id           String     @id @default(uuid())
  schoolId     String     @default("") @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      DepartmentRole @default(MEMBER)
  // A teacher who takes several departments still has one home department, and
  // that is the one the org chart groups them under.
  isPrimary Boolean        @default(false) @map("is_primary")
  // An acting head stands in without holding the rank.
  isActing  Boolean        @default(false) @map("is_acting")

  startedAt DateTime  @default(now()) @map("started_at")
  // Set when the person leaves. Rows are closed, never deleted, so "who headed
  // Science in 2024" stays answerable.
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([departmentId, endedAt])
  @@index([userId, endedAt])
  @@index([schoolId])
  @@map("department_members")
}

// One row per position a person has held. A promotion closes the open row and
// opens a new one, so the ladder someone climbed is reconstructable years
// later — which is exactly what a service record has to show.
model StaffAppointment {
  id       String @id @default(uuid())
  schoolId String @default("") @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  user     User   @relation("StaffAppointments", fields: [userId], references: [id], onDelete: Cascade)

  changeKind StaffChangeKind @map("change_kind")

  designationId String?           @map("designation_id")
  designation   StaffDesignation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  departmentId  String?           @map("department_id")
  department    Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reportsToId   String?           @map("reports_to_id")
  reportsTo     User?             @relation("AppointmentManager", fields: [reportsToId], references: [id], onDelete: SetNull)

  // Snapshots. A service record has to stay readable after the designation has
  // been renamed and the manager has left, so the names are frozen here rather
  // than resolved through the FKs above (which go null on delete).
  designationName String? @map("designation_name")
  departmentName  String? @map("department_name")
  reportsToName   String? @map("reports_to_name")
  level           Int?

  employmentType   StaffEmploymentType?   @map("employment_type")
  employmentStatus StaffEmploymentStatus? @map("employment_status")
  basicSalary      Int?                   @map("basic_salary") // paisa, as at this appointment

  // "Acting HOD", "Officiating Principal" — holding the post without the rank.
  isActing Boolean @default(false) @map("is_acting")

  effectiveFrom DateTime  @map("effective_from")
  // NULL = the appointment the person currently holds. Exactly one open row.
  effectiveTo   DateTime? @map("effective_to")

  // The office order / notification the change was issued under.
  orderRef String? @map("order_ref")
  notes    String?

  approvedById String?  @map("approved_by_id")
  approvedBy   User?    @relation("AppointmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, effectiveFrom])
  @@index([userId, effectiveTo])
  @@index([schoolId])
  @@map("staff_appointments")
}

// Matrix reporting. A lecturer reports to their HOD for everything, and to the
// Controller of Examinations for exam duty — a single manager field cannot say
// that, so the second line lives here and is drawn dashed on the chart.
model StaffReportingLine {
  id        String @id @default(uuid())
  schoolId  String @default("") @map("school_id")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String @map("user_id")
  user      User   @relation("SecondaryReports", fields: [userId], references: [id], onDelete: Cascade)
  managerId String @map("manager_id")
  manager   User   @relation("SecondaryManagers", fields: [managerId], references: [id], onDelete: Cascade)

  kind  ReportingLineKind @default(DOTTED)
  // What the second line is for — "Exam duty", "Sports", "IT committee".
  label String?

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, endedAt])
  @@index([managerId, endedAt])
  @@index([schoolId])
  @@map("staff_reporting_lines")
}

// ─── Leave Management (Module 9) ─────────────────────────────
// Leave DAYS are stored as Int TENTHS (5 = half a day, 10 = one day) so
// half-days are supported exactly without floating-point drift.
model LeaveType {
  id          String   @id @default(uuid())
  schoolId    String   @default("") @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String   @map("campus_id")
  name        String
  defaultDays Int      @default(0) @map("default_days") // tenths
  createdAt   DateTime @default(now()) @map("created_at")

  campus      Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  allocations LeaveAllocation[]
  requests    LeaveRequest[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("leave_types")
}

model LeaveAllocation {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  leaveTypeId  String   @map("leave_type_id")
  role         String? // UserRole — applies to everyone in the role
  userId       String?  @map("user_id") // per-user override; takes precedence over role
  days         Int      @default(0) // tenths
  academicYear Int      @map("academic_year")
  createdAt    DateTime @default(now()) @map("created_at")

  campus    Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("leave_allocations")
}

model LeaveRequest {
  id            String    @id @default(uuid())
  schoolId      String    @default("") @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String    @map("campus_id")
  userId        String    @map("user_id")
  leaveTypeId   String    @map("leave_type_id")
  fromDate      DateTime  @map("from_date")
  toDate        DateTime  @map("to_date")
  days          Int       @default(10) // tenths
  reason        String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reviewedById  String?   @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewNote    String?   @map("review_note")
  attachmentKey String?   @map("attachment_key")
  createdAt     DateTime  @default(now()) @map("created_at")

  campus     Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])

  @@index([campusId, status])
  @@index([schoolId])
  @@map("leave_requests")
}

// ─── 3d. PAYROLL ──────────────────────────────────────────
// One PayrollRun per campus+month+year. Lines are per staff member;
// a PAID line is immutable — edits only allowed while DRAFT.
model PayrollRun {
  id            String    @id @default(uuid())
  schoolId      String    @default("") @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String    @map("campus_id")
  month         Int // 1-12
  year          Int
  status        String    @default("DRAFT") // DRAFT | FINALIZED
  generatedById String?   @map("generated_by_id")
  generatedAt   DateTime? @map("generated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  campus      Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  generatedBy User?         @relation("PayrollGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  lines       PayrollLine[]

  @@unique([campusId, month, year])
  @@index([schoolId])
  @@map("payroll_runs")
}

model PayrollLine {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payrollRunId    String    @map("payroll_run_id")
  userId          String    @map("user_id")
  basic           Int       @default(0) // paisa
  allowances      Int       @default(0) // paisa
  deductions      Int       @default(0) // paisa
  bonus           Int       @default(0) // paisa
  net             Int       @default(0) // paisa
  breakdownJson   Json?     @map("breakdown_json")
  status          String    @default("UNPAID") // UNPAID | PAID
  paidAt          DateTime? @map("paid_at")
  paymentMethodId String?   @map("payment_method_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  payrollRun    PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethodRef? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  ledgerEntry   LedgerEntry?

  @@unique([payrollRunId, userId])
  @@index([schoolId])
  @@map("payroll_lines")
}

// ─── 4. CLASSES ───────────────────────────────────────────
model Class {
  id             String  @id @default(uuid())
  archivedAt     DateTime? @map("archived_at")
  archiveReason  String?   @map("archive_reason")
  archivePreviousStatus String? @map("archive_previous_status")
  schoolId       String  @default("") @map("school_id")
  school         School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String  @map("campus_id")
  campus         Campus  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name           String
  section        String?
  classTeacherId String? @map("class_teacher_id")
  classTeacher   User?   @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  academicYear   Int     @map("academic_year")
  status         String  @default("ACTIVE") // ACTIVE, COMPLETED
  // How teaching is organised for this section:
  // SINGLE  = the class teacher takes every subject
  // SUBJECT = each subject has its own teacher
  teachingMode   String  @default("SINGLE") @map("teaching_mode")
  // SKO-404: seats for rollover checks; null = not set (warned, never assumed).
  capacity       Int?

  // Relations
  students            Student[]
  subjects            Subject[]
  exams               Exam[]
  feeStructures       FeeStructure[]
  gradeWeightConfigs  GradeWeightConfig[]
  attendance          Attendance[]
  timetables          Timetable[]
  classHistory        StudentClassHistory[]
  feeGroupAssignments FeeGroupAssignment[]
  admissionQueries    AdmissionQuery[]      @relation("QueryClass")
  conversations       Conversation[]

  @@index([schoolId])
  @@map("classes")
}

// ─── 5. STUDENTS ──────────────────────────────────────────
model Student {
  corrections Correction[]
  certificateIssues CertificateIssue[]
  admissionApplications AdmissionApplication[] @relation("ApplicationConversion")
  enrollments StudentEnrollment[]
  enrollmentProposals EnrollmentProposal[]
  consolidatedIntoId String? @map("consolidated_into_id")
  consolidatedInto Student? @relation("ConsolidatedIdentity", fields: [consolidatedIntoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  identityAliases Student[] @relation("ConsolidatedIdentity")
  id                   String    @id @default(uuid())
  archivedAt           DateTime? @map("archived_at")
  archiveReason        String?   @map("archive_reason")
  schoolId             String    @default("") @map("school_id")
  school               School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId             String    @map("campus_id")
  campus               Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId              String    @map("class_id")
  class                Class     @relation(fields: [classId], references: [id], onDelete: NoAction)
  studentUserId        String?   @unique @map("student_user_id")
  // Removing a user account must not delete the student record it was linked
  // to — the pupil still exists, they just no longer have a login (INT-1).
  studentUser          User?     @relation("StudentUser", fields: [studentUserId], references: [id], onDelete: SetNull)
  parentUserId         String?   @map("parent_user_id")
  parent               User?     @relation("Parent", fields: [parentUserId], references: [id], onDelete: SetNull)
  guardianRelationships GuardianRelationship[]
  guardianReviewQueue   GuardianReviewQueue[]
  admissionNo          String?   @map("admission_no") // Institution-scoped identifier; id is the immutable identity
  fullName             String    @map("full_name")
  nameUr               String?   @map("name_ur")
  rollNo               String    @map("roll_no")
  gender               Gender
  dateOfBirth          DateTime? @map("date_of_birth")
  bloodType            String?   @map("blood_type")
  nationality          String?   @default("Pakistan")
  phone                String?
  guardianName         String?   @map("guardian_name")
  guardianNameUr       String?   @map("guardian_name_ur")
  guardianPhone        String?   @map("guardian_phone")
  guardianWhatsapp     String?   @map("guardian_whatsapp")
  guardianEmail        String?   @map("guardian_email")
  guardianRelationship String?   @map("guardian_relationship")
  guardianOccupation   String?   @map("guardian_occupation")
  profileImageUrl      String?   @map("profile_image_url") @db.Text
  address              String?   @db.Text
  city                 String?
  province             String?
  postalCode           String?   @map("postal_code")
  medicalNotes         String?   @map("medical_notes") @db.Text
  specialNeeds         String?   @map("special_needs") @db.Text
  allergies            String?   @db.Text
  medications          String?   @db.Text
  previousSchool       String?   @map("previous_school")
  enrollmentDate       DateTime  @default(now()) @map("enrollment_date")
  status               String    @default("active")
  siblingGroupId       String?   @map("sibling_group_id") // shared UUID linking siblings

  // Records
  marks                  Mark[]
  attendance             Attendance[]
  reportCards            ReportCard[]
  examSeats              ExamSeat[]
  invoices               Invoice[]
  payments               Payment[]
  paymentPlans           PaymentPlan[]
  parentCommunications   ParentCommunication[]
  classHistory           StudentClassHistory[]
  categoryId             String?                 @map("category_id")
  category               StudentCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  groupId                String?                 @map("group_id")
  group                  StudentGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  feeDiscountAssignments FeeDiscountAssignment[]
  feeCarryForwards       FeeCarryForward[]
  documents              StudentDocument[]
  timelineEvents         StudentTimelineEvent[]
  conversionOf           AdmissionQuery?         @relation("QueryConversion")
  transportRouteId       String?                 @map("transport_route_id")
  transportRoute         TransportRoute?         @relation("StudentTransportRoute", fields: [transportRouteId], references: [id], onDelete: SetNull)
  dormRoomId             String?                 @map("dorm_room_id")
  dormRoom               DormRoom?               @relation("StudentDormRoom", fields: [dormRoomId], references: [id], onDelete: SetNull)
  dormAllocations        DormAllocation[]

  @@index([schoolId, admissionNo])
  @@index([campusId, rollNo])
  @@index([schoolId])
  @@map("students")
}

// A guardian link is scoped to one child and one school. Account identity is
// attached only after the guardian accepts from their authenticated account;
// matching a name, email, phone, or sibling group never grants access.
model GuardianRelationship {
  id                  String   @id @default(uuid())
  schoolId            String   @default("") @map("school_id")
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId            String   @map("campus_id")
  campus              Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  studentId           String   @map("student_id")
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianUserId      String?  @map("guardian_user_id")
  guardian             User?    @relation("GuardianAccount", fields: [guardianUserId], references: [id], onDelete: SetNull)
  createdByUserId     String   @map("created_by_user_id")
  createdBy           User     @relation("GuardianCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  fullName            String   @map("full_name")
  email               String
  phone               String?
  relationship        String
  status              String   @default("INVITED") // INVITED | ACTIVE | SUSPENDED | REVOKED | REVIEW_REQUIRED
  validFrom           DateTime @default(now()) @map("valid_from")
  validUntil          DateTime? @map("valid_until")
  verifiedAt          DateTime? @map("verified_at")
  invitationExpiresAt DateTime? @map("invitation_expires_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  accessVersions      GuardianAccessVersion[]
  accessEvents        GuardianAccessEvent[]

  @@unique([id, schoolId])
  @@index([schoolId, campusId, studentId, status], map: "guardian_relationships_school_id_campus_id_student_id_status_id")
  @@index([schoolId, guardianUserId, status])
  @@map("guardian_relationships")
}

// Versioned rights keep scheduled changes from altering current access.
// Each request resolves the version effective at that request's current time.
model GuardianAccessVersion {
  id              String   @id @default(uuid())
  schoolId        String   @default("") @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  relationshipId  String   @map("relationship_id")
  relationship    GuardianRelationship @relation(fields: [relationshipId, schoolId], references: [id, schoolId], onDelete: Cascade)
  permissions     Json
  effectiveFrom   DateTime @default(now()) @map("effective_from")
  effectiveUntil  DateTime? @map("effective_until")
  reason          String
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([schoolId, relationshipId, effectiveFrom, effectiveUntil], map: "guardian_access_versions_school_id_relationship_id_effective_fr")
  @@map("guardian_access_versions")
}

model GuardianAccessEvent {
  id              String   @id @default(uuid())
  schoolId        String   @default("") @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  relationshipId  String   @map("relationship_id")
  relationship    GuardianRelationship @relation(fields: [relationshipId, schoolId], references: [id, schoolId], onDelete: Cascade)
  actorUserId     String   @map("actor_user_id")
  actor           User     @relation("GuardianAccessActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action          String
  reason          String
  beforeState     Json?    @map("before_state")
  afterState      Json?    @map("after_state")
  effectiveAt     DateTime @map("effective_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([schoolId, relationshipId, createdAt])
  @@map("guardian_access_events")
}

// Contact-only legacy records are not proof of a family relationship. Preserve
// them here for staff review without granting a guardian account access.
model GuardianReviewQueue {
  id                  String   @id @default(uuid())
  schoolId            String   @default("") @map("school_id")
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId            String   @map("campus_id")
  campus              Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  studentId           String   @map("student_id")
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contactName         String?  @map("contact_name")
  email               String?
  phone               String?
  legacyRelationship  String?  @map("legacy_relationship")
  reason              String
  status              String   @default("OPEN")
  reviewedByUserId    String?  @map("reviewed_by_user_id")
  reviewedBy          User?    @relation("GuardianReviewActor", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime? @map("reviewed_at")
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([studentId, reason])
  @@index([schoolId, campusId, status, createdAt])
  @@map("guardian_review_queue")
}

// Admission documents (birth certificate, transfer certificate, photo…)
// stored in S3; only the key + friendly name live in the DB.
model StudentDocument {
  id         String   @id @default(uuid())
  schoolId   String   @default("") @map("school_id")
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String   @map("student_id")
  kind       String // BIRTH_CERTIFICATE | TRANSFER_CERTIFICATE | PHOTO | OTHER
  fileKey    String   @map("file_key")
  fileName   String   @map("file_name")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([schoolId])
  @@map("student_documents")
}

// Admissions / life-cycle timeline for a student.
model StudentTimelineEvent {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String   @map("student_id")
  kind      String // ADMITTED | PROMOTED | FEE_PAID | DOC_UPLOADED | NOTE
  title     String
  detail    String?
  actorId   String?  @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([schoolId])
  @@map("student_timeline_events")
}

// Lead CRM: incoming admission enquiries. Converted leads link to the student
// they became; `convertedStudentId` is unique so a lead can only convert once.
model AdmissionQuery {
  id                 String    @id @default(uuid())
  schoolId           String    @default("") @map("school_id")
  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId           String    @map("campus_id")
  name               String
  phone              String
  email              String?
  classInterestedId  String?   @map("class_interested_id")
  source             String // WALK_IN | PHONE | WEBSITE | REFERRAL | ADVERT
  status             String    @default("ACTIVE") // ACTIVE | FOLLOW_UP | CONVERTED | LOST
  assignedToId       String?   @map("assigned_to_id")
  nextFollowUp       DateTime? @map("next_follow_up")
  note               String?   @db.Text
  convertedStudentId String?   @unique @map("converted_student_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  campus           Campus                   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classInterested  Class?                   @relation("QueryClass", fields: [classInterestedId], references: [id], onDelete: SetNull)
  assignedTo       User?                    @relation("QueryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedStudent Student?                 @relation("QueryConversion", fields: [convertedStudentId], references: [id], onDelete: SetNull)
  followUps        AdmissionQueryFollowUp[]
  applications     AdmissionApplication[]

  @@index([campusId, status])
  @@index([schoolId])
  @@map("admission_queries")
}

/// SKO-398: a campus admission form. The draft is edited freely; families only ever see a published,
/// immutable version, and a draft application stays on the version it was started with.
model AdmissionForm {
  id             String                 @id @default(uuid())
  schoolId       String                 @default("") @map("school_id")
  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String                 @map("campus_id")
  name           String
  // { fields: FieldDef[], documents: DocumentDef[], identityKeys: string[] } — validated on save.
  draft          Json
  currentVersion Int                    @default(0) @map("current_version")
  publicToken    String                 @unique @map("public_token")
  isOpen         Boolean                @default(true) @map("is_open")
  createdAt      DateTime               @default(now()) @map("created_at")
  versions       AdmissionFormVersion[]

  @@index([campusId])
  @@index([schoolId])
  @@map("admission_forms")
}

model AdmissionFormVersion {
  id           String                 @id @default(uuid())
  schoolId     String                 @default("") @map("school_id")
  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String                 @map("campus_id")
  formId       String                 @map("form_id")
  form         AdmissionForm          @relation(fields: [formId], references: [id], onDelete: Restrict)
  version      Int
  definition   Json
  publishedById String                @map("published_by_id")
  publishedAt  DateTime               @default(now()) @map("published_at")
  applications AdmissionApplication[]
  submissions  AdmissionSubmission[]

  @@unique([formId, version])
  @@index([schoolId])
  @@map("admission_form_versions")
}

/// One child's application from first draft to enrollment. Stage changes, offers, acceptance and the
/// conversion into a pupil are separate events; the pupil is created at most once.
model AdmissionApplication {
  id                 String                      @id @default(uuid())
  schoolId           String                      @default("") @map("school_id")
  school             School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId           String                      @map("campus_id")
  formVersionId      String                      @map("form_version_id")
  formVersion        AdmissionFormVersion        @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  reference          String
  // DRAFT | SUBMITTED | UNDER_REVIEW | INFO_REQUESTED | OFFERED | WAITLISTED | ACCEPTED | DECLINED | REJECTED | WITHDRAWN | ENROLLED
  status             String                      @default("DRAFT")
  channel            String                      @default("FAMILY") // FAMILY | STAFF
  answers            Json
  childName          String                      @default("") @map("child_name")
  dateOfBirth        DateTime?                   @map("date_of_birth") @db.Date
  guardianPhone      String?                     @map("guardian_phone")
  // Normalised stable identifiers configured on the form, for duplicate review.
  identityKeys       String[]                    @map("identity_keys")
  resumeKeyHash      String?                     @map("resume_key_hash")
  enquiryId          String?                     @map("enquiry_id")
  enquiry            AdmissionQuery?             @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  ownerId            String?                     @map("owner_id")
  owner              User?                       @relation("ApplicationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  nextContactAt      DateTime?                   @map("next_contact_at")
  intakeClassId      String?                     @map("intake_class_id")
  submittedAt        DateTime?                   @map("submitted_at")
  consentAt          DateTime?                   @map("consent_at")
  consentText        String?                     @map("consent_text") @db.Text
  convertedStudentId String?                     @unique @map("converted_student_id")
  convertedStudent   Student?                    @relation("ApplicationConversion", fields: [convertedStudentId], references: [id], onDelete: Restrict)
  convertedAt        DateTime?                   @map("converted_at")
  convertedById      String?                     @map("converted_by_id")
  duplicateDecision  Json?                       @map("duplicate_decision")
  version            Int                         @default(1)
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  submissions        AdmissionSubmission[]
  events             AdmissionApplicationEvent[]
  documents          AdmissionDocument[]

  @@unique([schoolId, reference])
  @@index([campusId, status])
  @@index([schoolId])
  @@map("admission_applications")
}

/// Each submission (first, and after an information request) exactly as sent, with its form version.
model AdmissionSubmission {
  id            String               @id @default(uuid())
  schoolId      String               @default("") @map("school_id")
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicationId String               @map("application_id")
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  formVersionId String               @map("form_version_id")
  formVersion   AdmissionFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  answers       Json
  documentIds   String[]             @map("document_ids")
  submittedAt   DateTime             @default(now()) @map("submitted_at")
  submittedBy   String               @map("submitted_by") // FAMILY | staff user id

  @@index([applicationId, submittedAt])
  @@index([schoolId])
  @@map("admission_submissions")
}

model AdmissionApplicationEvent {
  id            String               @id @default(uuid())
  schoolId      String               @default("") @map("school_id")
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicationId String               @map("application_id")
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String // CREATED | SUBMITTED | ASSIGNED | STAGE | INFO_REQUESTED | NOTE | ACCEPTED | DUPLICATE_DECISION | ENROLLED | WITHDRAWN
  fromStatus    String?              @map("from_status")
  toStatus      String?              @map("to_status")
  // Office notes stay with staff; familyMessage is what the family is shown.
  officeNote    String?              @map("office_note") @db.Text
  familyMessage String?              @map("family_message") @db.Text
  detail        Json?
  actorId       String               @map("actor_id") // a staff user id, or FAMILY
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@index([schoolId])
  @@map("admission_application_events")
}

/// A file a family or staff member attached to an application. Small (≤5 MB) and kept with the application.
model AdmissionDocument {
  id            String               @id @default(uuid())
  schoolId      String               @default("") @map("school_id")
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicationId String               @map("application_id")
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  key           String
  fileName      String               @map("file_name")
  contentType   String               @map("content_type")
  sizeBytes     Int                  @map("size_bytes")
  sha256        String
  data          Bytes
  uploadedBy    String               @map("uploaded_by")
  uploadedAt    DateTime             @default(now()) @map("uploaded_at")

  @@index([applicationId, key])
  @@index([schoolId])
  @@map("admission_documents")
}

model AdmissionQueryFollowUp {
  id       String    @id @default(uuid())
  schoolId String    @default("") @map("school_id")
  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  queryId  String    @map("query_id")
  date     DateTime
  note     String    @db.Text
  nextDate DateTime? @map("next_date")
  actorId  String?   @map("actor_id")

  query AdmissionQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  actor User?          @relation("QueryFollowUpActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([queryId])
  @@index([schoolId])
  @@map("admission_query_follow_ups")
}

// Student tags used by fee discounts (Module 2), reports, and segmentation:
// categories = fee/scholarship eligibility classes (General, Scholarship,
// Orphan, Staff Child…), groups = logistics/cohort tags (Transport users,
// Hostel residents, House A…). Both optional per student and campus-scoped.
model StudentCategory {
  id           String        @id @default(uuid())
  schoolId     String        @default("") @map("school_id")
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String        @map("campus_id")
  campus       Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  isActive     Boolean       @default(true) @map("is_active")
  students     Student[]
  feeDiscounts FeeDiscount[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("student_categories")
}

model StudentGroup {
  id          String    @id @default(uuid())
  schoolId    String    @default("") @map("school_id")
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String    @map("campus_id")
  campus      Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name        String
  description String?
  students    Student[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("student_groups")
}

// ─── 6. SUBJECTS ──────────────────────────────────────────
model Subject {
  id         String  @id @default(uuid())
  schoolId   String  @default("") @map("school_id")
  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String  @map("campus_id")
  campus     Campus  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId    String  @map("class_id")
  class      Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  name       String
  teacherId  String? @map("teacher_id")
  teacher    User?   @relation("Teacher", fields: [teacherId], references: [id])
  totalMarks Int     @default(100) @map("total_marks")

  // Relations
  marks          Mark[]
  exams          Exam[]
  timetableSlots TimetableSlot[]
  examSchedules  ExamSchedule[]
  syllabusTopics SyllabusTopic[]

  @@index([schoolId])
  @@map("subjects")
}

model SyllabusTopic {
  id          String    @id @default(cuid()) @map("id")
  schoolId    String    @default("") @map("school_id")
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId   String    @map("subject_id")
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int       @default(0)
  status      String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([subjectId, order])
  @@index([schoolId])
  @@map("syllabus_topics")
}

// ─── 7. EXAMS ─────────────────────────────────────────────

/// One school-wide exam announcement — "Mid-Term Exams, Term 1, 2026".
///
/// Scheduling per class was never wrong, it was just the wrong *starting
/// point*: the office decides once that mid-terms are happening and which
/// classes sit them, and only then does each class need its own dates, rooms
/// and marks. Creating twenty near-identical exams by hand was that decision
/// typed out twenty times, and every typo produced a class that quietly fell
/// out of the date sheet.
///
/// A session owns the per-class `Exam` rows it created. Deleting it releases
/// them (SetNull) rather than destroying a term's marks.
model ExamSession {
  id           String    @id @default(uuid())
  schoolId     String    @default("") @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String    @map("campus_id")
  campus       Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  title        String
  term         String
  academicYear Int       @map("academic_year")
  examType     String    @map("exam_type") // MID_TERM | FINAL
  /// The window the office expects papers to fall in. Advisory — the date
  /// sheet is the truth — but it seeds the planner's calendar and catches a
  /// paper dropped in the wrong month.
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  status       String    @default("PLANNING") // PLANNING | SCHEDULED | SEATED | RUNNING | COMPLETED
  notes        String?   @db.Text
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  /// SKO-500: one submission deadline for every paper of the session (per-slot override on the slot).
  paperDueOn   DateTime? @map("paper_due_on") @db.Date
  /// SKO-500: the office's paper pattern (filled from Slice 2).
  paperPolicy  Json?     @map("paper_policy")
  /// SKO-504: family result notes may go out on result release instead of waiting for the report card.
  familyNotesOnRelease Boolean @default(false) @map("family_notes_on_release")
  paperSlots   ExamPaperSlot[]
  exams Exam[]

  @@index([campusId, academicYear])
  @@index([schoolId])
  @@map("exam_sessions")
}

model Exam {
  id              String       @id @default(uuid())
  schoolId        String       @default("") @map("school_id")
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String       @map("campus_id")
  campus          Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId         String       @map("class_id")
  class           Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  title           String
  term            String
  academicYear    Int          @map("academic_year")
  examType        String       @default("CLASS_TEST") @map("exam_type") // QUIZ, CLASS_TEST, MID_TERM, FINAL, CUSTOM
  // A school announces "Mid-Term Exams 2026" once, for every class at once —
  // but each class still sits its own papers, on its own dates, marked by its
  // own teachers. So the announcement is the session and the per-class row
  // stays exactly what it always was. Null = a one-off exam (a teacher's class
  // test), which is the only kind that was ever created before sessions.
  sessionId       String?      @map("session_id")
  session         ExamSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  subjectId       String?      @map("subject_id") // if set, exam covers only this subject; null = all class subjects
  subject         Subject?     @relation(fields: [subjectId], references: [id])
  academicModelVersionId String? @map("academic_model_version_id")
  academicModelVersion AcademicModelVersion? @relation(fields: [academicModelVersionId], references: [id], onDelete: SetNull)
  totalMarks      Int          @default(0) @map("total_marks") // computed sum of subject totalMarks
  status          String       @default("DRAFT") // DRAFT, ACTIVE, MARKS_ENTRY, LOCKED, PRINCIPAL_REVIEWED, PUBLISHED
  isLocked        Boolean      @default(false) @map("is_locked")
  lockedBy        String?      @map("locked_by")
  locker          User?        @relation("LockedBy", fields: [lockedBy], references: [id])
  lockedAt        DateTime?    @map("locked_at")
  activatedAt     DateTime?    @map("activated_at")
  marksEntryAt    DateTime?    @map("marks_entry_at")
  reviewedBy      String?      @map("reviewed_by")
  reviewedAt      DateTime?    @map("reviewed_at")
  publishedAt     DateTime?    @map("published_at")
  // Marks sent back to the teacher for correction. Kept on the exam (rather
  // than only in the audit log) so the teacher sees why on the marks screen,
  // and so a resubmitted exam can be told apart from one never reviewed.
  rejectionReason String?      @map("rejection_reason") @db.Text
  rejectedBy      String?      @map("rejected_by")
  rejectedAt      DateTime?    @map("rejected_at")
  rejectionCount  Int          @default(0) @map("rejection_count")

  // Relations
  marks       Mark[]
  reportCards ReportCard[]
  schedules   ExamSchedule[]

  @@index([schoolId])
  @@map("exams")
}

// ─── 12b. EXAM ROUTINE / DATE SHEET ───────────────────────
model ExamSchedule {
  id                 String            @id @default(uuid())
  schoolId           String            @default("") @map("school_id")
  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId           String            @map("campus_id")
  campus             Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  examId             String            @map("exam_id")
  exam               Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId          String            @map("subject_id")
  // Was declared SetNull on a required column, which Prisma cannot honour.
  // Removing a subject should take its paper off the date sheet with it.
  subject            Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date               DateTime          @db.Date
  periodDefinitionId String?           @map("period_definition_id")
  periodDefinition   PeriodDefinition? @relation(fields: [periodDefinitionId], references: [id], onDelete: SetNull)
  roomId             String?           @map("room_id")
  room               ClassRoom?        @relation(fields: [roomId], references: [id], onDelete: SetNull)

  // §58 multi-room. `roomId` above stays as the primary room so every existing
  // reader (date sheet, report cards, the admin table) keeps working unchanged;
  // `rooms` is the authoritative set and always contains the primary as well.
  /// SKO-500: the grade-level paper this date-sheet row sits (one slot covers every section of the grade).
  paperSlotId String?        @map("paper_slot_id")
  paperSlot   ExamPaperSlot? @relation(fields: [paperSlotId], references: [id], onDelete: SetNull)
  rooms ExamRoom[]
  seats ExamSeat[]

  @@unique([examId, subjectId])
  @@index([paperSlotId])
  @@index([campusId, date])
  @@index([schoolId])
  @@map("exam_schedules")
}

// ─── 12c. WEEKENDS & HOLIDAYS ─────────────────────────────
model Weekend {
  id        String @id @default(uuid())
  schoolId  String @default("") @map("school_id")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String @map("campus_id")
  campus    Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  dayOfWeek Int    @map("day_of_week") // 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat, 7=Sun

  @@unique([campusId, dayOfWeek])
  @@index([schoolId])
  @@map("campus_weekends")
}

model Holiday {
  id       String   @id @default(uuid())
  schoolId String   @default("") @map("school_id")
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId String   @map("campus_id")
  campus   Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name     String
  fromDate DateTime @map("from_date") @db.Date
  toDate   DateTime @map("to_date") @db.Date

  @@index([campusId, fromDate, toDate])
  @@index([schoolId])
  @@map("holidays")
}

model GradeWeightConfig {
  id                String   @id @default(uuid())
  schoolId          String   @default("") @map("school_id")
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId          String   @map("campus_id")
  campus            Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId           String   @map("class_id")
  class             Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear      Int      @map("academic_year")
  quizWeight        Float    @default(10) @map("quiz_weight")
  classTestWeight   Float    @default(20) @map("class_test_weight")
  midTermWeight     Float    @default(30) @map("mid_term_weight")
  finalWeight       Float    @default(40) @map("final_weight")
  passingPercentage Float    @default(50) @map("passing_percentage")
  // How the weighted overall percentage is derived. Every school marks a
  // different way, so this is per class + year like the weights themselves.
  //
  // NORMALIZED (default) — the honest mid-year number. Exams are averaged
  //   within their type, then the weights of the types that actually happened
  //   are rescaled to 100. After only a mid-term, 100% shows as 100%.
  // ABSOLUTE — the legacy scale. Every exam contributes against the full 100,
  //   so exam types that have not happened yet count as zero. Use this only
  //   when a school genuinely reports cumulative year-to-date progress.
  weightMode        String   @default("NORMALIZED") @map("weight_mode")
  gradeAplus        Float    @default(90) @map("grade_aplus")
  gradeA            Float    @default(80) @map("grade_a")
  gradeB            Float    @default(70) @map("grade_b")
  gradeC            Float    @default(60) @map("grade_c")
  gradeD            Float    @default(50) @map("grade_d")
  missingMarkPolicy String   @default("COUNT_AS_ZERO") @map("missing_mark_policy")
  absentMarkPolicy  String   @default("COUNT_AS_ZERO") @map("absent_mark_policy")
  exemptMarkPolicy  String   @default("EXCLUDE") @map("exempt_mark_policy")
  roundingRule      String   @default("WHOLE") @map("rounding_rule")
  academicModelVersionId String? @map("academic_model_version_id")
  academicModelVersion AcademicModelVersion? @relation(fields: [academicModelVersionId], references: [id], onDelete: SetNull)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([classId, academicYear])
  @@index([schoolId])
  @@map("grade_weight_configs")
}

// ─── 8. MARKS ─────────────────────────────────────────────
model Mark {
  correctionVersion Int @default(0) @map("correction_version")
  id            String  @id @default(uuid())
  schoolId      String  @default("") @map("school_id")
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String  @map("campus_id")
  campus        Campus  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  examId        String  @map("exam_id")
  exam          Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String  @map("student_id")
  student       Student @relation(fields: [studentId], references: [id], onDelete: NoAction)
  subjectId     String  @map("subject_id")
  subject       Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marksObtained Int     @map("marks_obtained")
  // A pupil who missed the paper and a pupil who scored zero are different
  // facts, and collapsing them into a 0 is not recoverable: the absentee is
  // marked failed, and every average is dragged down by a paper nobody sat.
  // Absent rows keep marksObtained at 0 for the readers that only understand
  // a number, and this flag is what the grade calculations actually consult.
  isAbsent      Boolean @default(false) @map("is_absent")
  isExempt      Boolean @default(false) @map("is_exempt")
  grade         String?
  enteredBy     String? @map("entered_by")
  enterer       User?   @relation("EnteredBy", fields: [enteredBy], references: [id])

  @@unique([examId, studentId, subjectId])
  @@index([schoolId])
  @@map("marks")
}

// ─── 9. REPORT_CARDS ──────────────────────────────────────
model ReportVersion {
  id String @id @default(uuid())
  schoolId String @map("school_id")
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reportCardId String @map("report_card_id")
  reportCard ReportCard @relation(fields: [reportCardId, schoolId], references: [id, schoolId], onDelete: Cascade)
  number Int
  contentHash String @map("content_hash")
  documentIdentity String @unique @map("document_identity")
  documentBytes Bytes? @map("document_bytes")
  language String @default("en")
  snapshot Json
  blockers Json
  changedSections Json @map("changed_sections")
  approvedBy String? @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  publishedAt DateTime? @map("published_at")
  predecessorId String? @map("predecessor_id")
  correctionReason String? @map("correction_reason")
  reviewerNote String? @map("reviewer_note")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([reportCardId, number])
  @@index([schoolId])
  @@map("report_versions")
}

model ReportCard {
  enrollmentId String? @map("enrollment_id")
  enrollment StudentEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  localeSnapshot Json? @map("locale_snapshot")
  id                String    @id @default(uuid())
  schoolId          String    @default("") @map("school_id")
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId          String    @map("campus_id")
  campus            Campus    @relation("CampusReports", fields: [campusId], references: [id], onDelete: Cascade)
  studentId         String    @map("student_id")
  student           Student   @relation(fields: [studentId], references: [id], onDelete: NoAction)
  examId            String    @map("exam_id")
  exam              Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  totalMarks        Int       @default(0) @map("total_marks")
  obtainedMarks     Int       @default(0) @map("obtained_marks")
  percentage        Float     @default(0)
  grade             String?
  rank              Int?
  attendancePresent Int       @default(0) @map("attendance_present")
  attendanceTotal   Int       @default(0) @map("attendance_total")
  remarksEn         String?   @map("remarks_en") @db.Text
  remarksUr         String?   @map("remarks_ur") @db.Text
  versions          ReportVersion[]
  sourceRevision    Int @default(0) @map("source_revision")
  currentVersionId  String? @map("current_version_id")
  publishedVersionId String? @map("published_version_id")
  reportLanguage    String @default("en") @map("report_language")
  remarksAr         String? @map("remarks_ar") @db.Text
  remarksApproved   Boolean   @default(false) @map("remarks_approved")
  approvedBy        String?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at")
  pdfUrl            String?   @map("pdf_url")
  status            String    @default("GENERATED") // GENERATED, REVIEWED, PUBLISHED, SENT
  isSent            Boolean   @default(false) @map("is_sent")
  sentVia           String?   @map("sent_via")
  sentAt            DateTime? @map("sent_at")
  deliveryStatus    String    @default("NOT_SENT") @map("delivery_status")
  deliveryError     String?   @map("delivery_error") @db.Text
  generatedAt       DateTime  @default(now()) @map("generated_at")

  @@unique([id, schoolId])
  @@unique([studentId, examId])
  @@index([schoolId])
  @@map("report_cards")
}

// ─── 10. ATTENDANCE ───────────────────────────────────────
model Attendance {
  enrollmentId String? @map("enrollment_id")
  enrollment StudentEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  id        String           @id @default(uuid())
  schoolId  String           @default("") @map("school_id")
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String           @map("campus_id")
  campus    Campus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId   String?          @map("class_id")
  class     Class?           @relation(fields: [classId], references: [id])
  studentId String           @map("student_id")
  student   Student          @relation(fields: [studentId], references: [id], onDelete: NoAction)
  date      DateTime         @db.Date
  status    AttendanceStatus
  notes     String?          @db.Text
  markedBy  String?          @map("marked_by")
  marker    User?            @relation("MarkedBy", fields: [markedBy], references: [id])
  markedAt  DateTime         @default(now()) @map("marked_at")
  isLocked  Boolean          @default(false) @map("is_locked")
  lockedAt  DateTime?        @map("locked_at")
  // SKO-405: school-local HH:mm for LATE / PARTIAL, and a version for conflict-safe edits.
  arrivalTime   String?      @map("arrival_time")
  departureTime String?      @map("departure_time")
  version       Int          @default(1)

  editHistory  AttendanceEditHistory[]
  explanations AttendanceExplanation[]

  @@unique([studentId, date])
  @@index([classId, date])
  @@index([campusId, date])
  @@index([schoolId])
  @@map("attendance")
}

model AttendanceEditHistory {
  id           String     @id @default(uuid())
  schoolId     String     @default("") @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendanceId String     @map("attendance_id")
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  oldStatus    String     @map("old_status")
  newStatus    String     @map("new_status")
  editedBy     String?    @map("edited_by")
  editedAt     DateTime   @default(now()) @map("edited_at")
  // SKO-405: why a submitted register changed, and through what (REGISTER | CORRECTION | EXPLANATION).
  reason       String?    @db.Text
  source       String     @default("REGISTER")

  @@index([attendanceId])
  @@index([schoolId])
  @@map("attendance_edit_history")
}

/// SKO-405: one class's register for one school day. The roster is the pupils enrolled in the class on that
/// date (so a pupil who later moved still appears); it can be submitted only when nobody is unmarked.
model AttendanceRegister {
  id            String    @id @default(uuid())
  schoolId      String    @default("") @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String    @map("campus_id")
  classId       String    @map("class_id")
  date          DateTime  @db.Date
  status        String    @default("OPEN") // OPEN | SUBMITTED
  rosterCount   Int       @default(0) @map("roster_count")
  submittedById String?   @map("submitted_by_id")
  submittedAt   DateTime? @map("submitted_at")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([classId, date])
  @@index([campusId, date])
  @@index([schoolId])
  @@map("attendance_registers")
}

/// SKO-405: which statuses count as attended, which as absent and which leave the denominator. Published as
/// numbered versions; every summary names the version it used.
model AttendanceRuleVersion {
  id            String   @id @default(uuid())
  schoolId      String   @default("") @map("school_id")
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  version       Int
  attended      String[]
  excluded      String[]
  note          String?  @db.Text
  publishedById String   @map("published_by_id")
  publishedAt   DateTime @default(now()) @map("published_at")

  @@unique([schoolId, version])
  @@map("attendance_rule_versions")
}

/// SKO-405: a guardian's explanation of an absence or late arrival. It never changes the register itself;
/// authorized staff accept it (which records a reasoned correction), reject it or ask for clarification.
model AttendanceExplanation {
  id             String     @id @default(uuid())
  schoolId       String     @default("") @map("school_id")
  school         School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String     @map("campus_id")
  attendanceId   String     @map("attendance_id")
  attendance     Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  studentId      String     @map("student_id")
  submittedById  String     @map("submitted_by_id")
  reason         String     @db.Text
  proposedStatus String     @map("proposed_status") // EXCUSED | LATE
  arrivalTime    String?    @map("arrival_time")
  status         String     @default("PENDING") // PENDING | ACCEPTED | REJECTED | CLARIFICATION
  reviewNote     String?    @map("review_note") @db.Text
  reviewedById   String?    @map("reviewed_by_id")
  reviewedAt     DateTime?  @map("reviewed_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([campusId, status])
  @@index([attendanceId])
  @@index([schoolId])
  @@map("attendance_explanations")
}

// ─── 11. FEE_STRUCTURES ───────────────────────────────────
model FeeStructure {
  currency String @default("PKR")
  id                String    @id @default(uuid())
  schoolId          String    @default("") @map("school_id")
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId          String    @map("campus_id")
  campus            Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId           String    @map("class_id")
  class             Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  monthlyFee        Int       @map("monthly_fee")
  oneTimeFeesJson   Json?     @map("one_time_fees_json")
  installmentType   String?   @map("installment_type")
  discountRulesJson Json?     @map("discount_rules_json")
  lateFeePercentage Float?    @default(2.0) @map("late_fee_percentage")
  compoundLateFee   Boolean?  @default(true) @map("compound_late_fee")
  taxPercentage     Float?    @default(0.0) @map("tax_percentage")
  activeFrom        DateTime  @map("active_from")
  activeTo          DateTime? @map("active_to")
  createdBy         String?   @map("created_by")
  createdByUser     User?     @relation("FeeStructureCreatedBy", fields: [createdBy], references: [id])
  updatedBy         String?   @map("updated_by")
  updatedByUser     User?     @relation("FeeStructureUpdatedBy", fields: [updatedBy], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([classId, activeFrom])
  @@index([campusId, classId])
  @@index([schoolId])
  @@map("fee_structures")
}

// ─── 11b. FEE STRUCTURE LAYERS ─────────────────────────────
// Four-layer fee model: FeeType (head) → FeeGroup (package) → FeesMasterLine
// (priced row) → FeeGroupAssignment (which classes get which package), plus
// per-student FeeDiscount / FeeDiscountAssignment and session FeeCarryForward.
// Kept alongside the legacy FeeStructure (above) for one release — a one-off
// backfill converts legacy rows into this model and the old table is removed
// later once invoices reconcile. Amounts are Int paisa; no floats.

model FeeType {
  id          String           @id @default(uuid())
  schoolId    String           @default("") @map("school_id")
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String           @map("campus_id")
  campus      Campus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  masters     FeesMasterLine[]

  @@unique([campusId, code])
  @@index([schoolId])
  @@map("fee_types")
}

model FeeGroup {
  currency String @default("PKR")
  id          String               @id @default(uuid())
  schoolId    String               @default("") @map("school_id")
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String               @map("campus_id")
  campus      Campus               @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name        String
  description String?
  lines       FeesMasterLine[]
  assignments FeeGroupAssignment[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("fee_groups")
}

model FeesMasterLine {
  id         String    @id @default(uuid())
  schoolId   String    @default("") @map("school_id")
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String    @map("campus_id")
  campus     Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  feeGroupId String    @map("fee_group_id")
  feeGroup   FeeGroup  @relation(fields: [feeGroupId], references: [id], onDelete: Cascade)
  feeTypeId  String    @map("fee_type_id")
  feeType    FeeType   @relation(fields: [feeTypeId], references: [id], onDelete: Cascade)
  amount     Int // paisa
  dueDate    DateTime? @map("due_date")

  @@unique([feeGroupId, feeTypeId])
  @@index([schoolId])
  @@map("fees_master_lines")
}

model FeeGroupAssignment {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  campus       Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  feeGroupId   String   @map("fee_group_id")
  feeGroup     FeeGroup @relation(fields: [feeGroupId], references: [id], onDelete: Cascade)
  classId      String   @map("class_id") // Class row == one section
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear Int      @map("academic_year")

  @@unique([feeGroupId, classId, academicYear])
  @@index([schoolId])
  @@map("fee_group_assignments")
}

model FeeDiscount {
  currency String @default("PKR")
  id          String                  @id @default(uuid())
  schoolId    String                  @default("") @map("school_id")
  school      School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String                  @map("campus_id")
  campus      Campus                  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name        String
  code        String
  type        String // "PERCENT" | "FLAT"
  value       Int // percent (0-100) for PERCENT, paisa for FLAT
  categoryId  String?                 @map("category_id") // auto-apply to a Student Category
  category    StudentCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignments FeeDiscountAssignment[]

  @@unique([campusId, code])
  @@index([schoolId])
  @@map("fee_discounts")
}

model FeeDiscountAssignment {
  id         String      @id @default(uuid())
  schoolId   String      @default("") @map("school_id")
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  discountId String      @map("discount_id")
  discount   FeeDiscount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  studentId  String      @map("student_id")
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([discountId, studentId])
  @@index([schoolId])
  @@map("fee_discount_assignments")
}

model FeeCarryForward {
  currency String @default("PKR")
  id               String  @id @default(uuid())
  schoolId         String  @default("") @map("school_id")
  school           School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId         String  @map("campus_id")
  campus           Campus  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  studentId        String  @map("student_id")
  student          Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromAcademicYear Int     @map("from_academic_year")
  toAcademicYear   Int     @map("to_academic_year")
  balance          Int // paisa, may be negative (credit)
  note             String?

  @@unique([studentId, toAcademicYear])
  @@index([schoolId])
  @@map("fee_carry_forwards")
}

// ─── 12. INVOICES ─────────────────────────────────────────
model Invoice {
  carryForwardAmount Int @default(0) @map("carry_forward_amount")
  paymentPlans       PaymentPlan[]
  paymentAllocations PaymentAllocation[]
  enrollmentId String? @map("enrollment_id")
  enrollment StudentEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  currency String @default("PKR")
  localeSnapshot Json? @map("locale_snapshot")
  /// SKO-402: the school and campus identity as first printed on this invoice; later rebranding never changes it.
  issuerSnapshot Json? @map("issuer_snapshot")
  id              String        @id @default(uuid())
  schoolId        String        @default("") @map("school_id")
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String        @map("campus_id")
  campus          Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  studentId       String        @map("student_id")
  student         Student       @relation(fields: [studentId], references: [id], onDelete: NoAction)
  invoiceNumber   String?       @unique @map("invoice_number")
  invoiceDate     DateTime      @map("invoice_date")
  dueDate         DateTime      @map("due_date")
  monthlyFee      Int           @map("monthly_fee")
  oneTimeFees     Int           @default(0) @map("one_time_fees")
  subtotal        Int           @map("subtotal")
  discountAmount  Int           @default(0) @map("discount_amount")
  lateFeeAmount   Int           @default(0) @map("late_fee_amount")
  taxAmount       Int           @default(0) @map("tax_amount")
  totalAmount     Int           @map("total_amount")
  totalAmountPaid Int           @default(0) @map("total_amount_paid")
  balanceDue      Int           @map("balance_due")
  status          InvoiceStatus @default(PENDING)
  pdfUrlS3        String?       @map("pdf_url_s3")
  sentWhatsapp    Boolean       @default(false) @map("sent_whatsapp")
  whatsappSentAt  DateTime?     @map("whatsapp_sent_at")
  sentEmail       Boolean       @default(false) @map("sent_email")
  emailSentAt     DateTime?     @map("email_sent_at")
  generatedAt     DateTime      @default(now()) @map("generated_at")

  payments            Payment[]
  onlinePaymentOrders OnlinePaymentOrder[]

  @@index([studentId, dueDate])
  @@index([status])
  @@index([campusId])
  @@index([schoolId])
  @@map("invoices")
}

// ─── 13. PAYMENTS ─────────────────────────────────────────
model Payment {
  currency String @default("PKR")
  reversalOfId String? @map("reversal_of_id")
  allocations PaymentAllocation[]
  issuedReceipt PaymentReceipt?
  reversalOf Payment? @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payment_reversal_fk")
  reversals Payment[] @relation("PaymentReversal")
  id              String       @id @default(uuid())
  schoolId        String       @default("") @map("school_id")
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String       @map("campus_id")
  campus          Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  invoiceId       String       @map("invoice_id")
  invoice         Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId       String       @map("student_id")
  student         Student      @relation(fields: [studentId], references: [id], onDelete: NoAction)
  amount          Int          @map("amount")
  fineAmount      Int          @default(0) @map("fine_amount")
  discountAmount  Int          @default(0) @map("discount_amount")
  paymentDate     DateTime     @map("payment_date")
  paymentMethod   String       @map("payment_method")
  referenceNumber String?      @map("reference_number")
  note            String?
  receiptNo       String?      @map("receipt_no")
  receiptUrlS3    String?      @map("receipt_url_s3")
  recordedBy      String?      @map("recorded_by")
  recorder        User?        @relation("RecordedBy", fields: [recordedBy], references: [id])
  recordedAt      DateTime     @default(now()) @map("recorded_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  ledgerEntry     LedgerEntry? @relation("PaymentLedgerEntry")

  // SKO-432/475: a manual collection replays to its original receipt under the same operation key.
  idempotencyKey  String?      @map("idempotency_key")
  requestHash     String?      @map("request_hash")
  @@unique([schoolId, recordedBy, idempotencyKey])
  @@unique([campusId, receiptNo])
  @@unique([campusId, paymentDate, referenceNumber])
  @@index([invoiceId])
  @@index([studentId])
  @@index([schoolId])
  @@map("payments")
}

// ─── 13b. ACCOUNTS LEDGER (Module 4) ──────────────────────
// Fee income auto-posts into LedgerEntry (kind INCOME) keyed by the origin
// Payment via paymentId (unique ⇒ idempotent). Manual income/expense entries
// are posted by staff. Chart of accounts enforces unique names per campus.

model ChartOfAccount {
  id       String        @id @default(uuid())
  schoolId String        @default("") @map("school_id")
  school   School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId String        @map("campus_id")
  campus   Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name     String
  type     String // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  isSystem Boolean       @default(false) @map("is_system")
  isActive Boolean       @default(true) @map("is_active")
  entries  LedgerEntry[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("chart_of_accounts")
}

model PaymentMethodRef {
  id       String  @id @default(uuid())
  schoolId String  @default("") @map("school_id")
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId String  @map("campus_id")
  campus   Campus  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name     String
  isActive Boolean @default(true) @map("is_active")

  payrollLines PayrollLine[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("payment_method_refs")
}

model BankAccount {
  currency       String        @default("PKR")
  id             String        @id @default(uuid())
  schoolId       String        @default("") @map("school_id")
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String        @map("campus_id")
  campus         Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name           String
  bankName       String?       @map("bank_name")
  accountNumber  String?       @map("account_number")
  openingBalance Int           @default(0) @map("opening_balance")
  isActive       Boolean       @default(true) @map("is_active")
  entries        LedgerEntry[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("bank_accounts")
}

model LedgerEntry {
  currency String @default("PKR")
  id            String         @id @default(uuid())
  schoolId      String         @default("") @map("school_id")
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String         @map("campus_id")
  campus        Campus         @relation(fields: [campusId], references: [id], onDelete: Cascade)
  kind          String // INCOME | EXPENSE
  sourceName    String         @map("source_name")
  accountId     String         @map("account_id")
  account       ChartOfAccount @relation(fields: [accountId], references: [id])
  paymentMethod String?        @map("payment_method")
  bankAccountId String?        @map("bank_account_id")
  bankAccount   BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  date          DateTime
  amount        Int
  note          String?
  paymentId     String?        @unique @map("payment_id")
  payment       Payment?       @relation("PaymentLedgerEntry", fields: [paymentId], references: [id], onDelete: SetNull)
  payrollLineId String?        @unique @map("payroll_line_id")
  payrollLine   PayrollLine?   @relation(fields: [payrollLineId], references: [id], onDelete: SetNull)
  createdById   String?        @map("created_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  // SKO-468: a correction never edits or deletes the original; it posts an opposite entry linked here.
  reversalOfId   String?       @unique @map("reversal_of_id")
  reversalOf     LedgerEntry?  @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     LedgerEntry?  @relation("LedgerReversal")
  idempotencyKey String?       @map("idempotency_key")
  requestHash    String?       @map("request_hash")

  @@unique([campusId, idempotencyKey])
  @@index([campusId, date])
  @@index([kind])
  @@index([accountId])
  @@index([schoolId])
  @@map("ledger_entries")
}

// ─── 11c. FINE RULES + ONLINE PAYMENT ORDERS ──────────────
// FeeFineRule defines a campus's late-fee policy (grace days + PERCENT/FLAT/
// PER_DAY). OnlinePaymentOrder tracks a SafePay session for an unpaid
// invoice; on webhook success it records the Payment idempotently.

model FeeFineRule {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String   @map("campus_id")
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name      String
  graceDays Int      @default(0) @map("grace_days")
  type      String // "PERCENT" | "FLAT" | "PER_DAY"
  value     Int // percent (0-100), paisa, or paisa-per-day
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("fee_fine_rules")
}

model OnlinePaymentOrder {
  id          String    @id @default(uuid())
  schoolId    String    @default("") @map("school_id")
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String    @map("campus_id")
  campus      Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  invoiceId   String    @map("invoice_id")
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId   String    @map("student_id")
  amount      Int // paisa
  orderRef    String    @unique @map("order_ref")
  gateway     String    @default("SAFEPAY")
  status      String    @default("PENDING") // PENDING | COMPLETED | FAILED
  paymentId   String?   @map("payment_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([invoiceId, status])
  @@index([schoolId])
  @@map("online_payment_orders")
}

// SKO-432: receipt numbers come from one atomic counter per campus and year.
model ReceiptSequence {
  campusId  String @map("campus_id")
  campus    Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  schoolId  String @default("") @map("school_id")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  year      Int
  lastValue Int    @map("last_value")
  @@id([campusId, year])
  @@index([schoolId])
  @@map("receipt_sequences")
}

// ─── 13b. PAYMENT PLANS ────────────────────────────────────
model PaymentPlan {
  id                String    @id @default(uuid())
  schoolId          String    @default("") @map("school_id")
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId          String?   @map("campus_id")
  campus            Campus?   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  studentId         String?   @map("student_id")
  student           Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  originalAmountDue Int       @map("original_amount_due")
  installmentCount  Int       @map("installment_count")
  installmentsJson  Json      @map("installments_json")
  status            String    @default("active")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  // SKO-431: an instalment agreement for one invoice, proposed by one staff member and approved by
  // another. Payments after the plan starts are allocated to its instalments in date order.
  invoiceId         String?   @map("invoice_id")
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  currency          String?
  paidAtCreation    Int       @default(0) @map("paid_at_creation")
  createdById       String?   @map("created_by_id")
  approvedById      String?   @map("approved_by_id")
  approvedAt        DateTime? @map("approved_at")
  cancelledAt       DateTime? @map("cancelled_at")
  version           Int       @default(1)

  @@index([schoolId])
  @@index([invoiceId])
  @@map("payment_plans")
}

// ─── 13c. BANK RECONCILIATION ──────────────────────────────
model BankReconciliation {
  id                        String    @id @default(uuid())
  schoolId                  String    @default("") @map("school_id")
  school                    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId                  String    @map("campus_id")
  campus                    Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  importDate                DateTime  @map("import_date")
  bankFileUrlS3             String?   @map("bank_file_url_s3")
  bankAccount               String?   @map("bank_account")
  statementPeriodFrom       DateTime? @map("statement_period_from")
  statementPeriodTo         DateTime? @map("statement_period_to")
  totalTransactions         Int       @default(0) @map("total_transactions")
  matchedCount              Int       @default(0) @map("matched_count")
  unmatchedCount            Int       @default(0) @map("unmatched_count")
  reconciliationDetailsJson Json?     @map("reconciliation_details_json")
  unmatchedJson             Json?     @map("unmatched_json")
  status                    String    @default("pending")
  reconciledBy              String?   @map("reconciled_by")
  reconciledByUser          User?     @relation("BankReconciliationReconciler", fields: [reconciledBy], references: [id])
  reconciledAt              DateTime? @map("reconciled_at")
  createdAt                 DateTime  @default(now()) @map("created_at")

  @@index([schoolId])
  @@map("bank_reconciliations")
}

// SKO-432: one row per bank transaction ever committed for a campus, so the same transaction in a
// renamed or reformatted statement can never be imported or posted twice.
model BankTransactionKey {
  id               String   @id @default(uuid())
  schoolId         String   @default("") @map("school_id")
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId         String   @map("campus_id")
  campus           Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  rowKey           String   @map("row_key")
  reconciliationId String   @map("reconciliation_id")
  rowNumber        Int      @map("row_number")
  paymentId        String?  @map("payment_id")
  createdAt        DateTime @default(now()) @map("created_at")
  @@unique([campusId, rowKey])
  @@index([schoolId])
  @@index([reconciliationId])
  @@map("bank_transaction_keys")
}

// SKO-433: a controlled financial exception. Requested by one finance user, decided by another; the
// original invoice and payment are never edited away — the effect is appended and linked here.
model FinancialAdjustment {
  id                 String    @id @default(uuid())
  schoolId           String    @default("") @map("school_id")
  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId           String    @map("campus_id")
  campus             Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  studentId          String    @map("student_id")
  invoiceId          String    @map("invoice_id")
  paymentId          String?   @map("payment_id")
  kind               String
  currency           String
  amount             Int
  invoiceAmount      Int       @default(0) @map("invoice_amount")
  creditAmount       Int       @default(0) @map("credit_amount")
  reasonCategory     String    @map("reason_category")
  reason             String
  publicExplanation  String    @map("public_explanation")
  privateNote        String?   @map("private_note")
  sourceVersion      String    @map("source_version")
  status             String    @default("REQUESTED")
  requesterId        String    @map("requester_id")
  requesterName      String    @map("requester_name")
  approverId         String?   @map("approver_id")
  approverName       String?   @map("approver_name")
  decidedAt          DateTime? @map("decided_at")
  disbursementRef    String?   @map("disbursement_ref")
  successorPaymentId String?   @map("successor_payment_id")
  executedAt         DateTime? @map("executed_at")
  idempotencyKey     String    @map("idempotency_key")
  createdAt          DateTime  @default(now()) @map("created_at")
  @@unique([schoolId, requesterId, idempotencyKey])
  @@index([schoolId, campusId, status])
  @@index([invoiceId])
  @@index([paymentId])
  @@map("financial_adjustments")
}

// Durable preview, commit receipt, and guarded reversal record for CSV imports.
// Staged source data is cleared at commit or expiry; the row receipt remains.
model ImportBatch {
  id          String    @id @default(uuid())
  schoolId    String    @default("") @map("school_id")
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String    @map("campus_id")
  campus      Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  kind        String    // STUDENT_ROSTER | BANK_STATEMENT
  fingerprint String
  targetScope String    @map("target_scope")
  sourceName  String    @map("source_name")
  state       String    @default("STAGED") // STAGED | COMMITTED | PARTIAL | REVERSED | EXPIRED
  data        Json
  receipt     Json?
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  committedAt DateTime? @map("committed_at")
  reversedAt  DateTime? @map("reversed_at")

  @@unique([schoolId, campusId, kind, fingerprint, targetScope])
  @@index([schoolId, campusId, createdAt])
  @@index([schoolId, expiresAt])
  @@map("import_batches")
}

// ─── 14. AI USAGE LOGS ────────────────────────────────────
model AIUsageLog {
  id             String   @id @default(uuid())
