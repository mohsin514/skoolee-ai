model InterventionPlan {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  studentId       String?   @map("student_id")
  createdBy       String    @map("created_by")
  title           String
  summary         String    @db.Text
  recommendations Json?
  status          String    @default("DRAFT") // DRAFT, ACTIVE, CLOSED, ESCALATED, REJECTED
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  // SKO-425: the learning action. AI text stays a draft; a reviewer activates
  // only a plan with evidence, goal, owner and dates. Private notes never
  // leave staff; the family sees only the shared projection.
  version         Int       @default(1)
  origin          String    @default("TEACHER") // TEACHER, AI
  classId         String?   @map("class_id")
  subjectId       String?   @map("subject_id")
  concern         String?   @db.Text
  evidenceState   String    @default("NEEDS_OBSERVATION") @map("evidence_state") // CONFIRMED, NEEDS_OBSERVATION
  evidenceRefs    Json      @default("[]") @map("evidence_refs")
  baseline        Json?
  goal            String?   @db.Text
  ownerId         String?   @map("owner_id")
  plannedActivity String?   @map("planned_activity") @db.Text
  minutesPerWeek  Int?      @map("minutes_per_week")
  lessonPlanRef   Json?     @map("lesson_plan_ref")
  reviewDate      DateTime? @map("review_date") @db.Date
  nextCheckInDate DateTime? @map("next_check_in_date") @db.Date
  familyShare     Json?     @map("family_share")
  privateNotes    String?   @map("private_notes") @db.Text
  outcome         Json?
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  // SKO-472: an approved assessment repair changed the evidence this action cites; it needs review.
  staleRepairId   String?   @map("stale_repair_id")
  staleReason     String?   @map("stale_reason") @db.Text
  staleSince      DateTime? @map("stale_since")

  @@index([schoolId, campusId, status])
  @@index([studentId])
  @@index([ownerId, status])
  @@map("intervention_plans")
}

