  @@index([campusId, status])
  @@index([schoolId])
  @@map("academic_cycles")
}

// Versioned curriculum, terms and grading rules for one cohort and year.
// Shared templates have no campusId and are copied into campus drafts before
// local subject IDs or delegated exceptions are applied.
model AcademicModelVersion {
  id                    String    @id @default(uuid())
  schoolId              String    @default("") @map("school_id")
  school                School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId              String?   @map("campus_id")
  campus                Campus?   @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear          Int       @map("academic_year")
  cohortKey             String    @map("cohort_key")
  cohortLabel           String    @map("cohort_label")
  title                 String
  version               Int
  status                String    @default("DRAFT") // DRAFT | ACTIVE | SUPERSEDED | TEMPLATE
  effectiveFrom         DateTime  @map("effective_from") @db.Date
  effectiveTo           DateTime? @map("effective_to") @db.Date
  configuration         Json
  templateSourceId      String?   @map("template_source_id")
  inheritedConfiguration Json?    @map("inherited_configuration")
  delegatedOverrideKeys String[]  @default([]) @map("delegated_override_keys")
  localOverrideKeys     String[]  @default([]) @map("local_override_keys")
  isSharedTemplate      Boolean   @default(false) @map("is_shared_template")
  templateApprovedAt    DateTime? @map("template_approved_at")
  templateApprovedBy    String?   @map("template_approved_by")
  approvedAt            DateTime? @map("approved_at")
  approvedBy            String?   @map("approved_by")
  createdBy             String    @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  gradeWeightConfigs GradeWeightConfig[]
  exams               Exam[]

  @@unique([campusId, academicYear, cohortKey, version])
  @@index([schoolId, campusId, academicYear, status])
  @@index([templateSourceId])
  @@map("academic_model_versions")
}

// ─── IN-APP NOTIFICATIONS ────────────────────────────────
model Notification {
  id        String    @id @default(uuid())
  schoolId  String    @default("") @map("school_id")
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String?   @map("campus_id")
  userId    String    @map("user_id")
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String    @db.Text
  icon      String?
  link      String?
  metadata  Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  actorId   String?   @map("actor_id")
  actorName String?   @map("actor_name")
  createdAt DateTime  @default(now()) @map("created_at")
  // SKO-416: UPDATE (information), MENTION (addressed to you) or ACTION (work you must do in the source
  // workflow). Read state is attention only; an ACTION is resolved by its source record, never by reading.
  category       String    @default("UPDATE")
  sourceType     String?   @map("source_type")
  sourceId       String?   @map("source_id")
  /// One row per user and source: repeated reminders bump reminderCount instead of adding rows.
  dedupeKey      String?   @map("dedupe_key")
  dueAt          DateTime? @map("due_at")
  resolvedAt     DateTime? @map("resolved_at")
  resolution     String? // COMPLETED | CANCELLED | REASSIGNED
  reminderCount  Int       @default(0) @map("reminder_count")
  lastRemindedAt DateTime? @map("last_reminded_at")

  @@unique([userId, dedupeKey])
  @@index([userId, category, resolvedAt])
  @@index([sourceType, sourceId])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([schoolId])
  @@map("notifications")
}

