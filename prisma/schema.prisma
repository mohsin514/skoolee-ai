// ─── AI EXAM STUDIO: form sets, sealed releases and exposure ──
// A Form_Set groups the parallel forms (A..D) generated from one blueprint so
// allocation and exposure can reason about the whole sitting rather than a
// single paper. `SchoolAiExamFormAllocation` arrives with the Exam Room
// migration and adds the matching back-relation then.
model SchoolAiExamFormSet {
  id            String   @id @default(uuid())
  schoolId      String   @default("") @map("school_id")
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String   @map("campus_id")
  campus        Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  /// SKO-408: optional; a form set made from a paper has no brief until one is linked.
  briefRecordId String?  @map("brief_record_id")
  blueprintHash String   @map("blueprint_hash")
  maxForms      Int      @default(4) @map("max_forms")
  status        String   @default("DRAFT")
  version       Int      @default(1)
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  releases      SchoolAiExamFormRelease[]
  allocations   SchoolAiExamFormAllocation[]

  @@unique([id, schoolId, campusId])
  @@index([schoolId, campusId, status, updatedAt], map: "school_ai_exam_form_sets_scope_status_updated_at_idx")
  @@map("school_ai_exam_form_sets")
}

// A Released_Form is sealed: the row records the content hash an independent
// verifier recomputes, so the form set is restricted from deletion while any
// release still cites it.
model SchoolAiExamFormRelease {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  campus       Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  formSetId    String   @map("form_set_id")
  formSet      SchoolAiExamFormSet @relation(fields: [formSetId, schoolId, campusId], references: [id, schoolId, campusId], onDelete: Restrict, map: "school_ai_exam_form_releases_form_set_scope_fkey")
  paperId      String   @map("paper_id")
  paperVersion Int      @map("paper_version")
  formLabel    String   @map("form_label")
  language     String
  contentHash  String   @map("content_hash")
  hashScheme   Int      @default(1) @map("hash_scheme")
  rehearsalId  String   @map("rehearsal_id")
  releasedById String   @map("released_by_id")
  releasedAt   DateTime @default(now()) @map("released_at")

  @@unique([formSetId, formLabel, language], map: "school_ai_exam_form_releases_form_set_label_language_key")
  @@unique([paperId, paperVersion, language], map: "school_ai_exam_form_releases_paper_version_language_key")
  @@index([schoolId, campusId, contentHash], map: "school_ai_exam_form_releases_scope_content_hash_idx")
  @@map("school_ai_exam_form_releases")
}

/// SKO-408 R10.8-R10.10: exactly one form per candidate in a form set, recorded before the attempt starts.
model SchoolAiExamFormAllocation {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
