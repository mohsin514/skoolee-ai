  observedAt DateTime @map("observed_at")
  receivedAt DateTime @default(now()) @map("received_at")
  retentionUntil DateTime @map("retention_until")
  details Json @default("{}")
  version Int @default(1)
  decision String @default("PENDING")
  reviewReason String? @map("review_reason")
  reviewedById String? @map("reviewed_by_id")
  reviewedAt DateTime? @map("reviewed_at")

  @@unique([attemptId, clientEventId])
  @@index([schoolId, campusId, assignmentId, receivedAt], map: "school_ai_integrity_scope_received_idx")
  @@index([schoolId, retentionUntil], map: "school_ai_integrity_retention_idx")
  @@map("school_ai_exam_integrity_events")
