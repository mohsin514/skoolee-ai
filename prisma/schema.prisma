model SchoolAiExamAssignment {
  integrityEvents SchoolAiExamIntegrityEvent[]
  proctorPolicy Json @default("{}") @map("proctor_policy")
  proctorSessions SchoolAiProctorSession[]
  id           String @id @default(uuid())
  schoolId     String @default("") @map("school_id")
  school       School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String @map("campus_id")
  campus       Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId      String @map("class_id")
  paperId      String @map("paper_id")
  paper        SchoolAiRecord @relation(fields: [paperId, schoolId], references: [id, schoolId], onDelete: Restrict)
  paperVersion Int @map("paper_version")
  paperSnapshot Json @map("paper_snapshot")
  // Form_Set grouping. Null for a single-form exam; no foreign key, because an
  // assignment may outlive the form set that produced it.
  formSetId    String? @map("form_set_id")
  formLabel    String @default("A") @map("form_label")
  createdById  String @map("created_by_id")
  title        String
  startsAt     DateTime @map("starts_at")
  endsAt       DateTime @map("ends_at")
  studentIds   Json @map("student_ids")
  accommodations Json @default("{}")
  gradebookPublication Json? @map("gradebook_publication")
  /// SKO-449: a SECURE_BROWSER exam pins the approved Safe Exam Browser profile version it was assigned with.
  /// SKO-408: the sealed release — key-free content hash of the delivered paper, the rehearsal it relied on
  /// (null only for legacy papers that never entered the item workbench) and the explicit result release.
  contentHash          String?   @map("content_hash")
  rehearsalId          String?   @map("rehearsal_id")
  resultsReleasedAt    DateTime? @map("results_released_at")
  resultsReleasedById  String?   @map("results_released_by_id")
  secureProfileId      String? @map("secure_profile_id")
  secureProfileVersion Int?    @map("secure_profile_version")
  /// SKO-500: the date-sheet row and paper slot this sitting delivers (null for a classroom sitting).
  examScheduleId String? @map("exam_schedule_id")
  paperSlotId    String? @map("paper_slot_id")
  status       String @default("DRAFT")
  mode         String @default("STANDARD")
  version      Int @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  attempts     SchoolAiExamAttempt[]

  @@unique([id, schoolId, campusId])
  @@index([schoolId, campusId, classId, startsAt])
  @@index([schoolId, campusId, paperSlotId])
  @@index([schoolId, createdById, status])
  @@map("school_ai_exam_assignments")
}

model SchoolAiExamAttempt {
  integrityEvents SchoolAiExamIntegrityEvent[]
  proctorSessions SchoolAiProctorSession[]
  reviewVersion Int @default(0) @map("review_version")
  resultRevisions SchoolAiExamResultRevision[]
  appeals SchoolAiExamAppeal[]
  id           String @id @default(uuid())
  schoolId     String @default("") @map("school_id")
  school       School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String @map("campus_id")
  campus       Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  assignmentId String @map("assignment_id")
  assignment   SchoolAiExamAssignment @relation(fields: [assignmentId, schoolId, campusId], references: [id, schoolId, campusId], onDelete: Cascade)
  studentId    String @map("student_id")
  userId       String @map("user_id")
  startedAt    DateTime @default(now()) @map("started_at")
  deadlineAt   DateTime @map("deadline_at")
  sequence     Int @default(0)
  responses    Json
  status       String @default("IN_PROGRESS")
  submittedAt  DateTime? @map("submitted_at")
  scoreProposal Json? @map("score_proposal")
  /// SKO-410: the effective timing and access settings bound at start; later plan changes never alter it.
  accommodationSnapshot Json? @map("accommodation_snapshot")
  /// SKO-408 R15.4: set while an invigilator holds a supervised pause; the timer resumes with the paused time restored.
  pausedAt     DateTime? @map("paused_at")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String? @map("reviewed_by_id")
  review       Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([assignmentId, userId])
  @@unique([id, schoolId, campusId])
  @@index([schoolId, campusId, studentId, status])
  @@map("school_ai_exam_attempts")
}


