model ItemTransaction {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String    @map("campus_id")
  campus         Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  itemId         String    @map("item_id")
  item           Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storeId        String    @map("store_id")
  store          ItemStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind           String // RECEIVE | SELL | ISSUE | RETURN
  quantity       Int
  unitPrice      Int?      @map("unit_price")
  supplierId     String?   @map("supplier_id")
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  issuedToUserId String?   @map("issued_to_user_id")
  date           DateTime  @default(now())
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([schoolId])
  @@map("item_transactions")
}

// ─── Module 15: Front-Desk Logs ──────────────────────────

model VisitorLog {
  id        String    @id @default(uuid())
  schoolId  String    @default("") @map("school_id")
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String    @map("campus_id")
  campus    Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  purpose   String?
  toMeet    String?   @map("to_meet")
  inTime    DateTime  @map("in_time")
  outTime   DateTime? @map("out_time")
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  // SKO-466: ON_SITE until checked out (LEFT); REFUSED visitors are recorded but never admitted.
  // `reference` separates namesakes (organisation or the last digits of an ID), never a full ID number.
  status         String    @default("ON_SITE") @map("status")
  reference      String?
  refusedReason  String?   @map("refused_reason")
  checkedInById  String?   @map("checked_in_by_id")
  checkedOutById String?   @map("checked_out_by_id")
  version        Int       @default(1)
  idempotencyKey String?   @map("idempotency_key")
  requestHash    String?   @map("request_hash")
  contactRedactedAt DateTime? @map("contact_redacted_at")

  @@unique([campusId, idempotencyKey])
  @@index([campusId, status])
  @@index([schoolId])
  @@map("visitor_logs")
}

model Complaint {
  id              String   @id @default(uuid())
  schoolId        String   @default("") @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String   @map("campus_id")
  campus          Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  complainantName String   @map("complainant_name")
  type            String
  phone           String?
  date            DateTime
  description     String?  @db.Text
  actionTaken     String?  @map("action_taken") @db.Text
  status          String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  createdAt       DateTime @default(now()) @map("created_at")
  // SKO-467: a case has a receipt code, an owner (or is explicitly unassigned) and a response due date.
  // Confidential concerns are visible only to campus leaders and the assigned owner; the original report
  // (description, date, complainant) is never edited — follow-up lives in ComplaintEvent.
  referenceCode   String?   @map("reference_code")
  confidential    Boolean   @default(false)
  ownerId         String?   @map("owner_id")
  owner           User?     @relation("ComplaintOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate         DateTime? @map("due_date") @db.Date
  publicResponse  String?   @map("public_response") @db.Text
  resolution      String?   @db.Text
  resolvedAt      DateTime? @map("resolved_at")
  reopenedCount   Int       @default(0) @map("reopened_count")
  receivedById    String?   @map("received_by_id")
  version         Int       @default(1)
  idempotencyKey  String?   @map("idempotency_key")
  requestHash     String?   @map("request_hash")
  events          ComplaintEvent[]

  @@unique([campusId, referenceCode])
  @@unique([campusId, idempotencyKey])
  @@index([campusId, status])
  @@index([schoolId])
  @@map("complaints")
}

model ComplaintEvent {
  id          String    @id @default(uuid())
  schoolId    String    @default("") @map("school_id")
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String    @map("campus_id")
  complaintId String    @map("complaint_id")
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  kind        String // CREATED | ASSIGNED | NOTE | STATUS | RESOLVED | REOPENED
  fromStatus  String?   @map("from_status")
  toStatus    String?   @map("to_status")
  note        String?   @db.Text
  ownerId     String?   @map("owner_id")
  dueDate     DateTime? @map("due_date") @db.Date
  actorId     String    @map("actor_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([complaintId, createdAt])
  @@index([schoolId])
  @@map("complaint_events")
}

model PostalRecord {
  id          String   @id @default(uuid())
  schoolId    String   @default("") @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String   @map("campus_id")
  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  direction   String // RECEIVE | DISPATCH
  fromName    String?  @map("from_name")
  toName      String?  @map("to_name")
  referenceNo String?  @map("reference_no")
  date        DateTime
  note        String?
  // Legacy; no route serves it and the API no longer accepts it (SKO-464).
  fileKey     String?  @map("file_key")
  createdAt   DateTime @default(now()) @map("created_at")
  // SKO-464: an item is tracked to a handoff. RECEIVE: RECEIVED → ASSIGNED → COLLECTED.
  // DISPATCH: PREPARED → DISPATCHED → DELIVERED. A log save or tracking number is not delivery.
  itemCode       String?        @map("item_code")
  courier        String?
  status         String         @default("RECEIVED")
  ownerId        String?        @map("owner_id")
  owner          User?          @relation("PostalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  handedTo       String?        @map("handed_to")
  closedAt       DateTime?      @map("closed_at")
  recordedById   String?        @map("recorded_by_id")
  version        Int            @default(1)
  idempotencyKey String?        @map("idempotency_key")
  requestHash    String?        @map("request_hash")
  events         PostalEvent[]

  @@unique([campusId, itemCode])
  @@unique([campusId, idempotencyKey])
  @@index([campusId, status])
  @@index([schoolId])
  @@map("postal_records")
}

/// Every step of a postal item, including corrections with the values they replaced.
model PostalEvent {
  id         String       @id @default(uuid())
  schoolId   String       @default("") @map("school_id")
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String       @map("campus_id")
  postalId   String       @map("postal_id")
  postal     PostalRecord @relation(fields: [postalId], references: [id], onDelete: Cascade)
  kind       String // CREATED | ASSIGNED | DISPATCHED | COLLECTED | DELIVERED | CORRECTED
  fromStatus String?      @map("from_status")
  toStatus   String?      @map("to_status")
  ownerId    String?      @map("owner_id")
  changes    Json?
  note       String?      @db.Text
  actorId    String       @map("actor_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([postalId, createdAt])
  @@index([schoolId])
  @@map("postal_events")
}

model PhoneCallLog {
  id           String    @id @default(uuid())
  schoolId     String    @default("") @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String    @map("campus_id")
  campus       Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  // SKO-465: digits only, for search. Two callers sharing a number stay two separate contacts.
  phoneDigits    String          @default("") @map("phone_digits")
  direction      String // IN | OUT
  date           DateTime
  purpose        String?
  // Legacy single follow-up date; callbacks are now owned tasks in PhoneCallback.
  followUpDate   DateTime?       @map("follow_up_date")
  note           String?
  // A sensitive note is shown only to campus leaders, the person who logged the call and callback owners.
  sensitive      Boolean         @default(false)
  recordedById   String?         @map("recorded_by_id")
  idempotencyKey String?         @map("idempotency_key")
  requestHash    String?         @map("request_hash")
  createdAt      DateTime        @default(now()) @map("created_at")
  callbacks      PhoneCallback[]

  @@unique([campusId, idempotencyKey])
  @@index([campusId, date])
  @@index([schoolId])
  @@map("phone_call_logs")
}

/// SKO-465: a promised callback is an owned task. It stays OPEN through unsuccessful attempts and
/// reschedules until an outcome is recorded; a follow-up obligation is a new callback linked to it.
model PhoneCallback {
  id            String               @id @default(uuid())
  schoolId      String               @default("") @map("school_id")
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String               @map("campus_id")
  callId        String               @map("call_id")
  call          PhoneCallLog         @relation(fields: [callId], references: [id], onDelete: Cascade)
  ownerId       String?              @map("owner_id")
  owner         User?                @relation("PhoneCallbackOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueAt         DateTime             @map("due_at")
  status        String               @default("OPEN") // OPEN | DONE
  attempts      Int                  @default(0)
  outcome       String?              @db.Text
  completedAt   DateTime?            @map("completed_at")
  completedById String?              @map("completed_by_id")
  previousId    String?              @map("previous_id")
  previous      PhoneCallback?       @relation("PhoneCallbackChain", fields: [previousId], references: [id], onDelete: SetNull)
  next          PhoneCallback[]      @relation("PhoneCallbackChain")
  version       Int                  @default(1)
  createdById   String               @map("created_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  events        PhoneCallbackEvent[]

  @@index([campusId, status, dueAt])
  @@index([callId])
  @@index([schoolId])
  @@map("phone_callbacks")
}

model PhoneCallbackEvent {
  id         String        @id @default(uuid())
  schoolId   String        @default("") @map("school_id")
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String        @map("campus_id")
  callbackId String        @map("callback_id")
  callback   PhoneCallback @relation(fields: [callbackId], references: [id], onDelete: Cascade)
  kind       String // CREATED | REASSIGNED | RESCHEDULED | ATTEMPTED | COMPLETED
  ownerId    String?       @map("owner_id")
  dueAt      DateTime?     @map("due_at")
  note       String?       @db.Text
  actorId    String        @map("actor_id")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([callbackId, createdAt])
  @@index([schoolId])
  @@map("phone_callback_events")
}

model CertificateTemplate {
  id            String   @id @default(uuid())
  schoolId      String   @default("") @map("school_id")
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String   @map("campus_id")
  campus        Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  kind          String // STUDENT_CERTIFICATE | ID_CARD
  name          String
  backgroundKey String?  @map("background_key")
  // The working draft: { version: 1, title, body } — body uses {{variables}}. Issuing never reads it.
  layoutJson    Json     @map("layout_json")
  pageSize      String   @default("A4") @map("page_size")
  createdAt     DateTime @default(now()) @map("created_at")
  // SKO-469: the language the document is written in, whether issuing needs a leader's approval, and the
  // latest approved version (0 = never approved, cannot issue).
  language         String                       @default("en")
  requiresApproval Boolean                      @default(true) @map("requires_approval")
  currentVersion   Int                          @default(0) @map("current_version")
  draftVersion     Int                          @default(1) @map("draft_version")
  versions         CertificateTemplateVersion[]
  issues           CertificateIssue[]

  @@index([schoolId])
  @@map("certificate_templates")
}

/// An approved, immutable snapshot of a template. Issued documents point at exactly one.
model CertificateTemplateVersion {
  id           String              @id @default(uuid())
  schoolId     String              @default("") @map("school_id")
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String              @map("campus_id")
  templateId   String              @map("template_id")
  template     CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version      Int
  kind         String
  title        String
  body         String              @db.Text
  language     String
  pageSize     String              @map("page_size")
  approvedById String              @map("approved_by_id")
  approvedAt   DateTime            @default(now()) @map("approved_at")
  issues       CertificateIssue[]

  @@unique([templateId, version])
  @@index([schoolId])
  @@map("certificate_template_versions")
}

/// SKO-469: one issued (or requested) document. Its content is frozen at issue: re-downloading renders the
/// stored text, never the pupil's current record. A reissue is a new row pointing at the one it replaces.
model CertificateIssue {
  id                String                     @id @default(uuid())
  schoolId          String                     @default("") @map("school_id")
  school            School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId          String                     @map("campus_id")
  studentId         String                     @map("student_id")
  student           Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  templateId        String                     @map("template_id")
  template          CertificateTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersionId String                     @map("template_version_id")
  templateVersion   CertificateTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  serial            String
  status            String                     @default("PENDING_APPROVAL") // PENDING_APPROVAL | ISSUED | REJECTED | REVOKED | SUPERSEDED
  // Only the fields the template uses, as they were when requested.
  snapshot          Json
  title             String
  renderedBody      String                     @map("rendered_body") @db.Text
  language          String
  pageSize          String                     @map("page_size")
  photoUrl          String?                    @map("photo_url") @db.Text
  artifactHash      String                     @map("artifact_hash")
  // The PDF exactly as first delivered; every later download returns these bytes (written once).
  pdf               Bytes?
  pdfSha256         String?                    @map("pdf_sha256")
  verifyToken       String                     @map("verify_token")
  requestedById     String                     @map("requested_by_id")
  approvedById      String?                    @map("approved_by_id")
  approvedAt        DateTime?                  @map("approved_at")
  issuedAt          DateTime?                  @map("issued_at")
  decisionNote      String?                    @map("decision_note") @db.Text
  revokedAt         DateTime?                  @map("revoked_at")
  revokedById       String?                    @map("revoked_by_id")
  previousId        String?                    @map("previous_id")
  previous          CertificateIssue?          @relation("CertificateReissue", fields: [previousId], references: [id], onDelete: Restrict)
  successors        CertificateIssue[]         @relation("CertificateReissue")
  reissueReason     String?                    @map("reissue_reason") @db.Text
  version           Int                        @default(1)
  idempotencyKey    String?                    @map("idempotency_key")
  requestHash       String?                    @map("request_hash")
  createdAt         DateTime                   @default(now()) @map("created_at")

  @@unique([schoolId, serial])
  @@unique([verifyToken])
  @@unique([campusId, idempotencyKey])
  @@index([campusId, status])
  @@index([studentId])
  @@index([schoolId])
  @@map("certificate_issues")
}

/// A room hosting one paper of one exam (§58).
///
/// A paper that does not fit in a single room is split across several; each
/// row here is one of those rooms. The row flagged `isPrimary` mirrors
/// `ExamSchedule.roomId`, which is kept in step so the older single-room
/// readers do not have to know multi-room exists.
model ExamRoom {
  invigilation ExamInvigilation?
  id             String       @id @default(uuid())
  schoolId       String       @default("") @map("school_id")
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String       @map("campus_id")
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  examScheduleId String       @map("exam_schedule_id")
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  roomId         String       @map("room_id")
  room           ClassRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  isPrimary      Boolean      @default(false) @map("is_primary")
  createdAt      DateTime     @default(now()) @map("created_at")

  seats ExamSeat[]

  @@unique([examScheduleId, roomId])
  @@index([schoolId])
  @@map("exam_rooms")
}

/// One student's seat for one paper (§58).
///
/// The unique key on (examScheduleId, studentId) is the rule "no student is
/// seated twice" expressed where it cannot be bypassed — allocation code can
/// be rewritten, a database constraint cannot be forgotten.
model ExamSeat {
  id             String       @id @default(uuid())
  schoolId       String       @default("") @map("school_id")
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String       @map("campus_id")
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  examScheduleId String       @map("exam_schedule_id")
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  examRoomId     String       @map("exam_room_id")
  examRoom       ExamRoom     @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  studentId      String       @map("student_id")
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  seatNumber     Int          @map("seat_number")
  // Where in the room the seat actually is. A bare sequence number tells an
  // invigilator nothing they can act on; "Row 3, Bench 2, left" they can walk
  // to. All 1-based; 0 means a plan made before the grid existed.
  rowNo          Int          @default(0) @map("row_no")
  benchNo        Int          @default(0) @map("bench_no")
  seatOnBench    Int          @default(0) @map("seat_on_bench")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([examScheduleId, studentId])
  @@index([examRoomId])
  @@index([schoolId])
  @@map("exam_seats")
}

// ─── 18. MESSAGING / CHAT ─────────────────────────────────
//
// Direct and group messaging across all ten school roles. Who may open a
// thread with whom is decided in src/lib/chat/policy.ts — the schema holds
// no reachability rules, because they depend on live relationships (which
// class a teacher takes, whose child a guardian is) rather than on stored
// columns.
//
// Every row is tenant-owned: the Prisma guard stamps and filters school_id,
// so a conversation can never span two schools.

enum ConversationKind {
  DIRECT // exactly two people, deduplicated by pairKey
  GROUP // ad-hoc, named, anyone the creator may already reach
  CLASS // a class channel: its teachers plus students and/or guardians
  ANNOUNCEMENT // broadcast; only OWNER/MODERATOR members may post
}

enum ConversationMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum ChatMessageKind {
  TEXT
  FILE
  IMAGE
  SYSTEM // membership and title changes, written by the server
}

model Conversation {
  id       String           @id @default(uuid())
  schoolId String           @default("") @map("school_id")
  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId String?          @map("campus_id")
  campus   Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  kind     ConversationKind @default(DIRECT)
  title    String?
  topic    String?          @db.Text

  /// Set on CLASS channels so the roster can be reconciled when students move.
  classId String? @map("class_id")
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  /// The two participants of a DIRECT thread, ids sorted and joined by ":".
  /// Unique per school, so "message this person" always resolves to the one
  /// existing thread instead of forking a second one. NULL for every other
  /// kind — Postgres does not collide NULLs in a unique index.
  pairKey String? @map("pair_key")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// Read-only: kept visible and searchable, but closed to new messages.
  isLocked Boolean @default(false) @map("is_locked")

  // Denormalised so the conversation list is one query rather than one
  // extra lookup per row.
  lastMessageAt       DateTime? @map("last_message_at")
  lastMessagePreview  String?   @map("last_message_preview")
  lastMessageSenderId String?   @map("last_message_sender_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  ConversationMember[]
  messages ChatMessage[]

  @@unique([schoolId, pairKey])
  @@index([schoolId, campusId, lastMessageAt(sort: Desc)])
  @@index([schoolId, classId])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  schoolId       String       @default("") @map("school_id")
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation("ChatMemberships", fields: [userId], references: [id], onDelete: Cascade)

  memberRole ConversationMemberRole @default(MEMBER) @map("member_role")

  /// Maintained on send and reset on read, so the unread badge never needs a
  /// COUNT over the message table.
  unreadCount Int       @default(0) @map("unread_count")
  lastReadAt  DateTime? @map("last_read_at")

  isMuted    Boolean @default(false) @map("is_muted")
  isPinned   Boolean @default(false) @map("is_pinned")
  isArchived Boolean @default(false) @map("is_archived")

  joinedAt DateTime  @default(now()) @map("joined_at")
  /// Soft leave: the thread disappears from their list but the history they
  /// were part of stays intact for everyone else and for moderation.
  leftAt   DateTime? @map("left_at")

  @@unique([conversationId, userId])
  @@index([userId, leftAt, isArchived])
  @@index([schoolId])
  @@map("conversation_members")
}

model ChatMessage {
  id             String       @id @default(uuid())
  schoolId       String       @default("") @map("school_id")
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// NULL for SYSTEM notices, and after the author's account is deleted —
  /// the thread must stay readable for the people still in it.
  senderId String? @map("sender_id")
  sender   User?   @relation("ChatMessagesSent", fields: [senderId], references: [id], onDelete: SetNull)

  kind ChatMessageKind @default(TEXT)
  body String          @db.Text

  replyToId String?       @map("reply_to_id")
  replyTo   ChatMessage?  @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatMessageReplies")

  attachments ChatAttachment[]

  editedAt    DateTime? @map("edited_at")
  /// Soft delete. The row survives so the school retains an auditable record
  /// of what was said; only the body is withheld from the thread.
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  /// Sender-generated id, so a retried POST re-reads the message it already
  /// created instead of posting it twice.
  clientKey String? @map("client_key")
  /// SKO-415: staff may mark a message urgent so it notifies during quiet hours; it is labelled in the thread.
  isUrgent  Boolean  @default(false) @map("is_urgent")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([conversationId, clientKey])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([schoolId])
  @@map("chat_messages")
}

model ChatAttachment {
  id          String      @id @default(uuid())
  schoolId    String      @default("") @map("school_id")
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
