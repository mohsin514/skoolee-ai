  libraryMemberships            LibraryMember[]

  // FINDING-D: email was globally unique, so one person could not hold an
  // account at two schools — a parent with children at two institutions, or a
  // teacher working across two groups, was unrepresentable. Identity is now
  // scoped to the tenant: the same address may exist once per school.
  passwordResets       PasswordReset[]      @relation("PasswordResetUser")
