// ─── 12. ACADEMIC INFRASTRUCTURE (ROOMS + PERIODS) ───────
model ClassRoom {
  id         String  @id @default(uuid())
  schoolId   String  @default("") @map("school_id")
  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String  @map("campus_id")
  roomNumber String  @map("room_number")
  capacity   Int     @default(0) // TEACHING seats; 0 = not set
  note       String?

  // ── Where the room is ──────────────────────────────────────────────
  // An invigilator handed a seating plan needs to find the room, and
  // "R-101" alone does not say which block or which floor.
  building String? // "Main Block", "Science Wing"
  floor    Int     @default(0) // 0 = ground, 1 = first, -1 = basement
  wing     String? // "East", "North"
  roomType String  @default("CLASSROOM") @map("room_type") // CLASSROOM | HALL | LAB | LIBRARY | AUDITORIUM

  // ── How the room is laid out ───────────────────────────────────────
  // Teaching capacity and exam capacity are NOT the same number, and
  // conflating them is how a 30-seat room gets handed 30 candidates who
  // then sit three-to-a-bench copying from each other.
  //
  //   teaching capacity = rows × benchesPerRow × seatsPerBench
  //   exam capacity     = rows × benchesPerRow × examSeatsPerBench
  //
  // A 30-seat room laid out as 5 rows × 2 benches × 3 seats holds only
  // 10 candidates once exam spacing (1 per bench) is applied.
  rows              Int     @default(0) // rows of benches, front to back
  benchesPerRow     Int     @default(0) // benches across one row
  seatsPerBench     Int     @default(1) // pupils per bench in a lesson
  examSeatsPerBench Int     @default(1) @map("exam_seats_per_bench") // pupils per bench in an exam
  isExamHall        Boolean @default(false) @map("is_exam_hall") // prefer this room when auto-allocating

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campus        Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  slots         TimetableSlot[]
  examSchedules ExamSchedule[]
  examRooms     ExamRoom[]

  @@unique([campusId, roomNumber])
  @@index([schoolId])
  @@map("class_rooms")
}

// Period definitions drive the timetable grid row headers and exam
// routines. Times are "HH:mm" and must not overlap within a timeType.
model PeriodDefinition {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  timeType     String   @default("CLASS") @map("time_type") // CLASS | EXAM
  periodNumber Int      @map("period_number") // 1-based sequence
  startTime    String   @map("start_time") // "HH:mm"
  endTime      String   @map("end_time") // "HH:mm"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campus        Campus         @relation(fields: [campusId], references: [id], onDelete: Cascade)
  examSchedules ExamSchedule[]

  @@unique([campusId, timeType, periodNumber])
  @@index([schoolId])
  @@map("period_definitions")
}

// ─── 15. TIMETABLES ───────────────────────────────────────
model Timetable {
  id           String    @id @default(uuid())
  schoolId     String    @default("") @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String    @map("campus_id")
  campus       Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId      String    @map("class_id")
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear Int       @map("academic_year")
  term         String    @default("ANNUAL")
  status       String    @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  // SKO-403: the slot rows are the working draft; every edit bumps the revision. Families, students and
  // teachers read the published version in force, so editing never changes their view until publication.
  draftRevision Int      @default(1) @map("draft_revision")

  slots    TimetableSlot[]
  versions TimetableVersion[]

  @@unique([classId, academicYear, term])
  @@index([campusId])
  @@index([schoolId])
  @@map("timetables")
}

model TimetableSlot {
  substituteDuties SchoolAiSubstituteDuty[]
  id           String     @id @default(uuid())
  schoolId     String     @default("") @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableId  String     @map("timetable_id")
  timetable    Timetable  @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        @map("day_of_week") // 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  periodNumber Int        @map("period_number") // 1-8
  subjectId    String?    @map("subject_id")
  subject      Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId    String?    @map("teacher_id")
  teacher      User?      @relation("TimetableTeacher", fields: [teacherId], references: [id])
  roomId       String?    @map("room_id")
  room         ClassRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomNumber   String?    @map("room_number")
  startTime    String     @map("start_time") // "08:00"
  endTime      String     @map("end_time") // "08:40"
  slotType     String     @default("CLASS") @map("slot_type") // CLASS, BREAK, ASSEMBLY, PRAYER, ACTIVITY

  @@unique([timetableId, dayOfWeek, periodNumber])
  @@index([teacherId, dayOfWeek, periodNumber])
  @@index([schoolId])
  @@map("timetable_slots")
}

/// SKO-403: an immutable published timetable. Bound to the exact draft revision that was validated; the
/// previous version stays in force until this one's effective date.
model TimetableVersion {
  id            String    @id @default(uuid())
  schoolId      String    @default("") @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String    @map("campus_id")
  timetableId   String    @map("timetable_id")
  timetable     Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  version       Int
  draftRevision Int       @map("draft_revision")
  effectiveFrom DateTime  @db.Date @map("effective_from")
  slots         Json
  changes       Json      @default("[]")
  note          String?   @db.Text
  publishedById String?   @map("published_by_id")
  publishedAt   DateTime  @default(now()) @map("published_at")
  notifiedAt    DateTime? @map("notified_at")

  @@unique([timetableId, version])
  @@index([timetableId, effectiveFrom])
  @@index([schoolId])
  @@map("timetable_versions")
}

/// SKO-421: a guardian's request for a learner's future leave. A school decision is recorded here; the
/// register itself is only ever changed by staff marking it.
model LearnerLeaveRequest {
  id            String    @id @default(uuid())
  schoolId      String    @default("") @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String    @map("campus_id")
  studentId     String    @map("student_id")
  requestedById String    @map("requested_by_id")
  fromDate      DateTime  @db.Date @map("from_date")
  toDate        DateTime  @db.Date @map("to_date")
  reason        String    @db.Text
  status        String    @default("PENDING") // PENDING | CLARIFICATION | APPROVED | DECLINED | CANCELLED
  reviewNote    String?   @db.Text @map("review_note")
  reviewedById  String?   @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, studentId, fromDate])
  @@index([campusId, status])
  @@map("learner_leave_requests")
}

/// SKO-421: a school trip. Its terms live in numbered versions; families answer one exact version.
model Trip {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String    @map("campus_id")
  status         String    @default("OPEN") // OPEN | CANCELLED
  currentVersion Int       @default(1) @map("current_version")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  versions TripVersion[]
  invitees TripInvitee[]
  consents TripConsent[]

  @@index([campusId, status])
  @@index([schoolId])
  @@map("trips")
}

/// SKO-421: immutable trip terms. A material change publishes a new version that needs fresh answers.
model TripVersion {
  id            String   @id @default(uuid())
  schoolId      String   @default("") @map("school_id")
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tripId        String   @map("trip_id")
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  version       Int
  title         String
  destination   String
  departAt      DateTime @map("depart_at")
  returnAt      DateTime @map("return_at")
  costAmount    Int      @default(0) @map("cost_amount")
  costCurrency  String   @default("PKR") @map("cost_currency")
  contact       String
  instructions  String   @db.Text
  consentKind   String   @map("consent_kind") // fieldTrips | offsiteTravel
  signatoryRule String   @map("signatory_rule") // ANY_GUARDIAN | ALL_GUARDIANS
  respondBy     DateTime @map("respond_by")
  material      Boolean  @default(true)
  changeNote    String?  @db.Text @map("change_note")
  publishedById String   @map("published_by_id")
  publishedAt   DateTime @default(now()) @map("published_at")

  consents TripConsent[]

  @@unique([tripId, version])
  @@index([schoolId])
  @@map("trip_versions")
}

model TripInvitee {
  id        String @id @default(uuid())
  schoolId  String @default("") @map("school_id")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tripId    String @map("trip_id")
  trip      Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  studentId String @map("student_id")

  @@unique([tripId, studentId])
  @@index([schoolId])
  @@map("trip_invitees")
}

/// SKO-421: one guardian's answer to one exact trip version, kept forever; a withdrawal is a new row.
model TripConsent {
  id             String      @id @default(uuid())
  schoolId       String      @default("") @map("school_id")
  school         School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tripId         String      @map("trip_id")
  trip           Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripVersionId  String      @map("trip_version_id")
  tripVersion    TripVersion @relation(fields: [tripVersionId], references: [id], onDelete: Cascade)
  studentId      String      @map("student_id")
  guardianUserId String      @map("guardian_user_id")
  relationshipId String      @map("relationship_id")
  choice         String // GRANTED | DECLINED | WITHDRAWN
  signatoryRule  String      @map("signatory_rule")
  idempotencyKey String      @map("idempotency_key")
  receiptCode    String      @map("receipt_code")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@unique([tripVersionId, guardianUserId, idempotencyKey])
  @@unique([schoolId, receiptCode])
  @@index([tripId, studentId])
  @@index([schoolId])
  @@map("trip_consents")
}

/// SKO-423: a class's weekly family update. Built only from released evidence, reviewed and approved by a
/// teacher for an exact content version, then delivered once per child, guardian and channel.
model FamilyDigest {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  classId         String    @map("class_id")
  weekStart       DateTime  @db.Date @map("week_start")
  status          String    @default("DRAFT") // DRAFT | APPROVED | SCHEDULED | SENT | CANCELLED
  version         Int       @default(1)
  approvedVersion Int?      @map("approved_version")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  scheduledFor    DateTime? @map("scheduled_for")
  sentAt          DateTime? @map("sent_at")
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  entries    FamilyDigestEntry[]
  deliveries FamilyDigestDelivery[]

  @@unique([classId, weekStart])
  @@index([campusId, status])
  @@index([schoolId])
  @@map("family_digests")
}

/// One child's section of a digest: sourced statements, one home activity, and whether it is sent at all.
model FamilyDigestEntry {
  id        String       @id @default(uuid())
  schoolId  String       @default("") @map("school_id")
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  digestId  String       @map("digest_id")
  digest    FamilyDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)
  studentId String       @map("student_id")
  content   Json
  skipped   Boolean      @default(false)
  status    String       @default("PENDING") // PENDING | SENT | BLOCKED
  reason    String?

  deliveries FamilyDigestDelivery[]

  @@unique([digestId, studentId])
  @@index([schoolId])
  @@map("family_digest_entries")
}

/// A delivery to one guardian on one channel for one child's week; unique so a retry never sends twice.
model FamilyDigestDelivery {
  id             String            @id @default(uuid())
  schoolId       String            @default("") @map("school_id")
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  digestId       String            @map("digest_id")
  digest         FamilyDigest      @relation(fields: [digestId], references: [id], onDelete: Cascade)
  entryId        String            @map("entry_id")
  entry          FamilyDigestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  studentId      String            @map("student_id")
  guardianUserId String            @map("guardian_user_id")
  channel        String            @default("IN_APP")
  weekStart      DateTime          @db.Date @map("week_start")
  version        Int
  status         String            @default("SENT") // SENT | BLOCKED
  reason         String?
  seenAt         DateTime?         @map("seen_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([studentId, weekStart, guardianUserId, channel])
  @@index([schoolId, guardianUserId])
  @@map("family_digest_deliveries")
}

/// SKO-412: a printable marks sheet for one exam subject. The QR carries only the opaque reference and page
/// number; the roster is frozen in the template so a scan maps rows to pupils without reading names.
model MarkSheetTemplate {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  examId       String   @map("exam_id")
  subjectId    String   @map("subject_id")
  version      Int
  reference    String   @unique
  rowsPerPage  Int      @map("rows_per_page")
  pageCount    Int      @map("page_count")
  maxMarks     Int      @map("max_marks")
  roster       Json
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  batches MarkScanBatch[]

  @@unique([examId, subjectId, version])
  @@index([schoolId])
  @@map("mark_sheet_templates")
}

/// SKO-412: one scanning session for a template: captured pages, staged cells, review, approval, commit.
model MarkScanBatch {
  id             String            @id @default(uuid())
  schoolId       String            @default("") @map("school_id")
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String            @map("campus_id")
  templateId     String            @map("template_id")
  template       MarkSheetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  status         String            @default("CAPTURING") // CAPTURING | REVIEW | APPROVED | COMMITTED | REVERSED | CANCELLED
  version        Int               @default(1)
  baseline       Json              @default("{}")
  approvedById   String?           @map("approved_by_id")
  approvedAt     DateTime?         @map("approved_at")
  committedAt    DateTime?         @map("committed_at")
  commitKey      String?           @map("commit_key")
  receipt        Json?
  reversedAt     DateTime?         @map("reversed_at")
  createdById    String            @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  pages MarkScanPage[]
  cells MarkScanCell[]

  @@index([templateId, status])
  @@index([schoolId])
  @@map("mark_scan_batches")
}

model MarkScanPage {
  id         String        @id @default(uuid())
  schoolId   String        @default("") @map("school_id")
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batchId    String        @map("batch_id")
  batch      MarkScanBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pageNumber Int           @map("page_number")
  storageKey String        @map("storage_key")
  sha256     String
  sharpness  Float
  contrast   Float
  status     String        @default("ACCEPTED") // ACCEPTED | RETAKE | REPLACED
  reason     String?
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([batchId, pageNumber])
  @@index([schoolId])
  @@map("mark_scan_pages")
}

/// One pupil's mark as read from a page. The proposal and its confidence are kept; only the reviewed value is imported.
model MarkScanCell {
  id               String        @id @default(uuid())
  schoolId         String        @default("") @map("school_id")
  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batchId          String        @map("batch_id")
  batch            MarkScanBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pageNumber       Int           @map("page_number")
  rowNumber        Int           @map("row_number")
  studentId        String        @map("student_id")
  proposedValue    Float?        @map("proposed_value")
  proposedAbsent   Boolean       @default(false) @map("proposed_absent")
  confidence       Float?
  alternatives     Json          @default("[]")
  reviewedValue    Float?        @map("reviewed_value")
  reviewedAbsent   Boolean       @default(false) @map("reviewed_absent")
  reviewedById     String?       @map("reviewed_by_id")
  reviewedAt       DateTime?     @map("reviewed_at")
  status           String        @default("NEEDS_REVIEW") // NEEDS_REVIEW | REVIEWED | EXCLUDED
  corrected        Boolean       @default(false)

  @@unique([batchId, studentId])
  @@index([schoolId])
  @@map("mark_scan_cells")
}

/// SKO-420: a teacher's bookable window in school-local time. Slots are computed from it; a booking holds
/// the exact instant. Lessons on the published timetable and approved leave hide overlapping slots.
model MeetingWindow {
  id                 String   @id @default(uuid())
  schoolId           String   @default("") @map("school_id")
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId           String   @map("campus_id")
  teacherId          String   @map("teacher_id")
  localDate          String   @map("local_date") // YYYY-MM-DD in the school timezone
  startTime          String   @map("start_time") // HH:MM
  endTime            String   @map("end_time")
  timezone           String
  slotMinutes        Int      @map("slot_minutes")
  bufferMinutes      Int      @default(0) @map("buffer_minutes")
  maxBookings        Int?     @map("max_bookings")
  mode               String   @default("IN_PERSON") // IN_PERSON | REMOTE | EITHER
  location           String?
  cancellationPolicy String   @map("cancellation_policy")
  status             String   @default("OPEN") // OPEN | WITHDRAWN
  createdById        String   @map("created_by_id")
  createdAt          DateTime @default(now()) @map("created_at")

  bookings MeetingBooking[]

  @@index([schoolId, teacherId, localDate])
  @@map("meeting_windows")
}

/// SKO-420: one booked meeting for one child. A partial unique index keeps one live booking per teacher
/// and start instant, so concurrent families cannot both hold the slot.
model MeetingBooking {
  id             String        @id @default(uuid())
  schoolId       String        @default("") @map("school_id")
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String        @map("campus_id")
  windowId       String        @map("window_id")
  window         MeetingWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  teacherId      String        @map("teacher_id")
  studentId      String        @map("student_id")
  guardianUserId String        @map("guardian_user_id")
  relationshipId String        @map("relationship_id")
  startsAt       DateTime      @map("starts_at")
  endsAt         DateTime      @map("ends_at")
  mode           String // IN_PERSON | REMOTE
  agenda         String?
  accessNeeds    String?       @map("access_needs")
  status         String        @default("CONFIRMED") // CONFIRMED | RESCHEDULE_NEEDED | CANCELLED | HELD | NOT_HELD
  conflictReason String?       @map("conflict_reason") // LEAVE | TIMETABLE | WINDOW_WITHDRAWN
  version        Int           @default(1)
  requestKey     String        @unique @map("request_key")
  remindedAt     DateTime?     @map("reminded_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  events   MeetingBookingEvent[]
  followUp MeetingFollowUp?
  actions  MeetingAction[]
  notes    MeetingStaffNote[]

  @@index([schoolId, teacherId, startsAt])
  @@index([schoolId, guardianUserId])
  @@map("meeting_bookings")
}

/// SKO-420: versioned receipt of every booking change (book, reschedule, cancel, conflict, outcome).
model MeetingBookingEvent {
  id        String         @id @default(uuid())
  schoolId  String         @default("") @map("school_id")
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bookingId String         @map("booking_id")
  booking   MeetingBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  version   Int
  action    String // BOOKED | RESCHEDULED | CANCELLED | CONFLICT | HELD | NOT_HELD
  actorId   String?        @map("actor_id")
  detail    Json
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([bookingId, version])
  @@index([schoolId])
  @@map("meeting_booking_events")
}

/// SKO-420: the reviewed summary shared with the family. Staff notes live in MeetingStaffNote, never here.
model MeetingFollowUp {
  id          String         @id @default(uuid())
  schoolId    String         @default("") @map("school_id")
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bookingId   String         @unique @map("booking_id")
  booking     MeetingBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  summary     String
  sharedAt    DateTime?      @map("shared_at")
  sharedById  String?        @map("shared_by_id")
  updatedById String         @map("updated_by_id")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("meeting_follow_ups")
}

/// SKO-420: an agreed action with one owner and a due date; visible to the family once shared.
model MeetingAction {
  id            String         @id @default(uuid())
  schoolId      String         @default("") @map("school_id")
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bookingId     String         @map("booking_id")
  booking       MeetingBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studentId     String         @map("student_id")
  text          String
  ownerRole     String         @map("owner_role") // FAMILY | STAFF
  ownerUserId   String         @map("owner_user_id")
  dueDate       String         @map("due_date") // YYYY-MM-DD, school-local
  status        String         @default("OPEN") // OPEN | DONE
  completedAt   DateTime?      @map("completed_at")
  completedById String?        @map("completed_by_id")
  createdById   String         @map("created_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([schoolId, ownerUserId, status])
  @@map("meeting_actions")
}

/// SKO-420: restricted staff notes for a meeting. No family route reads this table.
model MeetingStaffNote {
  id        String         @id @default(uuid())
  schoolId  String         @default("") @map("school_id")
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bookingId String         @map("booking_id")
  booking   MeetingBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String         @map("author_id")
  body      String
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([schoolId, bookingId])
  @@map("meeting_staff_notes")
}

/// SKO-442: the teaching handover and outcome for one dated cover duty. Staff-only: instructions and the
/// actual activity never reach families; a recovery task is the learner-facing follow-up.
model CoverHandover {
  id               String    @id @default(uuid())
  schoolId         String    @default("") @map("school_id")
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId         String    @map("campus_id")
  dutyId           String    @unique @map("duty_id")
  objective        String?
  instructions     String?
  resourceIds      String[]  @default([]) @map("resource_ids")
  updatedById      String?   @map("updated_by_id")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedById String?   @map("acknowledged_by_id")
  outcome          String?   // DELIVERED | SUPERVISED_ONLY | NOT_HELD
  actualActivity   String?   @map("actual_activity")
  outcomeAt        DateTime? @map("outcome_at")
  outcomeById      String?   @map("outcome_by_id")

  @@index([schoolId])
  @@map("cover_handovers")
}

/// SKO-442: missed or changed learning for one lesson on one date. Created when cover was supervision only,
/// did not happen, or a lesson had no cover; it stays open until its teacher plans and completes a catch-up
/// or records, with a reason, that none is needed. Learners see it only once published.
model LessonRecovery {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  timetableSlotId String    @map("timetable_slot_id")
  date            DateTime  @db.Date
  classId         String    @map("class_id")
  subjectName     String    @map("subject_name")
  ownerId         String    @map("owner_id")
  source          String // SUPERVISED_ONLY | NOT_HELD | UNCOVERED
  dutyId          String?   @map("duty_id")
  status          String    @default("DECISION_NEEDED") // DECISION_NEEDED | PLANNED | PUBLISHED | COMPLETED | NOT_NEEDED
  title           String?
  instructions    String?
  dueDate         String?   @map("due_date") // YYYY-MM-DD, school-local
  decisionNote    String?   @map("decision_note")
  evidenceNote    String?   @map("evidence_note")
  version         Int       @default(1)
  createdById     String    @map("created_by_id")
  publishedAt     DateTime? @map("published_at")
  completedAt     DateTime? @map("completed_at")
  completedById   String?   @map("completed_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([schoolId, timetableSlotId, date])
  @@index([schoolId, ownerId, status])
  @@index([schoolId, classId, status])
  @@map("lesson_recoveries")
}

/// SKO-441: a plain-language request type with its routing rule. Targets are the school's own; with no
/// target set, nothing is shown as late. Safety categories go straight to the escalation contact.
model ServiceCategory {
  id              String   @id @default(uuid())
  schoolId        String   @default("") @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String   @map("campus_id")
  name            String
  kind            String // REPAIR | ACCESS | SUPPLIES | INFORMATION
  team            String // the team that handles it, e.g. "IT" or "Facilities"
  departmentId    String?  @map("department_id")
  defaultOwnerId  String?  @map("default_owner_id")
  escalationId    String?  @map("escalation_id")
  responseHours   Int?     @map("response_hours")
  resolveHours    Int?     @map("resolve_hours")
  keywords        String[] @default([])
  safety          Boolean  @default(false)
  active          Boolean  @default(true)
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  requests ServiceRequest[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("service_categories")
}

/// SKO-441: one internal request with a stable school reference (SD-<n>). It always has an owner or sits
/// in the explicit unassigned queue; timings are kept on reopen.
model ServiceRequest {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  reference       String
  categoryId      String    @map("category_id")
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title           String
  description     String
  location        String
  roomId          String?   @map("room_id")
  itemId          String?   @map("item_id")
  requesterId     String    @map("requester_id")
  ownerId         String?   @map("owner_id")
  watcherIds      String[]  @default([]) @map("watcher_ids")
  priority        String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status          String    @default("OPEN") // OPEN | IN_PROGRESS | BLOCKED | RESOLVED | CLOSED
  blockedReason   String?   @map("blocked_reason")
  responseDueAt   DateTime? @map("response_due_at")
  resolveDueAt    DateTime? @map("resolve_due_at")
  firstResponseAt DateTime? @map("first_response_at")
  resolvedAt      DateTime? @map("resolved_at")
  firstResolvedAt DateTime? @map("first_resolved_at")
  closedAt        DateTime? @map("closed_at")
  reopenedCount   Int       @default(0) @map("reopened_count")
  escalatedForDue DateTime? @map("escalated_for_due")
  version         Int       @default(1)
  idempotencyKey  String    @map("idempotency_key")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  events ServiceRequestEvent[]

  @@unique([schoolId, reference])
  @@unique([requesterId, idempotencyKey])
  @@index([schoolId, campusId, status])
  @@index([schoolId, ownerId, status])
  @@map("service_requests")
}

/// SKO-441: the request timeline. INTERNAL entries (notes, routing, private evidence) never reach the
/// requester; REQUESTER entries are deliberate updates.
model ServiceRequestEvent {
  id            String   @id @default(uuid())
  schoolId      String   @default("") @map("school_id")
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestId     String   @map("request_id")
  request       ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version       Int
  kind          String // CREATED | ASSIGNED | PRIORITY | DUE | STATUS | BLOCKED | NOTE | UPDATE | RESOLVED | CONFIRMED | REOPENED | ESCALATED
  visibility    String   @default("INTERNAL") // INTERNAL | REQUESTER
  actorId       String?  @map("actor_id")
  body          String?
  detail        Json     @default("{}")
  attachmentKey String?  @map("attachment_key")
  attachmentType String? @map("attachment_type")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([schoolId, requestId])
  @@map("service_request_events")
}

/// SKO-427: one piece of evidence in a learner's portfolio. It points at immutable submission versions (the
/// earlier attempt with its returned feedback, and optionally a later revision) and snapshots the learning
/// goal, so a later revision never rewrites the record. The learner writes the reflection; the teacher
/// approves an exact reflection version, and only that approved text reaches families. Removing an entry
/// never touches the assignment.
model PortfolioEntry {
  id                 String    @id @default(uuid())
  schoolId           String    @default("") @map("school_id")
  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId           String    @map("campus_id")
  studentId          String    @map("student_id")
  classId            String    @map("class_id")
  goal               Json // { curriculumId, curriculumVersion, outcomeId, code, title } or null-ish {}
  title              String
  assignmentId       String    @map("assignment_id")
  earlierVersionId   String    @map("earlier_version_id")
  laterVersionId     String?   @map("later_version_id")
  criterionIds       String[]  @default([]) @map("criterion_ids")
  reflection         String    @default("")
  reflectionVersion  Int       @default(0) @map("reflection_version")
  status             String    @default("DRAFT") // DRAFT | PROPOSED | APPROVED | CHANGES_REQUESTED
  approvedReflection String?   @map("approved_reflection")
  approvedVersion    Int?      @map("approved_version")
  teacherComment     String?   @map("teacher_comment")
  staffNote          String?   @map("staff_note")
  familyVisible      Boolean   @default(false) @map("family_visible")
  reviewedById       String?   @map("reviewed_by_id")
  reviewedAt         DateTime? @map("reviewed_at")
  version            Int       @default(1)
  idempotencyKey     String    @map("idempotency_key")
  createdById        String    @map("created_by_id")
  removedAt          DateTime? @map("removed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([studentId, idempotencyKey])
  @@index([schoolId, studentId])
  @@map("portfolio_entries")
}

/// SKO-427: a teacher-approved collection shared with one named guardian until it expires or is revoked.
/// Every open rechecks the guardian's current learning-record permission and each entry's approval.
model PortfolioShare {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String    @map("student_id")
  guardianUserId String    @map("guardian_user_id")
  title          String
  entryIds       String[]  @map("entry_ids")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  revokedById    String?   @map("revoked_by_id")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([schoolId, guardianUserId])
  @@index([schoolId, studentId])
  @@map("portfolio_shares")
}

/// SKO-428: approved study text for one published resource version, with its page or section. Only
/// passages of the version currently published for learners are ever retrieved; answer keys and staff
/// material can never hold passages.
model StudyPassage {
  id              String   @id @default(uuid())
  schoolId        String   @default("") @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  resourceId      String   @map("resource_id")
  resourceVersion Int      @map("resource_version")
  classId         String   @map("class_id")
  section         String
  text            String
  createdById     String   @map("created_by_id")
  removedAt       DateTime? @map("removed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([schoolId, classId])
  @@index([schoolId, resourceId, resourceVersion])
  @@map("study_passages")
}

/// SKO-428: one learner question and what the assistant did with it. Keeps the minimum needed for review:
/// the question, the answer, the passages cited and the outcome. A report or a request for the teacher
/// never changes any student record.
model StudyTurn {
  id            String    @id @default(uuid())
  schoolId      String    @default("") @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String    @map("student_id")
  classId       String    @map("class_id")
  question      String
  outcome       String // ANSWERED | UNSUPPORTED | BLOCKED | UNAVAILABLE | REFUSED
  answer        Json      @default("{}")
  citationIds   String[]  @default([]) @map("citation_ids")
  engine        String
  promptVersion String?   @map("prompt_version")
  reportedAt    DateTime? @map("reported_at")
  reportReason  String?   @map("report_reason")
  helpRequestedAt DateTime? @map("help_requested_at")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewedById  String?   @map("reviewed_by_id")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([schoolId, studentId, createdAt])
  @@index([schoolId, classId])
  @@map("study_turns")
}

/// SKO-438: a guardian's permission for a named person to collect one child at one campus within a window.
/// The QR holds only an opaque token whose hash is stored here; it is consumed once, atomically.
model PickupAuthorization {
  id               String    @id @default(uuid())
  schoolId         String    @default("") @map("school_id")
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId         String    @map("campus_id")
  studentId        String    @map("student_id")
  issuedById       String    @map("issued_by_id")
  relationshipId   String    @map("relationship_id")
  recipientName    String    @map("recipient_name")
  recipientRelation String   @map("recipient_relation")
  idMethod         String    @map("id_method") // PHOTO_ID | SCHOOL_PICKUP_CARD | KNOWN_TO_STAFF
  idLast4          String?   @map("id_last4")
  validFrom        DateTime  @map("valid_from")
  validUntil       DateTime  @map("valid_until")
  tokenHash        String    @unique @map("token_hash")
  status           String    @default("ACTIVE") // ACTIVE | USED | REVOKED
  revokedAt        DateTime? @map("revoked_at")
  revokedById      String?   @map("revoked_by_id")
  usedAt           DateTime? @map("used_at")
  usedByCheckId    String?   @unique @map("used_by_check_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  checks PickupCheck[]

  @@index([schoolId, studentId])
  @@map("pickup_authorizations")
}

/// SKO-438: a restriction on releasing a child (custody order, do-not-release, supervised only). The gate
/// sees that a restriction exists and what to do; the reason stays with authorized staff.
model PickupRestriction {
  id          String    @id @default(uuid())
  schoolId    String    @default("") @map("school_id")
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String    @map("campus_id")
  studentId   String    @map("student_id")
  kind        String // CUSTODY_ORDER | DO_NOT_RELEASE | LEAD_APPROVAL
  instruction String
  reason      String?
  leadUserId  String?   @map("lead_user_id")
  endsAt      DateTime? @map("ends_at")
  createdById String    @map("created_by_id")
  liftedAt    DateTime? @map("lifted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([schoolId, studentId])
  @@map("pickup_restrictions")
}

/// SKO-438: one gate check — scan, identity confirmation, release or escalation. Release always rechecks.
model PickupCheck {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  authorizationId String?   @map("authorization_id")
  authorization   PickupAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  studentId       String    @map("student_id")
  gate            String
  staffId         String    @map("staff_id")
  status          String    @default("OPEN") // OPEN | RELEASED | BLOCKED | ESCALATED | CANCELLED
  blockReason     String?   @map("block_reason")
  identityMethod  String?   @map("identity_method")
  identityAt      DateTime? @map("identity_at")
  exceptionStatus String?   @map("exception_status") // REQUESTED | APPROVED | DENIED
  exceptionNote   String?   @map("exception_note")
  exceptionById   String?   @map("exception_by_id")
  releasedAt      DateTime? @map("released_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, studentId])
  @@index([schoolId, campusId, status])
  @@map("pickup_checks")
}

/// SKO-438: the release history — who authorized, who collected, which staff verified, when, exceptions.
model PickupEvent {
  id              String   @id @default(uuid())
  schoolId        String   @default("") @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId       String   @map("student_id")
  authorizationId String?  @map("authorization_id")
  checkId         String?  @map("check_id")
  kind            String // ISSUED | REVOKED | SCANNED | BLOCKED | RELEASED | EXCEPTION_REQUESTED | EXCEPTION_APPROVED | EXCEPTION_DENIED | RESTRICTION_ADDED | RESTRICTION_LIFTED
  actorId         String?  @map("actor_id")
  detail          Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([schoolId, studentId, createdAt])
  @@map("pickup_events")
}

/// SKO-440: a club, sport or trip with its capacity, eligibility, cost and (for trips) the consent record it
/// relies on. Places are counted against capacity; interest alone never holds a place.
model Activity {
  id            String    @id @default(uuid())
  schoolId      String    @default("") @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String    @map("campus_id")
  kind          String // CLUB | SPORT | TRIP
  title         String
  description   String
  location      String
  startsAt      DateTime  @map("starts_at")
  endsAt        DateTime  @map("ends_at")
  capacity      Int
  classIds      String[]  @default([]) @map("class_ids")
  staffIds      String[]  @default([]) @map("staff_ids")
  costAmount    Int       @default(0) @map("cost_amount")
  costCurrency  String    @default("PKR") @map("cost_currency")
  tripId        String?   @unique @map("trip_id")
  offerHours    Int       @default(48) @map("offer_hours")
  cancellationTerms String @map("cancellation_terms")
  status        String    @default("PUBLISHED") // PUBLISHED | CANCELLED
  coordinatorId String    @map("coordinator_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  places   ActivityPlace[]
  sessions ActivitySession[]

  @@index([schoolId, campusId, startsAt])
  @@map("activities")
}

/// SKO-440: one learner's place. WAITLIST → OFFERED (expiring) → RESERVED (conditional until consent and fee
/// rules pass) → CONFIRMED; or DECLINED / EXPIRED / CANCELLED. A cancellation of a paid place hands off one
/// refund request to the reviewed finance workflow.
model ActivityPlace {
  id               String    @id @default(uuid())
  schoolId         String    @default("") @map("school_id")
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activityId       String    @map("activity_id")
  activity         Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentId        String    @map("student_id")
  requestedById    String    @map("requested_by_id")
  status           String // WAITLIST | OFFERED | RESERVED | CONFIRMED | DECLINED | EXPIRED | CANCELLED
  offerExpiresAt   DateTime? @map("offer_expires_at")
  feeStatus        String    @default("NONE") @map("fee_status") // NONE | DUE | PAID | WAIVED
  invoiceId        String?   @map("invoice_id")
  paymentId        String?   @map("payment_id")
  refundState      String?   @map("refund_state") // NEEDED | REQUESTED
  refundAdjustmentId String? @map("refund_adjustment_id")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelledById    String?   @map("cancelled_by_id")
  cancelReason     String?   @map("cancel_reason")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([activityId, studentId])
  @@index([schoolId, studentId])
  @@map("activity_places")
}

model ActivitySession {
  id         String   @id @default(uuid())
  schoolId   String   @default("") @map("school_id")
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activityId String   @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolId, activityId])
  @@map("activity_sessions")
}

model ActivityAttendance {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId String   @map("session_id")
  studentId String   @map("student_id")
  status    String // PRESENT | ABSENT | LATE_WITHDRAWAL
  markedById String  @map("marked_by_id")
  markedAt  DateTime @default(now()) @map("marked_at")

  @@unique([sessionId, studentId])
  @@index([schoolId, studentId])
  @@map("activity_attendances")
}

/// SKO-439: confidential clinic and safeguarding workspaces. Each domain has its own membership; clinic access
/// never grants safeguarding access. Nothing here is indexed by search, shown in student timelines or sent to AI.

model ConfidentialSetting {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId           String   @map("campus_id")
  domain             String // CLINIC | SAFEGUARDING
  enabled            Boolean  @default(false)
  procedureReference String?  @map("procedure_reference")
  leadUserId         String?  @map("lead_user_id")
  retentionMonths    Int?     @map("retention_months")
  confirmedById      String?  @map("confirmed_by_id")
  confirmedAt        DateTime? @map("confirmed_at")

  @@unique([campusId, domain])
  @@map("confidential_settings")
}

model ConfidentialMember {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String    @map("campus_id")
  domain      String // CLINIC | SAFEGUARDING
  userId      String    @map("user_id")
  role        String // NURSE | CLINIC_STAFF | LEAD | DEPUTY
  grantedById String    @map("granted_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  @@index([schoolId, userId, domain])
  @@map("confidential_members")
}

model EmergencyAccess {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String    @map("campus_id")
  domain       String
  userId       String    @map("user_id")
  studentId    String    @map("student_id")
  purpose      String
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id")
  reviewNote   String?   @map("review_note")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([schoolId, userId, studentId])
  @@map("emergency_accesses")
}

model ConfidentialAccessLog {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  domain     String
  recordType String   @map("record_type")
  recordId   String?  @map("record_id")
  studentId  String?  @map("student_id")
  actorId    String   @map("actor_id")
  action     String // VIEW | EXPORT | CREATE | UPDATE | DENIED
  emergencyAccessId String? @map("emergency_access_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolId, domain, createdAt])
  @@map("confidential_access_logs")
}

model ClinicVisit {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String   @map("campus_id")
  studentId   String   @map("student_id")
  arrivedAt   DateTime @map("arrived_at")
  observation String
  actionTaken String   @map("action_taken")
  outcome     String // RETURNED_TO_CLASS | SENT_HOME | EMERGENCY_SERVICES | STAYED_IN_CLINIC
  recordedById String  @map("recorded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([schoolId, studentId])
  @@map("clinic_visits")
}

model CarePlan {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String   @map("campus_id")
  studentId      String   @unique @map("student_id")
  allergies      String?
  actionPlan     String?  @map("action_plan")
  teacherSummary String?  @map("teacher_summary")
  updatedById    String   @map("updated_by_id")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("care_plans")
}

model MedicationInstruction {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId          String    @map("campus_id")
  studentId         String    @map("student_id")
  medicine          String
  dose              String
  schedule          String
  authorizedBy      String    @map("authorized_by")
  authorizationRef  String    @map("authorization_ref")
  validFrom         DateTime  @map("valid_from")
  validUntil        DateTime  @map("valid_until")
  approvedById      String    @map("approved_by_id")
  endedAt           DateTime? @map("ended_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  doses MedicationDose[]

  @@index([schoolId, studentId])
  @@map("medication_instructions")
}

model MedicationDose {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  instructionId String   @map("instruction_id")
  instruction   MedicationInstruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  studentId     String   @map("student_id")
  givenAt       DateTime @map("given_at")
  dose          String
  actorId       String   @map("actor_id")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([schoolId, studentId])
  @@map("medication_doses")
}

model SafeguardingConcern {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String    @map("campus_id")
  reference     String
  studentId     String    @map("student_id")
  source        String // STAFF_OBSERVATION | DISCLOSURE_BY_PUPIL | THIRD_PARTY | OTHER
  observation   String
  eventAt       DateTime  @map("event_at")
  reporterId    String    @map("reporter_id")
  ownerId       String?   @map("owner_id")
  status        String    @default("NEW") // NEW | TRIAGED | ESCALATED | CLOSED
  escalation    String?   // INTERNAL_REVIEW | EXTERNAL_REFERRAL
  implicatedGuardianIds String[] @default([]) @map("implicated_guardian_ids")
  version       Int       @default(1)
  idempotencyKey String   @map("idempotency_key")
  createdAt     DateTime  @default(now()) @map("created_at")
  closedAt      DateTime? @map("closed_at")

  entries     SafeguardingEntry[]
  disclosures SafeguardingDisclosure[]

  @@unique([schoolId, reference])
  @@unique([reporterId, idempotencyKey])
  @@index([schoolId, campusId, status])
  @@map("safeguarding_concerns")
}

model SafeguardingEntry {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  concernId String   @map("concern_id")
  concern   SafeguardingConcern @relation(fields: [concernId], references: [id], onDelete: Cascade)
  kind      String // CREATED | NOTE | OWNER | STATUS | ESCALATION | DISCLOSURE | CLOSED
  body      String?
  detail    Json     @default("{}")
  actorId   String   @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([schoolId, concernId])
  @@map("safeguarding_entries")
}

model SafeguardingDisclosure {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  concernId       String    @map("concern_id")
  concern         SafeguardingConcern @relation(fields: [concernId], references: [id], onDelete: Cascade)
  recipientType   String    @map("recipient_type") // GUARDIAN | STAFF | EXTERNAL_AGENCY
  recipientUserId String?   @map("recipient_user_id")
  recipientName   String    @map("recipient_name")
  purpose         String
  content         String
  contentHash     String    @map("content_hash")
  status          String    @default("PROPOSED") // PROPOSED | APPROVED | DECLINED | RELEASED
  proposedById    String    @map("proposed_by_id")
  reviewedById    String?   @map("reviewed_by_id")
  reviewedAt      DateTime? @map("reviewed_at")
  releasedAt      DateTime? @map("released_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([schoolId, concernId])
  @@map("safeguarding_disclosures")
}

/// SKO-437: dated trips with a frozen expected manifest. Route and fleet edits never rewrite a published trip;
/// changes after publication are recorded amendments. Observed events are separate from the plan.

model TransportStop {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routeId   String         @map("route_id")
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name      String
  sequence  Int
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")

  riders TransportRiderStop[]

  @@unique([routeId, name])
  @@index([schoolId])
  @@map("transport_stops")
}

model TransportRiderStop {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String        @unique @map("student_id")
  stopId    String        @map("stop_id")
  stop      TransportStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("transport_rider_stops")
}

model TransportTrip {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  routeId         String    @map("route_id")
  route           TransportRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)
  vehicleId       String    @map("vehicle_id")
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  serviceDate     String    @map("service_date") // YYYY-MM-DD in the campus timezone
  direction       String // AM | PM
  label           String
  routeTitle      String    @map("route_title")
  vehicleNumber   String    @map("vehicle_number")
  vehicleCapacity Int       @map("vehicle_capacity")
  driverName      String?   @map("driver_name")
  attendantId     String    @map("attendant_id")
  coordinatorId   String    @map("coordinator_id")
  status          String    @default("PUBLISHED") // PUBLISHED | DEPARTED | CLOSED | CLOSED_EMERGENCY
  version         Int       @default(1)
  publishedAt     DateTime  @default(now()) @map("published_at")
  departedAt      DateTime? @map("departed_at")
  vehicleCheckAt  DateTime? @map("vehicle_check_at")
  vehicleCheckById String?  @map("vehicle_check_by_id")
  vehicleCheckSignature String? @map("vehicle_check_signature")
  closedAt        DateTime? @map("closed_at")
  closedById      String?   @map("closed_by_id")
  emergencyReason String?   @map("emergency_reason")

  passengers TripPassenger[]
  events     TripEvent[]
  exceptions TripException[]

  @@unique([routeId, serviceDate, direction])
  @@index([schoolId, campusId, serviceDate])
  @@index([schoolId, attendantId, serviceDate])
  @@map("transport_trips")
}

model TripPassenger {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tripId        String        @map("trip_id")
  trip          TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  studentId     String        @map("student_id")
  studentName   String        @map("student_name")
  stopName      String?       @map("stop_name")
  source        String        @default("MANIFEST") // MANIFEST | AMENDMENT
  status        String        @default("EXPECTED") // EXPECTED | ABSENT | BOARDED | HANDED_OVER | REMOVED | TRANSFERRED
  boardedAt     DateTime?     @map("boarded_at")
  boardedById   String?       @map("boarded_by_id")
  handedOverAt  DateTime?     @map("handed_over_at")
  handedOverById String?      @map("handed_over_by_id")
  receiverType  String?       @map("receiver_type") // STAFF | GUARDIAN | AUTHORIZED_ADULT
  receiverName  String?       @map("receiver_name")
  receiverUserId String?      @map("receiver_user_id")
  note          String?
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([tripId, studentId])
  @@index([schoolId, studentId, status])
  @@map("trip_passengers")
}

model TripEvent {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tripId        String        @map("trip_id")
  trip          TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  studentId     String?       @map("student_id")
  kind          String
  occurredAt    DateTime      @map("occurred_at")
  recordedAt    DateTime      @default(now()) @map("recorded_at")
  actorId       String        @map("actor_id")
  clientEventId String?       @map("client_event_id")
  detail        Json          @default("{}")

  @@unique([tripId, clientEventId])
  @@index([schoolId, tripId])
  @@map("trip_events")
}

model TripException {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tripId       String        @map("trip_id")
  trip         TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  studentId    String?       @map("student_id")
  kind         String // UNLISTED_PASSENGER | CAPACITY_OVERFLOW | MISSING_CHILD | MISSING_RECIPIENT | DOUBLE_BOARDING | LATE_CHANGE
  note         String
  ownerId      String        @map("owner_id")
  status       String        @default("OPEN") // OPEN | RESOLVED
  resolution   String?
  createdById  String        @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  resolvedById String?       @map("resolved_by_id")
  resolvedAt   DateTime?     @map("resolved_at")

  @@index([schoolId, tripId, status])
  @@map("trip_exceptions")
}

/// SKO-443: school-group policy templates. Published versions never change; a campus's effective value is resolved
/// from the version in effect, then an approved, in-date override for a key the version leaves overridable.

model PolicyTemplate {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  domain       String // GRADING | CALENDAR
  title        String
  countries    String[] @default([])
  boards       String[] @default([])
  campusIds    String[] @default([]) @map("campus_ids")
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  versions  PolicyTemplateVersion[]
  overrides PolicyOverride[]

  @@index([schoolId, domain])
  @@map("policy_templates")
}

model PolicyTemplateVersion {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  templateId     String         @map("template_id")
  template       PolicyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version        Int
  status         String         @default("DRAFT") // DRAFT | IN_REVIEW | SCHEDULED | ACTIVE | SUPERSEDED | WITHDRAWN
  values         Json           @default("{}")
  lockedKeys     String[]       @default([]) @map("locked_keys")
  overridableKeys String[]      @default([]) @map("overridable_keys")
  effectiveFrom  DateTime?      @map("effective_from")
  previewHash    String?        @map("preview_hash")
  submittedById  String?        @map("submitted_by_id")
  reviewerId     String?        @map("reviewer_id")
  reviewedAt     DateTime?      @map("reviewed_at")
  activatedAt    DateTime?      @map("activated_at")
  note           String?
  createdById    String         @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  overrides PolicyOverride[]

  @@unique([templateId, version])
  @@index([schoolId, status])
  @@map("policy_template_versions")
}

model PolicyOverride {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String         @map("campus_id")
  templateId    String         @map("template_id")
  template      PolicyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  versionId     String         @map("version_id")
  version       PolicyTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  key           String
  value         Json
  reason        String
  status        String         @default("PENDING") // PENDING | APPROVED | DECLINED | EXPIRED | REVOKED
  requestedById String         @map("requested_by_id")
  approverId    String?        @map("approver_id")
  decidedAt     DateTime?      @map("decided_at")
  decisionNote  String?        @map("decision_note")
  validFrom     DateTime       @map("valid_from")
  validUntil    DateTime       @map("valid_until")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([schoolId, campusId, status])
  @@map("policy_overrides")
}

model PolicyEvent {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  templateId String?  @map("template_id")
  versionId  String?  @map("version_id")
  campusId   String?  @map("campus_id")
  kind       String
  actorId    String?  @map("actor_id")
  detail     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolId, templateId, createdAt])
  @@map("policy_events")
}

model PolicyProvenance {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String   @map("campus_id")
  domain     String
  recordType String   @map("record_type")
  recordId   String   @map("record_id")
  versionId  String?  @map("version_id")
  overrideIds String[] @default([]) @map("override_ids")
  effective  Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolId, recordType, recordId])
  @@map("policy_provenances")
}

/// SKO-444: a school's reviewed activation of a versioned country invoice package. Tax documents snapshot the exact
/// rules, identity and currency at issue; later configuration never rewrites them.

model TaxActivation {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  packageCode     String    @map("package_code")
  packageVersion  Int       @map("package_version")
  campusIds       String[]  @default([]) @map("campus_ids")
  legalName       String    @map("legal_name")
  taxId           String?   @map("tax_id")
  exemptFeeCodes  String[]  @default([]) @map("exempt_fee_codes")
  currency        String
  effectiveFrom   DateTime? @map("effective_from")
  ownerId         String?   @map("owner_id")
  evidenceReviewer String?  @map("evidence_reviewer")
  evidenceReference String? @map("evidence_reference")
  evidenceReviewedAt DateTime? @map("evidence_reviewed_at")
  configHash      String    @map("config_hash")
  status          String    @default("DRAFT") // DRAFT | SCHEDULED | ACTIVE | SUPERSEDED | WITHDRAWN
  preparedById    String    @map("prepared_by_id")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  numberSeq       Int       @default(0) @map("number_seq")
  createdAt       DateTime  @default(now()) @map("created_at")

  fixtureRuns TaxFixtureRun[]
  documents   TaxDocument[]

  @@index([schoolId, status])
  @@map("tax_activations")
}

model TaxFixtureRun {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activationId String        @map("activation_id")
  activation   TaxActivation @relation(fields: [activationId], references: [id], onDelete: Cascade)
  configHash   String        @map("config_hash")
  fixtures     Json
  results      Json
  passed       Boolean
  runById      String        @map("run_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([schoolId, activationId])
  @@map("tax_fixture_runs")
}

model TaxDocument {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId        String        @unique @map("invoice_id")
  activationId     String        @map("activation_id")
  activation       TaxActivation @relation(fields: [activationId], references: [id], onDelete: Restrict)
  campusId         String        @map("campus_id")
  packageCode      String        @map("package_code")
  packageVersion   Int           @map("package_version")
  documentNumber   String        @map("document_number")
  revision         Int           @default(1)
  snapshot         Json
  currency         String
  taxAmount        Int           @map("tax_amount")
  totalAmount      Int           @map("total_amount")
  issuedAt         DateTime      @map("issued_at")
  submissionStatus String        @default("NONE") @map("submission_status") // NONE | QUEUED | ACCEPTED | REJECTED | CORRECTED | NOT_SUPPORTED
  externalId       String?       @map("external_id")
  lastError        String?       @map("last_error")
  correctedById    String?       @map("corrected_by_id")
  correctionNote   String?       @map("correction_note")
  createdAt        DateTime      @default(now()) @map("created_at")

  attempts TaxSubmissionAttempt[]

  @@unique([schoolId, documentNumber])
  @@unique([schoolId, externalId])
  @@index([schoolId, submissionStatus])
  @@map("tax_documents")
}

model TaxSubmissionAttempt {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  documentId String      @map("document_id")
  document   TaxDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  attempt    Int
  revision   Int
  outcome    String // ACCEPTED | REJECTED | TIMEOUT | RECONCILED_ACCEPTED | RECONCILED_MISSING
  detail     String?
  actorId    String      @map("actor_id")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@unique([documentId, attempt])
  @@index([schoolId, documentId])
  @@map("tax_submission_attempts")
}

/// SKO-445: scoped service connections for the public v1 contract and signed outbound webhooks. A connection is not a
/// person: it never inherits its creator's privileges, only its campuses and scopes.

model IntegrationConnection {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String
  campusIds         String[]  @default([]) @map("campus_ids")
  scopes            String[]  @default([])
  contractVersion   String    @default("v1") @map("contract_version")
  status            String    @default("ACTIVE") // ACTIVE | PAUSED | REVOKED
  webhookUrl        String?   @map("webhook_url")
  topics            String[]  @default([])
  signingSecret     String?   @map("signing_secret") // encrypted
  previousSigningSecret String? @map("previous_signing_secret") // encrypted, valid until previousSecretUntil
  previousSecretUntil DateTime? @map("previous_secret_until")
  rateLimitPerMinute Int      @default(60) @map("rate_limit_per_minute")
  dailyQuota        Int       @default(10000) @map("daily_quota")
  createdById       String    @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  revokedAt         DateTime? @map("revoked_at")

  credentials IntegrationCredential[]
  deliveries  IntegrationDelivery[]
  commands    IntegrationCommand[]

  @@index([schoolId, status])
  @@map("integration_connections")
}

model IntegrationCredential {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  connectionId String                @map("connection_id")
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  keyId        String                @unique @map("key_id")
  secretHash   String                @map("secret_hash")
  status       String                @default("ACTIVE") // ACTIVE | REVOKED
  expiresAt    DateTime?             @map("expires_at")
  lastUsedAt   DateTime?             @map("last_used_at")
  createdById  String                @map("created_by_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  revokedAt    DateTime?             @map("revoked_at")

  @@index([schoolId, connectionId])
  @@map("integration_credentials")
}

model IntegrationEvent {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  topic       String
  campusId    String   @map("campus_id")
  resourceId  String   @map("resource_id")
  payload     Json
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  deliveries IntegrationDelivery[]

  @@index([schoolId, topic, occurredAt])
  @@map("integration_events")
}

model IntegrationDelivery {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  connectionId  String                @map("connection_id")
  connection    IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  eventId       String                @map("event_id")
  event         IntegrationEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status        String                @default("PENDING") // PENDING | DELIVERING | DELIVERED | FAILED | BLOCKED | PAUSED
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now()) @map("next_attempt_at")
  lastStatusCode Int?                 @map("last_status_code")
  lastError     String?               @map("last_error")
  deliveredAt   DateTime?             @map("delivered_at")
  replayCount   Int                   @default(0) @map("replay_count")
  leaseUntil    DateTime?             @map("lease_until")
  createdAt     DateTime              @default(now()) @map("created_at")

  attemptLog IntegrationDeliveryAttempt[]

  @@unique([connectionId, eventId])
  @@index([schoolId, status, nextAttemptAt])
  @@map("integration_deliveries")
}

model IntegrationDeliveryAttempt {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  deliveryId    String              @map("delivery_id")
  delivery      IntegrationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attempt       Int
  replay        Int                 @default(0)
  url           String
  resolvedAddress String?           @map("resolved_address")
  statusCode    Int?                @map("status_code")
  outcome       String // DELIVERED | HTTP_ERROR | TIMEOUT | BLOCKED_DESTINATION | REDIRECT_REFUSED | NETWORK_ERROR | RATE_LIMITED
  error         String?
  durationMs    Int?                @map("duration_ms")
  signedWith    Int                 @default(1) @map("signed_with")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([schoolId, deliveryId])
  @@map("integration_delivery_attempts")
}

model IntegrationCommand {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  connectionId   String                @map("connection_id")
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  idempotencyKey String                @map("idempotency_key")
  requestHash    String                @map("request_hash")
  statusCode     Int                   @map("status_code")
  response       Json
  createdAt      DateTime              @default(now()) @map("created_at")

  @@unique([connectionId, idempotencyKey])
  @@map("integration_commands")
}

model IntegrationRequestLog {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  connectionId String   @map("connection_id")
  method       String
  path         String
  statusCode   Int      @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([schoolId, connectionId, createdAt])
  @@map("integration_request_logs")
}

model IntegrationExternalRef {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  connectionId String   @map("connection_id")
  studentId    String   @map("student_id")
  system       String
  externalId   String   @map("external_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([connectionId, studentId, system])
  @@map("integration_external_refs")
}

/// SKO-446: school identity (OIDC) and roster exchange. Provider subjects and roster ids are namespaced by connection;
/// names or emails alone never merge people. Local password sign-in stays available for recovery.

model IdentityConnection {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name            String
  protocol        String    @default("OIDC")
  issuer          String
  clientId        String    @map("client_id")
  clientSecret    String?   @map("client_secret") // encrypted
  discovery       Json?
  verifiedDomains String[]  @default([]) @map("verified_domains")
  pendingDomains  Json      @default("[]") @map("pending_domains")
  roleClaim       String    @default("groups") @map("role_claim")
  roleMap         Json      @default("{}") @map("role_map")
  fieldOwnership  Json      @default("{}") @map("field_ownership")
  status          String    @default("DRAFT") // DRAFT | TESTED | ENABLED | DISABLED
  lastTestedAt    DateTime? @map("last_tested_at")
  lastTestResult  String?   @map("last_test_result")
  emergencyAdminIds String[] @default([]) @map("emergency_admin_ids")
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  links    IdentityLink[]
  requests IdentityLinkRequest[]
  batches  RosterBatch[]

  @@index([schoolId, status])
  @@map("identity_connections")
}

model IdentityLink {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  connectionId String             @map("connection_id")
  connection   IdentityConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  subject      String
  userId       String             @map("user_id")
  method       String // VERIFIED_EMAIL | ADMIN_DECISION
  linkedById   String?            @map("linked_by_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  lastSignInAt DateTime?          @map("last_sign_in_at")

  @@unique([connectionId, subject])
  @@unique([connectionId, userId])
  @@map("identity_links")
}

model IdentityLinkRequest {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  connectionId     String             @map("connection_id")
  connection       IdentityConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  subject          String
  email            String?
  emailVerified    Boolean            @default(false) @map("email_verified")
  name             String?
  reason           String
  candidateUserIds String[]           @default([]) @map("candidate_user_ids")
  status           String             @default("PENDING") // PENDING | LINKED | REJECTED
  decidedById      String?            @map("decided_by_id")
  decidedAt        DateTime?          @map("decided_at")
  createdAt        DateTime           @default(now()) @map("created_at")

  @@unique([connectionId, subject])
  @@map("identity_link_requests")
}

model IdentityEvent {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  connectionId String?  @map("connection_id")
  kind         String
  actorId      String?  @map("actor_id")
  detail       Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@map("identity_events")
}

model RosterBatch {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  connectionId    String             @map("connection_id")
  connection      IdentityConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  campusId        String             @map("campus_id")
  externalBatchId String             @map("external_batch_id")
  payloadHash     String             @map("payload_hash")
  rows            Json
  preview         Json?
  previewHash     String?            @map("preview_hash")
  status          String             @default("DRY_RUN") // DRY_RUN | APPLIED
  result          Json?
  submittedById   String             @map("submitted_by_id")
  appliedById     String?            @map("applied_by_id")
  appliedAt       DateTime?          @map("applied_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  @@unique([connectionId, externalBatchId])
  @@map("roster_batches")
}

model RosterExternalId {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  connectionId String   @map("connection_id")
  kind         String // STUDENT | STAFF
  externalId   String   @map("external_id")
  localId      String   @map("local_id")
  synced       Json     @default("{}")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([connectionId, kind, externalId])
  @@unique([connectionId, kind, localId])
  @@map("roster_external_ids")
}

/// SKO-448: one row per operation captured offline. The client's operation id makes sync idempotent; the base version and
/// the server value seen at sync are kept side by side, so a conflict never loses either observation.
model OfflineOperation {
  id           String    @id @default(uuid())
  schoolId     String    @default("") @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  operationId  String    @map("operation_id")
  userId       String    @map("user_id")
  deviceId     String    @map("device_id")
  kind         String // ATTENDANCE_MARK
  classId      String    @map("class_id")
  date         String
  studentId    String    @map("student_id")
  capturedAt   DateTime  @map("captured_at")
  baseStatus   String?   @map("base_status")
  baseVersion  Int?      @map("base_version")
  payload      Json
  status       String // ACCEPTED | CONFLICT | REJECTED_ACCESS | EXPIRED | RESOLVED_SERVER | RESOLVED_LOCAL | CORRECTION_REQUESTED | DISCARDED
  serverValue  Json?     @map("server_value")
  message      String?
  attendanceId String?   @map("attendance_id")
  resolvedById String?   @map("resolved_by_id")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([schoolId, operationId])
  @@index([schoolId, userId, status])
  @@index([schoolId, status, createdAt])
  @@map("offline_operations")
}

// ─── 16. SECURITY & ONBOARDING ────────────────────────────
model PendingRegistration {
  id               String   @id @default(uuid())
  email            String   @unique
  registrationType String   @map("registration_type") // school_group or single_campus
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

model StaffInvitation {
  canPurchaseSubscription Boolean @default(false) @map("can_purchase_subscription")
  canManageMemberships Boolean @default(false) @map("can_manage_memberships")
  invitedBy String? @map("invited_by")
  deliveryStatus String @default("unknown") @map("delivery_status")
  lastDeliveryAt DateTime? @map("last_delivery_at")
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email     String
  role      UserRole
  campusId  String   @map("campus_id")
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  status    String   @default("pending") // pending, accepted
  profile   Json? // captured at invite time (fullName, phone, qualification, etc.)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([schoolId])
  @@map("staff_invitations")
}

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  campusId  String?  @map("campus_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  retentionUntil DateTime? @map("retention_until")

  @@index([schoolId])
  @@index([schoolId, campusId, createdAt(sort: Desc)])
  @@index([schoolId, retentionUntil], map: "audit_logs_retention_idx")
  @@map("audit_logs")
}

// ─── 16b. PLATFORM CONFIG (Owner settings) ────────────────
model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("platform_config")
}

// ─── 17. SUPER ADMIN SECURITY ────────────────────────────

model SuperAdminAuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id") // nullable: the log outlives the actor
  user         User?    @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  action       String // login, logout, suspend_school, modify_school, password_change, view_dashboard, create_campus, delete_campus, etc.
  targetType   String?  @map("target_type") // school, campus, user, subscription
  targetId     String?  @map("target_id")
  targetName   String?  @map("target_name")
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent") @db.Text
  status       String   @default("success") // success, failed, attempted
  errorMessage String?  @map("error_message") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("super_admin_audit_logs")
}

// A support incident is the school-approved reason for bounded vendor support.
// Actor IDs are immutable audit identities and intentionally have no User FK.
model SupportIncident {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reference        String   @unique
  purpose          String   @db.Text
  impact           String   @db.Text
  status           String   @default("open")
  ownerActorId     String   @map("owner_actor_id")
  closureEvidence String?  @map("closure_evidence") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  closedAt         DateTime? @map("closed_at")
  grants           SupportGrant[]

  @@index([schoolId, status, updatedAt])
  @@map("support_incidents")
}

model SupportGrant {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  incidentId      String   @map("incident_id")
  incident        SupportIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  requestedById   String   @map("requested_by_id")
  approvedById    String?  @map("approved_by_id")
  purpose         String   @db.Text
  scope           String[]
  actions         String[] @default(["read"])
  status          String   @default("pending")
  expiresAt       DateTime @map("expires_at")
  startedAt       DateTime? @map("started_at")
  revokedAt       DateTime? @map("revoked_at")
  emergencyReason String?  @map("emergency_reason") @db.Text
  reviewDueAt     DateTime? @map("review_due_at")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewEvidence  String?  @map("review_evidence") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  queuedActions   SupportAction[]

  @@index([schoolId, status, expiresAt])
  @@index([incidentId])
  @@map("support_grants")
}

model SupportAction {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grantId   String   @map("grant_id")
  grant     SupportGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id")
  domain    String
  action    String
  status    String   @default("queued")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([grantId, status])
  @@index([schoolId])
  @@map("support_actions")
}

model LoginSession {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId         String    @map("user_id")
  // Sessions are meaningless without their user, and blocked user deletion.
  user           User      @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @map("token_hash")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent") @db.Text
  loginAt        DateTime  @default(now()) @map("login_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  expiresAt      DateTime  @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
