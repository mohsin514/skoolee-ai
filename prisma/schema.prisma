  @@map("learning_resource_versions")
}

/// SKO-406: a reviewed decision that an objective in one curriculum version is the same as,
/// partly overlaps or is not equivalent to an objective in another. Matching titles or codes
/// never merge objectives; only these decisions relate them. Rows are append-only: the latest
/// decision for a pair is current, earlier ones remain as history.
model CurriculumObjectiveMapping {
  id            String   @id @default(uuid())
  schoolId      String   @default("") @map("school_id")
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String   @map("campus_id")
  fromRecordId  String   @map("from_record_id")
  fromVersion   Int      @map("from_version")
  fromOutcomeId String   @map("from_outcome_id")
  toRecordId    String   @map("to_record_id")
  toVersion     Int      @map("to_version")
  toOutcomeId   String   @map("to_outcome_id")
  relation      String   // SAME | PARTIAL | NOT_EQUIVALENT
  note          String   @default("")
  decidedById   String   @map("decided_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([schoolId, fromRecordId, fromVersion])
  @@index([schoolId, toRecordId, toVersion])
  @@map("curriculum_objective_mappings")
}

/// SKO-409: a teacher's assignment. The row holds the editable draft; every release freezes
/// instructions, rubric, audience and deadline into an immutable AssignmentVersion.
model Assignment {
  id              String    @id @default(uuid())
  schoolId        String    @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  classId         String    @map("class_id")
  subjectId       String?   @map("subject_id")
  title           String
  instructions    String    @default("")
  status          String    @default("DRAFT") // DRAFT | RELEASED | CLOSED
  submissionMode  String    @default("ONLINE") @map("submission_mode") // ONLINE | PAPER | BOTH
  allowedTypes    String[]  @default([]) @map("allowed_types")
  opensLocal      String?   @map("opens_local")
  dueLocal        String?   @map("due_local")
  latePolicy      String    @default("ACCEPT_FLAGGED") @map("late_policy") // ACCEPT_FLAGGED | REFUSE
  resubmission    String    @default("AFTER_RETURN") // NEVER | AFTER_RETURN
  rubric          Json      @default("[]")
  objectives      Json?
  resourceIds     String[]  @default([]) @map("resource_ids")
  // SKO-414: a temporary lesson group; empty means the whole class. Each release freezes its audience.
  audienceStudentIds String[] @default([]) @map("audience_student_ids")
  externalRef     String?   @map("external_ref")
  ownerId         String    @map("owner_id")
  currentVersion  Int?      @map("current_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  rubricVersions  AssignmentRubricVersion[]
  versions        AssignmentVersion[]
  extensions      AssignmentExtension[]
  submissions     AssignmentSubmission[]

  @@unique([schoolId, externalRef])
  @@index([schoolId, classId, status])
  @@map("assignments")
}

/// Immutable rubric snapshot; feedback always scores against the version a submission was made under.
model AssignmentRubricVersion {
  id           String     @id @default(uuid())
  schoolId     String     @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentId String     @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_rubric_versions_assignment_fkey")
  version      Int
  criteria     Json
  totalPoints  Int        @map("total_points")
  createdById  String     @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([assignmentId, version])
  @@map("assignment_rubric_versions")
}

/// Immutable release: what learners were given, who they were and when it was due.
model AssignmentVersion {
  id               String     @id @default(uuid())
  schoolId         String     @map("school_id")
  school           School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentId     String     @map("assignment_id")
  assignment       Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_versions_assignment_fkey")
  version          Int
  title            String
  instructions     String
  rubricVersion    Int        @map("rubric_version")
  audience         String[]
  submissionMode   String     @map("submission_mode")
  allowedTypes     String[]   @map("allowed_types")
  timezone         String
  opensAt          DateTime   @map("opens_at")
  dueAt            DateTime   @map("due_at")
  dueLocal         String     @map("due_local")
  latePolicy       String     @map("late_policy")
  resubmission     String
  objectives       Json?
  resourceIds      String[]   @map("resource_ids")
  releasedById     String     @map("released_by_id")
  releasedAt       DateTime   @default(now()) @map("released_at")

  @@unique([assignmentId, version])
  @@map("assignment_versions")
}

/// An approved individual extension. Append-only: the latest row for a learner is in force.
model AssignmentExtension {
  id           String     @id @default(uuid())
  schoolId     String     @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentId String     @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_extensions_assignment_fkey")
  studentId    String     @map("student_id")
  dueAt        DateTime   @map("due_at")
  dueLocal     String     @map("due_local")
  timezone     String
  reason       String
  grantedById  String     @map("granted_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([schoolId, assignmentId, studentId])
  @@map("assignment_extensions")
}

/// One learner's work on one assignment: the resumable draft plus its workflow status.
model AssignmentSubmission {
  id                 String     @id @default(uuid())
  schoolId           String     @map("school_id")
  school             School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentId       String     @map("assignment_id")
  assignment         Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_submissions_assignment_fkey")
  studentId          String     @map("student_id")
  status             String     @default("DRAFT") // DRAFT | SUBMITTED | RETURNED | REOPENED
  draftText          String     @default("") @map("draft_text")
  draftStorageKey    String?    @map("draft_storage_key")
  draftFileName      String?    @map("draft_file_name")
  draftContentType   String?    @map("draft_content_type")
  draftSizeBytes     Int?       @map("draft_size_bytes")
  draftSha256        String?    @map("draft_sha256")
  draftUploadedAt    DateTime?  @map("draft_uploaded_at")
  draftSavedAt       DateTime?  @map("draft_saved_at")
  latestVersion      Int        @default(0) @map("latest_version")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  versions           AssignmentSubmissionVersion[]

  @@unique([assignmentId, studentId])
  @@index([schoolId, studentId])
  @@map("assignment_submissions")
}

/// The server receipt for one submitted version. Immutable; earlier versions are always kept.
model AssignmentSubmissionVersion {
  id                String               @id @default(uuid())
  schoolId          String               @map("school_id")
  school            School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submissionId      String               @map("submission_id")
  submission        AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_submission_versions_submission_fkey")
  assignmentId      String               @map("assignment_id")
  studentId         String               @map("student_id")
  version           Int
  assignmentVersion Int                  @map("assignment_version")
  rubricVersion     Int                  @map("rubric_version")
  mode              String               // ONLINE | PAPER
  idempotencyKey    String               @map("idempotency_key")
  receiptCode       String               @map("receipt_code")
  text              String               @default("")
  storageKey        String?              @map("storage_key")
  fileName          String?              @map("file_name")
  contentType       String?              @map("content_type")
  sizeBytes         Int?                 @map("size_bytes")
  fileSha256        String?              @map("file_sha256")
  artifactSha256    String               @map("artifact_sha256")
  submittedAt       DateTime             @default(now()) @map("submitted_at")
  receivedAt        DateTime             @map("received_at")
  effectiveDueAt    DateTime             @map("effective_due_at")
  late              Boolean
  draftSavedAt      DateTime?            @map("draft_saved_at")
  recordedById      String               @map("recorded_by_id")

  feedback          AssignmentFeedback?

  @@unique([submissionId, version])
  @@unique([submissionId, idempotencyKey])
  @@unique([schoolId, receiptCode])
  @@map("assignment_submission_versions")
}

/// Formative, criterion-level feedback on one submitted version. Hidden from learners and
/// families until RETURNED; then immutable. A gradebook transfer is only ever a request here.
model AssignmentFeedback {
  id                  String                      @id @default(uuid())
  schoolId            String                      @map("school_id")
  school              School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submissionVersionId String                      @unique @map("submission_version_id")
  submissionVersion   AssignmentSubmissionVersion @relation(fields: [submissionVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_feedback_submission_version_fkey")
  rubricVersion       Int                         @map("rubric_version")
  criteria            Json
  comment             String                      @default("")
  totalPoints         Int?                        @map("total_points")
  status              String                      @default("DRAFT") // DRAFT | RETURNED
  gradebookTransfer   String                      @default("NOT_REQUESTED") @map("gradebook_transfer") // NOT_REQUESTED | REQUESTED (never applied here)
  markerId            String                      @map("marker_id")
  returnedAt          DateTime?                   @map("returned_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  @@map("assignment_feedback")
}

/// SKO-410: a learner's approved, time-bounded assessment access plan. Each revision is a new row;
/// only operational adjustments live here. Diagnosis or private context never belongs in `instructions`.
model AccommodationPlan {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  studentId       String    @map("student_id")
  version         Int
  status          String    @default("ACTIVE") // ACTIVE | SUPERSEDED | REVOKED
  validFrom       DateTime  @map("valid_from") @db.Date
  validUntil      DateTime  @map("valid_until") @db.Date
  assessmentTypes String[]  @map("assessment_types")
  extraMinutes    Int       @default(0) @map("extra_minutes")
  extraPercent    Int       @default(0) @map("extra_percent")
  breakMinutes    Int       @default(0) @map("break_minutes")
  capabilities    Json
  instructions    String    @default("")
  approvedById    String    @map("approved_by_id")
  approvedAt      DateTime  @default(now()) @map("approved_at")
  endedAt         DateTime? @map("ended_at")
  endedById       String?   @map("ended_by_id")
  endReason       String?   @map("end_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  supportRecords  AccommodationSupportRecord[]
  rehearsals      AccommodationRehearsal[]

  @@unique([schoolId, studentId, version])
  @@index([schoolId, campusId, status])
  @@map("accommodation_plans")
}

/// Confidential supporting context, readable only by designated approvers.
model AccommodationSupportRecord {
  id          String            @id @default(uuid())
  schoolId    String            @default("") @map("school_id")
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId      String            @map("plan_id")
  plan        AccommodationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  note        String
  createdById String            @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([schoolId, planId])
  @@map("accommodation_support_records")
}

/// A learner's practice check of the exact accessible mode before a formal attempt.
model AccommodationRehearsal {
  id          String            @id @default(uuid())
  schoolId    String            @default("") @map("school_id")
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId      String            @map("plan_id")
  plan        AccommodationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  studentId   String            @map("student_id")
  settings    Json
  completedAt DateTime          @default(now()) @map("completed_at")

  @@index([schoolId, studentId])
  @@map("accommodation_rehearsals")
}

/// An exceptional adjustment to a running attempt, with approver, reason and old/new deadline.
model AccommodationLiveAdjustment {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  assignmentId String   @map("assignment_id")
  attemptId    String   @map("attempt_id")
  studentId    String   @map("student_id")
  addedMinutes Int      @map("added_minutes")
  reason       String
  oldDeadline  DateTime @map("old_deadline")
  newDeadline  DateTime @map("new_deadline")
  approvedById String   @map("approved_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([schoolId, assignmentId])
  @@map("accommodation_live_adjustments")
}

/// SKO-449: a tested Safe Exam Browser delivery profile. Revisions are immutable rows; keys are the
/// Config Keys and Browser Exam Keys reported by the tested client, never derived from a user agent.
model SecureBrowserProfile {
  id               String    @id @default(uuid())
  schoolId         String    @default("") @map("school_id")
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId         String    @map("campus_id")
  profileKey       String    @map("profile_key")
  version          Int
  name             String
  status           String    @default("DRAFT") // DRAFT | APPROVED | RETIRED
  minClientVersion String    @map("min_client_version")
  configKeys       String[]  @map("config_keys")
  browserExamKeys  String[]  @map("browser_exam_keys")
  allowedResources String[]  @map("allowed_resources")
  testedDevices    Json      @map("tested_devices")
  createdById      String    @map("created_by_id")
  approvedById     String?   @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([schoolId, profileKey, version])
  @@index([schoolId, campusId, status])
  @@map("secure_browser_profiles")
}

/// An audited, per-learner supervised alternative for a SECURE_BROWSER exam (e.g. unsupported device or assistive tool).
model SecureBrowserException {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  assignmentId String   @map("assignment_id")
  studentId    String   @map("student_id")
  reason       String
  approvedById String   @map("approved_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([assignmentId, studentId])
  @@index([schoolId, assignmentId])
  @@map("secure_browser_exceptions")
}


/// SKO-408: a staff rehearsal of one exact paper version. Results are BLOCKING or ADVISORY; a blocking
/// result stands until a new paper version is rehearsed clean. Rows are append-only evidence.
model SchoolAiRehearsal {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  recordId     String   @map("record_id")
  paperVersion Int      @map("paper_version")
  results      Json
  blocking     Int      @default(0)
  actorId      String   @map("actor_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([schoolId, recordId, paperVersion])
  @@map("school_ai_rehearsals")
}

/// SKO-408 R17: an authorized, versioned notice to the candidates sitting an exam. The paper itself never changes.
model SchoolAiExamClarification {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  assignmentId String   @map("assignment_id")
  /// Per-exam sequence; a revision is a new row that names the notice it revises.
  version      Int
  revisesId    String?  @map("revises_id")
  questionId   String?  @map("question_id")
  text         String   @db.Text
  /// { kind: "SITTING" } or { kind: "ATTEMPTS", attemptIds: string[] }
  audience     Json
  issuedById   String   @map("issued_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([assignmentId, version])
  @@index([schoolId, campusId, assignmentId])
  @@map("school_ai_exam_clarifications")
}

/// SKO-462: effective-dated teaching assignments. A teacher change closes the open row and opens a new
/// one, so who taught a class or subject on any date stays answerable after the assignment changes.
model TeachingAssignment {
  id            String    @id @default(uuid())
  schoolId      String    @default("") @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String    @map("campus_id")
  classId       String    @map("class_id")
  /// Null for the class-teacher role.
  subjectId     String?   @map("subject_id")
  role          String
  teacherId     String?   @map("teacher_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([schoolId, campusId, classId])
  @@index([subjectId])
  @@map("teaching_assignments")
}

/// SKO-408 R15.4: a supervised pause of one attempt, its reason, who paused and resumed it, and the time restored.
model SchoolAiExamPause {
  id           String    @id @default(uuid())
  schoolId     String    @default("") @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String    @map("campus_id")
  assignmentId String    @map("assignment_id")
  attemptId    String    @map("attempt_id")
  reason       String
  startedById  String    @map("started_by_id")
  startedAt    DateTime  @default(now()) @map("started_at")
  endedById    String?   @map("ended_by_id")
  endedAt      DateTime? @map("ended_at")
  restoredMs   Int?      @map("restored_ms")

  @@index([schoolId, campusId, assignmentId])
  @@index([attemptId])
  @@map("school_ai_exam_pauses")
}

/// SKO-408 R17.2: one display acknowledgement per notice per attempt.
model SchoolAiExamClarificationAck {
  id              String   @id @default(uuid())
  schoolId        String   @default("") @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String   @map("campus_id")
  clarificationId String   @map("clarification_id")
  attemptId       String   @map("attempt_id")
  acknowledgedAt  DateTime @default(now()) @map("acknowledged_at")

  @@unique([clarificationId, attemptId])
  @@index([schoolId, campusId, attemptId])
  @@map("school_ai_exam_clarification_acks")
}

/// SKO-408 R17.7-R17.12: a previewed, human-authorized result remedy for one item of a delivered exam.
model SchoolAiExamRemedy {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String    @map("campus_id")
  assignmentId   String    @map("assignment_id")
  type           String
  questionId     String    @map("question_id")
  reason         String    @db.Text
  /// The correction the remedy applies (a corrected key), when the type needs one.
  correction     Json?
  /// Per attempt: result version, previous, proposed and delta, computed at preview.
  preview        Json
  notify         Boolean   @default(true)
  status         String    @default("PROPOSED")
  proposedById   String    @map("proposed_by_id")
  authorizedById String?   @map("authorized_by_id")
  appliedAt      DateTime? @map("applied_at")
  /// Per attempt: APPLIED (with the new result version), SKIPPED_CHANGED or FAILED.
  outcomes       Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([schoolId, campusId, assignmentId])
  @@map("school_ai_exam_remedies")
}

/// SKO-408 R19: a frozen evidence pack — the files and Integrity_Manifest exactly as produced, so
/// every later download serves the same bytes the manifest digests. Append-only apart from
/// `downloadedAt`; production and each download are also written to the audit log.
model SchoolAiEvidencePack {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  assignmentId    String    @map("assignment_id")
  scopeKind       String    @map("scope_kind")
  scopeId         String    @map("scope_id")
  manifest        Json
  files           Json
  includedKeys    Boolean   @default(false) @map("included_keys")
  includedCapture Boolean   @default(false) @map("included_capture")
  captureReason   String?   @map("capture_reason")
  requestedById   String    @map("requested_by_id")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  downloadedAt    DateTime? @map("downloaded_at")

  @@index([schoolId, campusId, assignmentId, requestedAt])
  @@map("school_ai_evidence_packs")
}

/// SKO-408 R9.6, R9.7: a model observation over two language versions of one item. The proposal
/// carries no item edit; it waits for one recorded human decision, which is then frozen.
model SchoolAiLanguageProposal {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String    @map("campus_id")
  formSetId      String    @map("form_set_id")
  recordId       String    @map("record_id")
  recordVersion  Int       @map("record_version")
  itemGroupId    String    @map("item_group_id")
  finding        String
  proposal       Json
  decisionOutcome String?  @map("decision_outcome")
  decisionReason String?   @map("decision_reason")
  decidedById    String?   @map("decided_by_id")
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([schoolId, formSetId, recordId, recordVersion])
  @@map("school_ai_language_proposals")
}

// ─── SKO-404: year-end rollover plans ──────────────────────
// One reviewed plan per campus and source year. Every eligible learner has one
// decision row; missing evidence is NEEDS_REVIEW, never pass or fail. Approval
// binds to an exact version; execution is bounded, resumable and revalidates.
model RolloverPlan {
  id                 String    @id @default(uuid())
  schoolId           String    @default("") @map("school_id")
  campusId           String    @map("campus_id")
  sourceYear         Int       @map("source_year")
  destinationYear    Int       @map("destination_year")
  version            Int       @default(1)
  status             String    @default("DRAFT") // DRAFT, APPROVED, EXECUTING, PAUSED, EXCEPTIONS, COMPLETED
  effectiveDate      DateTime  @db.Date @map("effective_date")
  classMap           Json      @default("{}") @map("class_map")
  approvedVersion    Int?      @map("approved_version")
  approvedById       String?   @map("approved_by_id")
  approvedAt         DateTime? @map("approved_at")
  baseline           Json?
  leaseUntil         DateTime? @map("lease_until")
  notifiedAt         DateTime? @map("notified_at")
  createdById        String    @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([campusId, sourceYear])
  @@index([schoolId])
  @@map("rollover_plans")
}

model RolloverDecision {
  id                 String    @id @default(uuid())
  schoolId           String    @default("") @map("school_id")
  planId             String    @map("plan_id")
  studentId          String    @map("student_id")
  sourceClassId      String    @map("source_class_id")
  sourceEnrollmentId String    @map("source_enrollment_id")
  sourceRollNo       String    @map("source_roll_no")
  evidence           String    // PASSED, FAILED, MISSING
  evidenceDetail     Json?     @map("evidence_detail")
  decision           String    // PROMOTE, RETAIN, GRADUATE, TRANSFER_OUT, NEEDS_REVIEW
  destinationClassId String?   @map("destination_class_id")
  reason             String?
  reviewedById       String?   @map("reviewed_by_id")
  reviewedAt         DateTime? @map("reviewed_at")
  executionStatus    String    @default("PENDING") @map("execution_status") // PENDING, DONE, BLOCKED, REVERSED
  executionNote      String?   @map("execution_note")
  newEnrollmentId    String?   @map("new_enrollment_id")
  newRollNo          String?   @map("new_roll_no")
  executedAt         DateTime? @map("executed_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([planId, studentId])
  @@index([planId, executionStatus])
  @@index([schoolId])
  @@map("rollover_decisions")
}

model RolloverEvent {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  planId    String   @map("plan_id")
  version   Int
  kind      String
  actorId   String   @map("actor_id")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([planId, createdAt])
  @@index([schoolId])
  @@map("rollover_events")
}

// ─── SKO-413: published exam datesheet versions ─────────────
// A session's datesheet and seating are drafts until an officer publishes a
// version, after every hard check passes. Families read only the published
// snapshot; a later change is a new reviewed version with its diff and the
// exact people it affects, and documents print the version they show.
model ExamDatesheetVersion {
  id            String   @id @default(uuid())
  schoolId      String   @default("") @map("school_id")
  campusId      String   @map("campus_id")
  sessionId     String   @map("session_id")
  version       Int
  snapshot      Json
  seatingHash   String   @map("seating_hash")
  changes       Json?
  affected      Json?
  reason        String?  @db.Text
  publishedById String   @map("published_by_id")
  publishedAt   DateTime @default(now()) @map("published_at")

  @@unique([sessionId, version])
  @@index([schoolId])
  @@map("exam_datesheet_versions")
}

// ─── SKO-461: teaching evidence follow-up ───────────────────
// Append-only notes beside the evidence view: a leader's reviewed support
// action or the teacher's own response. Never an employment decision, which
// is recorded outside analytics by an authorized person.
model TeacherSupportNote {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  campusId     String   @map("campus_id")
  teacherId    String   @map("teacher_id")
  authorId     String   @map("author_id")
  academicYear Int      @map("academic_year")
  kind         String   // SUPPORT_ACTION, TEACHER_RESPONSE
  body         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([teacherId, academicYear])
  @@index([schoolId])
  @@map("teacher_support_notes")
}

// ─── SKO-414: lesson-plan working state ─────────────────────
// Per plan (inside a curriculum record): temporary private groups, what
// happened when it was taught, and the assignment drafts made from it.
// Kept apart from the curriculum so recording a lesson never reopens an
// approved curriculum; every change is versioned in LessonPlanEvent.
model LessonPlanState {
  id                  String   @id @default(uuid())
  schoolId            String   @default("") @map("school_id")
  campusId            String   @map("campus_id")
  curriculumId        String   @map("curriculum_id")
  planId              String   @map("plan_id")
  groups              Json     @default("[]")
  delivery            Json?
  publishedActivities Json     @default("[]") @map("published_activities")
  version             Int      @default(1)
  updatedById         String   @map("updated_by_id")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([curriculumId, planId])
  @@index([schoolId])
  @@map("lesson_plan_states")
}

model LessonPlanEvent {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  stateId   String   @map("state_id")
  version   Int
  kind      String
  actorId   String   @map("actor_id")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([stateId, createdAt])
  @@index([schoolId])
  @@map("lesson_plan_events")
}
