// Reference-only durable orchestration ledger. Sensitive content stays in domain tables.
model WorkflowEvent {
  id String @id
  schoolId String @map("school_id")
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind String
  version Int @default(1)
  referenceId String @map("reference_id")
  actorId String @map("actor_id")
  identity String
  createdAt DateTime @default(now()) @map("created_at")
  availableAt DateTime @default(now()) @map("available_at")
  leaseToken String? @map("lease_token")
  leaseUntil DateTime? @map("lease_until")
  dispatchCount Int @default(0) @map("dispatch_count")
  dispatchedAt DateTime? @map("dispatched_at")
  job WorkflowJob?
  @@unique([schoolId, identity])
  @@unique([id, schoolId])
  @@index([availableAt, leaseUntil])
  @@map("workflow_events")
}

model WorkflowJob {
  id String @id
  schoolId String @map("school_id")
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  event WorkflowEvent @relation(fields: [id, schoolId], references: [id, schoolId], onDelete: Cascade)
  state String @default("queued")
  attempts Int @default(0)
  maxAttempts Int @default(5) @map("max_attempts")
  checkpoint Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  reason String?
  leaseToken String? @map("lease_token")
  leaseUntil DateTime? @map("lease_until")
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  supportGrantId String? @map("support_grant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  startedAt DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  effects WorkflowEffect[]
  activityItems ActivityItem[]
  @@unique([id, schoolId])
  @@index([state, leaseUntil])
  @@index([supportGrantId, state])
  @@map("workflow_jobs")
}

model WorkflowEffect {
  id String @id
  schoolId String @map("school_id")
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  jobId String @map("job_id")
  job WorkflowJob @relation(fields: [jobId, schoolId], references: [id, schoolId], onDelete: Cascade)
  identity String
  // committed = atomic database effect; uncertain = external call may have happened.
  state String
  createdAt DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  @@unique([jobId, identity])
  @@map("workflow_effects")
}

// Durable owner setup state (SKO-391). One row per institution, so progress
// survives refresh, sign-out, another device and an authorised handover.
// Campus drafts stay here until completion creates real campuses inside one
// transaction; over-limit drafts remain here after completion.
model InstitutionSetup {
  id              String    @id @default(uuid())
  schoolId        String    @unique @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  institutionType String    @map("institution_type") // STANDALONE, GROUP
  adoptionMode    String?   @map("adoption_mode") // EXAM_STUDIO, FULL_OPERATIONS
  currentStep     String    @default("structure") @map("current_step")
  completedSteps  String[]  @default([]) @map("completed_steps")
  draft           Json      @default("{}")
  version         Int       @default(0)
  status          String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETING, FAILED, COMPLETED
  failedStep      String?   @map("failed_step")
  lastError       String?   @map("last_error") @db.Text
  attempts        Int       @default(0)
  result          Json?
  delegateUserId  String?   @map("delegate_user_id")
  delegatedById   String?   @map("delegated_by_id")
  delegatedAt     DateTime? @map("delegated_at")
  updatedById     String?   @map("updated_by_id")
  completedById   String?   @map("completed_by_id")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("institution_setups")
}

// Durable subscription checkout state. Provider redirects and browser return
// parameters are never authoritative for entitlement activation.
model OnboardingCheckoutIntent {
  id                 String   @id @default(uuid())
  schoolId           String   @map("school_id")
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey     String   @map("idempotency_key")
  plan               String
  billingPeriod      String   @default("monthly") @map("billing_period")
  catalogueVersion   String   @map("catalogue_version")
  contractSnapshot   Json     @map("contract_snapshot")
  expectedCampuses   Int      @map("expected_campuses")
  expectedEnrollment Int      @map("expected_enrollment")
  returnStep         String   @map("return_step")
  provider           String   @default("NONE")
  providerReference  String?  @map("provider_reference")
  checkoutUrl        String?  @map("checkout_url") @db.Text
  status             String   @default("PENDING")
  amount             Int?
  currency           String?
  failureReason      String?  @map("failure_reason") @db.Text
  settledAt          DateTime? @map("settled_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, userId, idempotencyKey])
  @@index([schoolId, status, createdAt])
  @@index([provider, providerReference])
  @@map("onboarding_checkout_intents")
}

model SubscriptionRequest {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestedById  String   @map("requested_by_id")
  requestedBy    User     @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  idempotencyKey String   @map("idempotency_key")
  kind           String
  state          String   @default("PENDING_REVIEW")
  requestedPlan  String?  @map("requested_plan")
  effectiveAt    DateTime? @map("effective_at")
  details        Json
  reviewedById   String?  @map("reviewed_by_id")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@unique([schoolId, requestedById, idempotencyKey])
  @@index([schoolId, state, createdAt])
  @@map("subscription_requests")
}

// Durable provider receipt. Event IDs are globally unique at Stripe; failed
// receipts remain available for retry and operator investigation.
model StripeWebhookReceipt {
  eventId       String   @id @map("event_id")
  eventType     String   @map("event_type")
  eventCreated  Int      @map("event_created")
  state         String   @default("PROCESSING")
  attemptCount  Int      @default(1) @map("attempt_count")
  error         String?  @db.Text
  receivedAt    DateTime @default(now()) @map("received_at")
  processedAt   DateTime? @map("processed_at")
  // SKO-373: one receipt table for every billing provider. NEEDS_REVIEW holds
  // a verified event the system could not safely apply (unknown institution,
  // missing amount); a platform operator resolves it with a recorded note.
  provider      String   @default("STRIPE")
  schoolId      String?  @map("school_id")
  reviewNote    String?  @map("review_note") @db.Text
  reviewedById  String?  @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  @@index([state, receivedAt])
  @@map("stripe_webhook_receipts")
}

// ─── 1d. ROLE PERMISSIONS MATRIX ─────────────────────────
// Server-side capability matrix per role per module. APP_OWNER and
// SUPER_ADMIN are fixed (always allowed, never editable) so a school
// can never lock itself out.
model RolePermission {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  role      UserRole
  module    String // "students" | "fees" | "payroll" | …
  canView   Boolean  @default(false) @map("can_view")
  canAdd    Boolean  @default(false) @map("can_add")
  canEdit   Boolean  @default(false) @map("can_edit")
  canDelete Boolean  @default(false) @map("can_delete")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, role, module])
  @@map("role_permissions")
}

