/// Per-school messaging policy. The defaults are the conservative ones: the
/// peer channels a school has to consciously open (pupil-to-pupil,
/// guardian-to-guardian) start closed.
model ChatSetting {
  id       String @id @default(uuid())
  schoolId String @unique @default("") @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentToStudent Boolean @default(false) @map("student_to_student")
  parentToParent   Boolean @default(false) @map("parent_to_parent")
  /// Whether families may reach support staff (accountant, librarian,
  /// receptionist) directly. Leadership and their own teachers are always
  /// reachable — that is the point of the module.
  studentToSupport Boolean @default(true) @map("student_to_support")
  parentToSupport  Boolean @default(true) @map("parent_to_support")

  attachmentsEnabled Boolean @default(true) @map("attachments_enabled")

  /// Outside these hours a family message still lands in the thread, it just
  /// does not raise a notification on staff devices. "HH:mm" in school time.
  quietHoursEnabled Boolean @default(false) @map("quiet_hours_enabled")
  quietHoursStart   String  @default("20:00") @map("quiet_hours_start")
  quietHoursEnd     String  @default("07:00") @map("quiet_hours_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_settings")
}

