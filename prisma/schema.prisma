// AI authoring stores drafts and approved snapshots; it does not bypass domain workflows.
model SchoolAiRecord {
  documentJobs SchoolAiDocumentJob[]
  setupTasks SchoolAiSetupTask[]
  schoolAiExecutions SchoolAiExecution[]
  id             String @id @default(uuid())
  schoolId       String @default("") @map("school_id")
  school         School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String? @map("campus_id")
  campus         Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)
