// Dormitory
model DormRoomType {
  id          String   @id @default(uuid())
  schoolId    String   @default("") @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String   @map("campus_id")
  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /**
   * Charge per term, in paisa — same unit as every other money column.
   */
  costPerTerm Int      @default(0) @map("cost_per_term")
  createdAt   DateTime @default(now()) @map("created_at")

  rooms DormRoom[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("dorm_room_types")
}

model DormRoom {
  id         String       @id @default(uuid())
  schoolId   String       @default("") @map("school_id")
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String       @map("campus_id")
  campus     Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  roomTypeId String       @map("room_type_id")
  roomType   DormRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  number     String
  capacity   Int
  // SKO-463: an out-of-service room takes no new allocations; the reason and who changed it are kept.
  status       String       @default("AVAILABLE") // AVAILABLE | OUT_OF_SERVICE
  statusReason String?      @map("status_reason")
  createdAt  DateTime     @default(now()) @map("created_at")

  students    Student[]        @relation("StudentDormRoom")
  allocations DormAllocation[]

  @@unique([campusId, number])
  @@index([schoolId])
  @@map("dorm_rooms")
}

// SKO-463: dated room allocations. A stay is [startDate, endDate) — endDate is the first night the
// pupil is no longer in the room (null = open-ended). Moves end one stay and start the next on the same
// date, linked by previousId, so history is continuous. Rows are never deleted; a mistaken future
// reservation is CANCELLED with a reason.
model DormAllocation {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String    @map("campus_id")
  campus         Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  roomId         String    @map("room_id")
  room           DormRoom  @relation(fields: [roomId], references: [id], onDelete: NoAction)
  studentId      String    @map("student_id")
  student        Student   @relation(fields: [studentId], references: [id], onDelete: NoAction)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  status         String    @default("ACTIVE") // ACTIVE | CANCELLED
  reason         String
  endReason      String?   @map("end_reason")
  previousId     String?   @unique @map("previous_id")
  previous       DormAllocation?  @relation("DormMove", fields: [previousId], references: [id], onDelete: NoAction)
  next           DormAllocation?  @relation("DormMove")
  idempotencyKey String?   @map("idempotency_key")
  requestHash    String?   @map("request_hash")
  createdById    String    @map("created_by_id")
  endedById      String?   @map("ended_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([campusId, idempotencyKey])
  @@index([roomId, startDate])
  @@index([studentId, startDate])
  @@index([schoolId])
  @@map("dorm_allocations")
}

// SKO-417: the principal queue is derived from live source conditions (missing attendance, pending
// leave, unapproved report versions, failed deliveries, ownerless or late complaints, adjustments awaiting
// approval). Only what the queue itself adds is stored here — who it is assigned to, acknowledgement and a
// reasoned snooze — keyed by a deterministic item key, with an append-only history. Closure always comes
// from the source condition disappearing, never from this table.
model QueueItemState {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String    @map("campus_id")
  itemKey        String    @map("item_key")
  assigneeId     String?   @map("assignee_id")
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedById String? @map("acknowledged_by_id")
  snoozedUntil   DateTime? @map("snoozed_until")
  snoozeReason   String?   @map("snooze_reason")
  resolvedAt     DateTime? @map("resolved_at")
  title          String?
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([campusId, itemKey])
  @@index([schoolId])
  @@map("queue_item_states")
}

model QueueItemEvent {
  id           String    @id @default(uuid())
  schoolId     String    @default("") @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String    @map("campus_id")
  itemKey      String    @map("item_key")
  kind         String // ASSIGNED | ACKNOWLEDGED | SNOOZED | UNSNOOZED | RESOLVED
  assigneeId   String?   @map("assignee_id")
  snoozedUntil DateTime? @map("snoozed_until")
  note         String?
  actorId      String?   @map("actor_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([campusId, itemKey, createdAt])
  @@index([schoolId])
  @@map("queue_item_events")
}

