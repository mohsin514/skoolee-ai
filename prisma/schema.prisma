// ===========================================
// SkooleeAI - Finalized Multi-Tenant Schema
// ===========================================

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 1. SCHOOLS (Central Registry) ────────────────────────
model School {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique // subdomain routing
  status        String    @default("TRIAL") // TRIAL, ACTIVE, SUSPENDED
  plan          String    @default("FREE")  // FREE, BASIC, PRO
  aiCreditsUsed Int       @default(0)       @map("ai_credits_used")
  aiCreditsLimit Int      @default(100)     @map("ai_credits_limit")
  stripeCustomerId String? @unique         @map("stripe_customer_id")
  stripeSubscriptionId String? @unique      @map("stripe_subscription_id")
  planPricing   Json?     @map("plan_pricing") // Owner-defined plan pricing overrides
  city          String
  address       String?
  regId         String    @unique @map("reg_id") // Unique Institutional Identity
  contactEmail  String    @unique @map("contact_email")
  createdAt     DateTime  @default(now()) @map("created_at")
  
  // Relations
  campuses      Campus[]
  users         User[]
  aiLogs        AIUsageLog[]
  notificationTemplates NotificationTemplate[]
  parentCommunications  ParentCommunication[]

  @@map("schools")
}

// ─── 2. CAMPUSES ──────────────────────────────────────────
model Campus {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  city          String
  address       String?
  phone         String?
  regId         String    @unique @map("reg_id") // Unique Campus Identity
  board         String?   // e.g., FBISE, Lahore Board
  logoUrl       String?   @map("logo_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Global Multi-Tenant Relations
  users         User[]
  classes       Class[]
  students      Student[]
  subjects      Subject[]
  exams         Exam[]
  marks         Mark[]
  reportCards   ReportCard[] @relation("CampusReports")
  attendance    Attendance[]
  feeStructures FeeStructure[]
  invoices      Invoice[]
  payments      Payment[]
  paymentPlans  PaymentPlan[]
  bankReconciliations BankReconciliation[]
  staffInvitations StaffInvitation[]
  notificationTemplates NotificationTemplate[]
  parentCommunications  ParentCommunication[]
  gradeWeightConfigs GradeWeightConfig[]
  timetables    Timetable[]
  teacherAttendance TeacherAttendance[]
  studentClassHistory StudentClassHistory[]
  academicCycles AcademicCycle[]

  @@map("campuses")
}

// ─── 3. USERS ─────────────────────────────────────────────
model User {
  id            String    @id @default(uuid())
  campusId      String?   @map("campus_id")
  campus        Campus?   @relation(fields: [campusId], references: [id])
  schoolId      String    @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id])
  email         String    @unique
  password      String?   // Added for Diagram 2 Flow
  username      String?   @unique
  fullName      String    @map("full_name")
  role          UserRole  @default(TEACHER)
  phone         String?
  profileImageUrl String? @map("profile_image_url") @db.Text
  cnic               String?   @map("cnic")
  dateOfBirth        DateTime? @map("date_of_birth")
  gender             String?
  qualification      String?
  specialization     String?
  experience         String?
  address            String?   @db.Text
  city               String?
  province           String?
  postalCode         String?   @map("postal_code")
  joiningDate        DateTime? @map("joining_date")
  emergencyContact   String?   @map("emergency_contact")
  emergencyPhone     String?   @map("emergency_phone")
  isActive           Boolean   @default(true) @map("is_active")
  onboardingComplete Boolean   @default(false) @map("onboarding_complete")
  createdAt          DateTime  @default(now()) @map("created_at")
  // Action Tracking
  markedAttendance Attendance[] @relation("MarkedBy")
  enteredMarks     Mark[]       @relation("EnteredBy")
  lockedExams      Exam[]       @relation("LockedBy")
  recordedPayments Payment[]    @relation("RecordedBy")
  createdFeeStructures FeeStructure[] @relation("FeeStructureCreatedBy")
  updatedFeeStructures FeeStructure[] @relation("FeeStructureUpdatedBy")
  reconciledReconciliations BankReconciliation[] @relation("BankReconciliationReconciler")
  taughtSubjects   Subject[]    @relation("Teacher")
  ledClasses       Class[]      @relation("ClassTeacher")
  studentProfile   Student?     @relation("StudentUser")
  parentedStudents Student[]    @relation("Parent")
  parentCommunicationRecipients ParentCommunication[] @relation("ParentCommunicationParent")
  createdParentCommunications   ParentCommunication[] @relation("ParentCommunicationCreator")
  timetableSlots TimetableSlot[] @relation("TimetableTeacher")
  auditLogs      SuperAdminAuditLog[] @relation("AuditLogUser")
  loginSessions  LoginSession[]       @relation("UserSessions")
  passwordHistory PasswordHistory[]   @relation("PasswordHistory")
  teacherAttendance TeacherAttendance[] @relation("TeacherAttendanceUser")
  lastLogin      DateTime?            @map("last_login")
  lastPasswordChange DateTime?        @map("last_password_change")

  @@map("users")
}

// ─── 4. CLASSES ───────────────────────────────────────────
model Class {
  id             String    @id @default(uuid())
  campusId       String    @map("campus_id")
  campus         Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name           String
  section        String?
  classTeacherId String?   @map("class_teacher_id")
  classTeacher   User?     @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  academicYear   Int       @map("academic_year")
  status         String    @default("ACTIVE") // ACTIVE, COMPLETED

  // Relations
  students       Student[]
  subjects       Subject[]
  exams          Exam[]
  feeStructures  FeeStructure[]
  gradeWeightConfigs GradeWeightConfig[]
  attendance     Attendance[]
  timetables     Timetable[]
  classHistory   StudentClassHistory[]

  @@map("classes")
}

// ─── 5. STUDENTS ──────────────────────────────────────────
model Student {
  id            String    @id @default(uuid())
  campusId      String    @map("campus_id")
  campus        Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId       String    @map("class_id")
  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentUserId String?   @unique @map("student_user_id")
  studentUser   User?     @relation("StudentUser", fields: [studentUserId], references: [id])
  parentUserId  String?   @map("parent_user_id")
  parent        User?     @relation("Parent", fields: [parentUserId], references: [id])
  admissionNo   String?   @unique @map("admission_no") // Permanent ID across years
  fullName      String    @map("full_name")
  nameUr        String?   @map("name_ur")
  rollNo        String    @map("roll_no")
  gender        Gender
  dateOfBirth   DateTime? @map("date_of_birth")
  bloodType     String?   @map("blood_type")
  nationality   String?   @default("Pakistan")
  phone         String?
  guardianName  String?   @map("guardian_name")
  guardianNameUr String?  @map("guardian_name_ur")
  guardianPhone String?   @map("guardian_phone")
  guardianWhatsapp String? @map("guardian_whatsapp")
  guardianEmail String?   @map("guardian_email")
  guardianRelationship String? @map("guardian_relationship")
  guardianOccupation String? @map("guardian_occupation")
  profileImageUrl String? @map("profile_image_url") @db.Text
  address       String?   @db.Text
  city          String?
  province      String?
  postalCode    String?   @map("postal_code")
  medicalNotes  String?   @map("medical_notes") @db.Text
  specialNeeds  String?   @map("special_needs") @db.Text
  allergies     String?   @db.Text
  medications   String?   @db.Text
  previousSchool String?  @map("previous_school")
  enrollmentDate DateTime @default(now()) @map("enrollment_date")
  status        String    @default("active")

  // Records
  marks         Mark[]
  attendance    Attendance[]
  reportCards   ReportCard[]
  invoices      Invoice[]
  payments      Payment[]
  paymentPlans  PaymentPlan[]
  parentCommunications ParentCommunication[]
  classHistory  StudentClassHistory[]

  @@unique([campusId, rollNo])
  @@map("students")
}

// ─── 6. SUBJECTS ──────────────────────────────────────────
model Subject {
  id            String    @id @default(uuid())
  campusId      String    @map("campus_id")
  campus        Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId       String    @map("class_id")
  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  name          String
  teacherId     String?   @map("teacher_id")
  teacher       User?     @relation("Teacher", fields: [teacherId], references: [id])
  totalMarks    Int       @default(100) @map("total_marks")

  // Relations
  marks         Mark[]
  exams         Exam[]
  timetableSlots TimetableSlot[]

  @@map("subjects")
}

// ─── 7. EXAMS ─────────────────────────────────────────────
model Exam {
  id            String    @id @default(uuid())
  campusId      String    @map("campus_id")
  campus        Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId       String    @map("class_id")
  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  title         String
  term          String
  academicYear  Int       @map("academic_year")
  examType      String    @default("CLASS_TEST") @map("exam_type") // QUIZ, CLASS_TEST, MID_TERM, FINAL, CUSTOM
  subjectId     String?   @map("subject_id")      // if set, exam covers only this subject; null = all class subjects
  subject       Subject?  @relation(fields: [subjectId], references: [id])
  totalMarks    Int       @default(0) @map("total_marks") // computed sum of subject totalMarks
  status        String    @default("DRAFT") // DRAFT, ACTIVE, MARKS_ENTRY, LOCKED, PRINCIPAL_REVIEWED, PUBLISHED
  isLocked      Boolean   @default(false) @map("is_locked")
  lockedBy      String?   @map("locked_by")
  locker        User?     @relation("LockedBy", fields: [lockedBy], references: [id])
  lockedAt      DateTime? @map("locked_at")
  activatedAt   DateTime? @map("activated_at")
  marksEntryAt  DateTime? @map("marks_entry_at")
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  publishedAt   DateTime? @map("published_at")

  // Relations
  marks         Mark[]
  reportCards   ReportCard[]

  @@map("exams")
}

model GradeWeightConfig {
  id            String   @id @default(uuid())
  campusId      String   @map("campus_id")
  campus        Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId       String   @map("class_id")
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear  Int      @map("academic_year")
  quizWeight    Float    @default(10)    @map("quiz_weight")
  classTestWeight Float  @default(20)    @map("class_test_weight")
  midTermWeight Float    @default(30)    @map("mid_term_weight")
  finalWeight   Float    @default(40)    @map("final_weight")
  passingPercentage Float @default(50)   @map("passing_percentage")
  gradeAplus    Float    @default(90)    @map("grade_aplus")
  gradeA        Float    @default(80)    @map("grade_a")
  gradeB        Float    @default(70)    @map("grade_b")
  gradeC        Float    @default(60)    @map("grade_c")
  gradeD        Float    @default(50)    @map("grade_d")
  isActive      Boolean  @default(true)  @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@unique([classId, academicYear])
  @@map("grade_weight_configs")
}

// ─── 8. MARKS ─────────────────────────────────────────────
model Mark {
  id             String    @id @default(uuid())
  campusId       String    @map("campus_id")
  campus         Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  examId         String    @map("exam_id")
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String    @map("student_id")
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String    @map("subject_id")
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marksObtained  Int       @map("marks_obtained")
  grade          String?
  enteredBy      String?   @map("entered_by")
  enterer        User?     @relation("EnteredBy", fields: [enteredBy], references: [id])

  @@unique([examId, studentId, subjectId])
  @@map("marks")
}

// ─── 9. REPORT_CARDS ──────────────────────────────────────
model ReportCard {
  id            String    @id @default(uuid())
  campusId      String    @map("campus_id")
  campus        Campus    @relation("CampusReports", fields: [campusId], references: [id], onDelete: Cascade)
  studentId     String    @map("student_id")
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId        String    @map("exam_id")
  exam          Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  totalMarks     Int      @default(0) @map("total_marks")
  obtainedMarks  Int      @default(0) @map("obtained_marks")
  percentage     Float    @default(0)
  grade          String?
  rank           Int?
  attendancePresent Int   @default(0) @map("attendance_present")
  attendanceTotal   Int   @default(0) @map("attendance_total")
  remarksEn      String?   @map("remarks_en") @db.Text
  remarksUr      String?   @map("remarks_ur") @db.Text
  remarksApproved Boolean  @default(false) @map("remarks_approved")
  approvedBy      String?  @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  pdfUrl        String?   @map("pdf_url")
  status        String    @default("GENERATED") // GENERATED, REVIEWED, PUBLISHED, SENT
  isSent        Boolean   @default(false) @map("is_sent")
  sentVia       String?   @map("sent_via")
  sentAt        DateTime? @map("sent_at")
  deliveryStatus String   @default("NOT_SENT") @map("delivery_status")
  deliveryError  String?  @map("delivery_error") @db.Text
  generatedAt   DateTime  @default(now()) @map("generated_at")

  @@unique([studentId, examId])
  @@map("report_cards")
}

// ─── 10. ATTENDANCE ───────────────────────────────────────
model Attendance {
  id            String    @id @default(uuid())
  campusId      String    @map("campus_id")
  campus        Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId       String?   @map("class_id")
  class         Class?    @relation(fields: [classId], references: [id])
  studentId     String    @map("student_id")
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date          DateTime  @db.Date
  status        AttendanceStatus
  notes         String?   @db.Text
  markedBy      String?   @map("marked_by")
  marker        User?     @relation("MarkedBy", fields: [markedBy], references: [id])
  markedAt      DateTime  @default(now()) @map("marked_at")
  isLocked      Boolean   @default(false) @map("is_locked")
  lockedAt      DateTime? @map("locked_at")

  editHistory   AttendanceEditHistory[]

  @@unique([studentId, date])
  @@index([classId, date])
  @@index([campusId, date])
  @@map("attendance")
}

model AttendanceEditHistory {
  id            String    @id @default(uuid())
  attendanceId  String    @map("attendance_id")
  attendance    Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  oldStatus     String    @map("old_status")
  newStatus     String    @map("new_status")
  editedBy      String?   @map("edited_by")
  editedAt      DateTime  @default(now()) @map("edited_at")

  @@index([attendanceId])
  @@map("attendance_edit_history")
}

// ─── 11. FEE_STRUCTURES ───────────────────────────────────
model FeeStructure {
  id             String    @id @default(uuid())
  campusId       String    @map("campus_id")
  campus         Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId        String    @map("class_id")
  class          Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  monthlyFee     Int       @map("monthly_fee")
  oneTimeFeesJson Json?    @map("one_time_fees_json")
  installmentType String?  @map("installment_type")
  discountRulesJson Json?  @map("discount_rules_json")
  lateFeePercentage Float? @default(2.0) @map("late_fee_percentage")
  compoundLateFee Boolean? @default(true) @map("compound_late_fee")
  taxPercentage  Float?    @default(0.0) @map("tax_percentage")
  activeFrom     DateTime  @map("active_from")
  activeTo       DateTime? @map("active_to")
  createdBy      String?   @map("created_by")
  createdByUser  User?     @relation("FeeStructureCreatedBy", fields: [createdBy], references: [id])
  updatedBy      String?   @map("updated_by")
  updatedByUser  User?     @relation("FeeStructureUpdatedBy", fields: [updatedBy], references: [id])
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([classId, activeFrom])
  @@index([campusId, classId])
  @@map("fee_structures")
}

// ─── 12. INVOICES ─────────────────────────────────────────
model Invoice {
  id            String    @id @default(uuid())
  campusId      String    @map("campus_id")
  campus        Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  studentId     String    @map("student_id")
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceNumber String?   @unique @map("invoice_number")
  invoiceDate   DateTime  @map("invoice_date")
  dueDate       DateTime  @map("due_date")
  monthlyFee    Int       @map("monthly_fee")
  oneTimeFees   Int       @default(0) @map("one_time_fees")
  subtotal      Int       @map("subtotal")
  discountAmount Int      @default(0) @map("discount_amount")
  lateFeeAmount Int       @default(0) @map("late_fee_amount")
  taxAmount     Int       @default(0) @map("tax_amount")
  totalAmount   Int       @map("total_amount")
  totalAmountPaid Int     @default(0) @map("total_amount_paid")
  balanceDue    Int       @map("balance_due")
  status        InvoiceStatus @default(PENDING)
  pdfUrlS3      String?   @map("pdf_url_s3")
  sentWhatsapp  Boolean   @default(false) @map("sent_whatsapp")
  whatsappSentAt DateTime? @map("whatsapp_sent_at")
  sentEmail     Boolean   @default(false) @map("sent_email")
  emailSentAt   DateTime? @map("email_sent_at")
  generatedAt   DateTime  @default(now()) @map("generated_at")

  payments      Payment[]

  @@index([studentId, dueDate])
  @@index([status])
  @@index([campusId])
  @@map("invoices")
}

// ─── 13. PAYMENTS ─────────────────────────────────────────
model Payment {
  id             String    @id @default(uuid())
  campusId       String    @map("campus_id")
  campus         Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  invoiceId      String    @map("invoice_id")
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId      String    @map("student_id")
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount         Int       @map("amount")
  paymentDate    DateTime  @map("payment_date")
  paymentMethod  String    @map("payment_method")
  referenceNumber String?  @map("reference_number")
  receiptNo      String?   @map("receipt_no")
  receiptUrlS3   String?   @map("receipt_url_s3")
  recordedBy     String?   @map("recorded_by")
  recorder       User?     @relation("RecordedBy", fields: [recordedBy], references: [id])
  recordedAt     DateTime  @default(now()) @map("recorded_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([studentId])
  @@unique([campusId, paymentDate, referenceNumber])
  @@map("payments")
}

// ─── 13b. PAYMENT PLANS ────────────────────────────────────
model PaymentPlan {
  id               String   @id @default(uuid())
  campusId         String?  @map("campus_id")
  campus           Campus?  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  studentId        String?  @map("student_id")
  student          Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  originalAmountDue Int     @map("original_amount_due")
  installmentCount Int      @map("installment_count")
  installmentsJson Json     @map("installments_json")
  status           String   @default("active")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("payment_plans")
}

// ─── 13c. BANK RECONCILIATION ──────────────────────────────
model BankReconciliation {
  id                     String   @id @default(uuid())
  campusId               String   @map("campus_id")
  campus                 Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  importDate             DateTime @map("import_date")
  bankFileUrlS3          String?  @map("bank_file_url_s3")
  bankAccount            String?  @map("bank_account")
  statementPeriodFrom    DateTime? @map("statement_period_from")
  statementPeriodTo      DateTime? @map("statement_period_to")
  totalTransactions      Int      @default(0) @map("total_transactions")
  matchedCount           Int      @default(0) @map("matched_count")
  unmatchedCount         Int      @default(0) @map("unmatched_count")
  reconciliationDetailsJson Json? @map("reconciliation_details_json")
  unmatchedJson          Json?    @map("unmatched_json")
  status                 String   @default("pending")
  reconciledBy           String?  @map("reconciled_by")
  reconciledByUser       User?    @relation("BankReconciliationReconciler", fields: [reconciledBy], references: [id])
  reconciledAt           DateTime? @map("reconciled_at")
  createdAt              DateTime @default(now()) @map("created_at")

  @@map("bank_reconciliations")
}

// ─── 14. AI USAGE LOGS ────────────────────────────────────
model AIUsageLog {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  school         School   @relation(fields: [schoolId], references: [id])
  campusId       String?  @map("campus_id")
  userId         String?  @map("user_id")
  feature        String?  // e.g., "generate_remarks", "at_risk_students"
  action         String   // e.g., "single_remark", "batch_remark"
  promptVersion  String?  @map("prompt_version")
  model          String?
  tokensUsed     Int      @default(0) @map("tokens_used")
  approvalStatus String   @default("DRAFT") @map("approval_status")
  output         Json?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId])
  @@index([feature])
  @@map("ai_usage_logs")
}

model AIInsight {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  campusId       String?  @map("campus_id")
  userId         String   @map("user_id")
  role           String
  feature        String
  action         String
  title          String
  summary        String   @db.Text
  output         Json?
  promptVersion  String   @map("prompt_version")
  model          String
  tokensUsed     Int      @default(0) @map("tokens_used")
  approvalStatus String   @default("DRAFT") @map("approval_status")
  status         String   @default("ACTIVE")
  approvedBy     String?  @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId, feature])
  @@index([userId])
  @@map("ai_insights")
}

model AIReviewItem {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  campusId       String   @map("campus_id")
  userId         String?  @map("user_id")
  feature        String
  relatedType    String   @map("related_type")
  relatedId      String   @map("related_id")
  title          String
  draft          Json?
  status         String   @default("PENDING")
  promptVersion  String?  @map("prompt_version")
  model          String?
  tokensUsed     Int      @default(0) @map("tokens_used")
  approvedBy     String?  @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId, status])
  @@index([relatedType, relatedId])
  @@map("ai_review_items")
}

model InterventionPlan {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  campusId       String   @map("campus_id")
  studentId      String?  @map("student_id")
  createdBy      String   @map("created_by")
  title          String
  summary        String   @db.Text
  recommendations Json?
  status         String   @default("DRAFT")
  approvedBy     String?  @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId, status])
  @@index([studentId])
  @@map("intervention_plans")
}

model PromptTemplate {
  id           String   @id @default(uuid())
  schoolId     String?  @map("school_id")
  campusId     String?  @map("campus_id")
  role         String
  feature      String
  version      String
  systemPrompt String   @map("system_prompt") @db.Text
  userPrompt   String   @map("user_prompt") @db.Text
  content      Json?
  isActive     Boolean  @default(true) @map("is_active")
  status       String   @default("APPROVED")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId, role, feature])
  @@map("prompt_templates")
}

model ParentConversation {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  campusId  String?  @map("campus_id")
  userId    String   @map("user_id")
  studentId String?  @map("student_id")
  question  String   @db.Text
  answer    String   @db.Text
  source    String   @default("APPROVED_FAQ")
  status    String   @default("DRAFT")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId, userId])
  @@map("parent_conversations")
}

model ConsentLog {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  campusId    String?  @map("campus_id")
  userId      String   @map("user_id")
  feature     String
  consentType String   @map("consent_type")
  status      String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId, userId])
  @@map("consent_logs")
}

model NotificationTemplate {
  id                   String   @id @default(uuid())
  schoolId             String?  @map("school_id")
  school               School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId             String?  @map("campus_id")
  campus               Campus?  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  key                  String
  channel              String
  title                String
  subject              String?
  body                 String   @db.Text
  variables            Json?
  isSensitive          Boolean  @default(false) @map("is_sensitive")
  requiresApprovedData Boolean  @default(false) @map("requires_approved_data")
  status               String   @default("APPROVED")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([schoolId, campusId, key, channel])
  @@map("notification_templates")
}

model ParentCommunication {
  id                String    @id @default(uuid())
  schoolId          String    @map("school_id")
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId          String?   @map("campus_id")
  campus            Campus?   @relation(fields: [campusId], references: [id], onDelete: SetNull)
  studentId         String?   @map("student_id")
  student           Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  parentUserId      String?   @map("parent_user_id")
  parent            User?     @relation("ParentCommunicationParent", fields: [parentUserId], references: [id], onDelete: SetNull)
  createdById       String?   @map("created_by_id")
  createdBy         User?     @relation("ParentCommunicationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  templateKey       String    @map("template_key")
  channel           String
  recipientName     String?   @map("recipient_name")
  recipient         String
  subject           String?
  body              String    @db.Text
  attachmentUrl     String?   @map("attachment_url")
  relatedType       String?   @map("related_type")
  relatedId         String?   @map("related_id")
  status            String    @default("PENDING")
  providerMessageId String?   @map("provider_message_id")
  failedReason      String?   @map("failed_reason") @db.Text
  metadata          Json?
  approvedData      Boolean   @default(false) @map("approved_data")
  idempotencyKey    String?   @unique @map("idempotency_key")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, campusId, createdAt])
  @@index([studentId])
  @@index([parentUserId])
  @@index([status])
  @@index([relatedType, relatedId])
  @@map("parent_communications")
}

// ─── 15. TIMETABLES ───────────────────────────────────────
model Timetable {
  id            String    @id @default(uuid())
  campusId      String    @map("campus_id")
  campus        Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId       String    @map("class_id")
  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear  Int       @map("academic_year")
  term          String    @default("ANNUAL")
  status        String    @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  slots         TimetableSlot[]

  @@unique([classId, academicYear, term])
  @@index([campusId])
  @@map("timetables")
}

model TimetableSlot {
  id            String    @id @default(uuid())
  timetableId   String    @map("timetable_id")
  timetable     Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  dayOfWeek     Int       @map("day_of_week") // 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  periodNumber  Int       @map("period_number") // 1-8
  subjectId     String?   @map("subject_id")
  subject       Subject?  @relation(fields: [subjectId], references: [id])
  teacherId     String?   @map("teacher_id")
  teacher       User?     @relation("TimetableTeacher", fields: [teacherId], references: [id])
  roomNumber    String?   @map("room_number")
  startTime     String    @map("start_time") // "08:00"
  endTime       String    @map("end_time")   // "08:40"
  slotType      String    @default("CLASS") @map("slot_type") // CLASS, BREAK, ASSEMBLY, PRAYER, ACTIVITY

  @@unique([timetableId, dayOfWeek, periodNumber])
  @@index([teacherId, dayOfWeek, periodNumber])
  @@map("timetable_slots")
}

// ─── 16. SECURITY & ONBOARDING ────────────────────────────
model PendingRegistration {
  id               String   @id @default(uuid())
  email            String   @unique
  registrationType String   @map("registration_type") // school_group or single_campus
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

model StaffInvitation {
  id        String   @id @default(uuid())
  email     String
  role      UserRole
  campusId  String   @map("campus_id")
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  status    String   @default("pending") // pending, accepted
  createdAt DateTime @default(now()) @map("created_at")

  @@map("staff_invitations")
}

model AuditLog {
  id        String   @id @default(uuid())
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ─── 16b. PLATFORM CONFIG (Owner settings) ────────────────
model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("platform_config")
}

// ─── 17. SUPER ADMIN SECURITY ────────────────────────────

model SuperAdminAuditLog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation("AuditLogUser", fields: [userId], references: [id])
  action        String   // login, logout, suspend_school, modify_school, password_change, view_dashboard, create_campus, delete_campus, etc.
  targetType    String?  @map("target_type") // school, campus, user, subscription
  targetId      String?  @map("target_id")
  targetName    String?  @map("target_name")
  oldValues     Json?    @map("old_values")
  newValues     Json?    @map("new_values")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent") @db.Text
  status        String   @default("success") // success, failed, attempted
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("super_admin_audit_logs")
}

model LoginSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation("UserSessions", fields: [userId], references: [id])
  tokenHash     String    @map("token_hash")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent") @db.Text
  loginAt       DateTime  @default(now()) @map("login_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  expiresAt     DateTime  @map("expires_at")
  isActive      Boolean   @default(true) @map("is_active")
  logoutAt      DateTime? @map("logout_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("login_sessions")
}

model PasswordHistory {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation("PasswordHistory", fields: [userId], references: [id])
  oldPasswordHash String   @map("old_password_hash")
  changedBy       String?  @map("changed_by")
  changeReason    String?  @map("change_reason") // user_request, admin_forced, password_expired
  ipAddress       String?  @map("ip_address")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_history")
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_resets")
}

// ─── 18. STUDENT CLASS HISTORY ────────────────────────────
model StudentClassHistory {
  id              String    @id @default(uuid())
  studentId       String    @map("student_id")
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId         String    @map("class_id")
  class           Class     @relation(fields: [classId], references: [id])
  campusId        String    @map("campus_id")
  campus          Campus    @relation(fields: [campusId], references: [id])
  rollNo          String    @map("roll_no")
  academicYear    Int       @map("academic_year")
  status          String    @default("ACTIVE") // ACTIVE, PROMOTED, TRANSFERRED, GRADUATED, DROPPED
  finalGrade      String?   @map("final_grade")
  finalPercentage Float?    @map("final_percentage")
  promotedToClassId String? @map("promoted_to_class_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([studentId, classId, academicYear])
  @@index([campusId, academicYear])
  @@map("student_class_history")
}

// ─── 19. TEACHER ATTENDANCE ──────────────────────────────
model TeacherAttendance {
  id          String           @id @default(uuid())
  campusId    String           @map("campus_id")
  campus      Campus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  userId      String           @map("user_id")
  user        User             @relation("TeacherAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)
  checkInTime String?          @map("check_in_time") // "08:15"
  notes       String?          @db.Text
  markedAt    DateTime         @default(now()) @map("marked_at")

  @@unique([userId, date])
  @@index([campusId, date])
  @@map("teacher_attendance")
}

// ─── Enums ────────────────────────────────────────────────

enum UserRole {
  APP_OWNER   // Platform creator (Mohsin) — sees ALL schools
  SUPER_ADMIN // School group owner — scoped to their own school
  CAMPUS_ADMIN
  ADMIN       // Kept for backward compatibility with existing accounts
  PRINCIPAL
  TEACHER
  PARENT
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

// ─── ACADEMIC CYCLE ──────────────────────────────────────
model AcademicCycle {
  id            String    @id @default(uuid())
  campusId      String    @map("campus_id")
  campus        Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  label         String
  academicYear  Int       @map("academic_year")
  status        String    @default("DRAFT") // DRAFT, ACTIVE, PAUSED, ENDED
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([campusId, academicYear])
  @@index([campusId, status])
  @@map("academic_cycles")
}
