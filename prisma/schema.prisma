  @@index([studentId])
  @@index([parentUserId])
  @@index([status])
  @@index([relatedType, relatedId])
  @@map("parent_communications")
}

// ─── 12. ACADEMIC INFRASTRUCTURE (ROOMS + PERIODS) ───────
model ClassRoom {
  id         String   @id @default(uuid())
  schoolId   String   @default("") @map("school_id")
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String   @map("campus_id")
  roomNumber String   @map("room_number")
  capacity   Int      @default(0) // seats; 0 = not set
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  campus        Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  slots         TimetableSlot[]
  examSchedules ExamSchedule[]
  examRooms     ExamRoom[]

  @@unique([campusId, roomNumber])
  @@index([schoolId])
  @@map("class_rooms")
}

// Period definitions drive the timetable grid row headers and exam
// routines. Times are "HH:mm" and must not overlap within a timeType.
model PeriodDefinition {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  timeType     String   @default("CLASS") @map("time_type") // CLASS | EXAM
  periodNumber Int      @map("period_number") // 1-based sequence
  startTime    String   @map("start_time") // "HH:mm"
  endTime      String   @map("end_time") // "HH:mm"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campus        Campus         @relation(fields: [campusId], references: [id], onDelete: Cascade)
  examSchedules ExamSchedule[]

  @@unique([campusId, timeType, periodNumber])
  @@index([schoolId])
  @@map("period_definitions")
}

// ─── 15. TIMETABLES ───────────────────────────────────────
model Timetable {
  id           String    @id @default(uuid())
  schoolId     String    @default("") @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String    @map("campus_id")
  campus       Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId      String    @map("class_id")
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear Int       @map("academic_year")
  term         String    @default("ANNUAL")
  status       String    @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  slots TimetableSlot[]

  @@unique([classId, academicYear, term])
  @@index([campusId])
  @@index([schoolId])
  @@map("timetables")
}

model TimetableSlot {
  id           String     @id @default(uuid())
  schoolId     String     @default("") @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableId  String     @map("timetable_id")
  timetable    Timetable  @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        @map("day_of_week") // 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  periodNumber Int        @map("period_number") // 1-8
  subjectId    String?    @map("subject_id")
  subject      Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId    String?    @map("teacher_id")
  teacher      User?      @relation("TimetableTeacher", fields: [teacherId], references: [id])
  roomId       String?    @map("room_id")
  room         ClassRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomNumber   String?    @map("room_number")
  startTime    String     @map("start_time") // "08:00"
  endTime      String     @map("end_time") // "08:40"
  slotType     String     @default("CLASS") @map("slot_type") // CLASS, BREAK, ASSEMBLY, PRAYER, ACTIVITY

  @@unique([timetableId, dayOfWeek, periodNumber])
  @@index([teacherId, dayOfWeek, periodNumber])
  @@index([schoolId])
  @@map("timetable_slots")
}

// ─── 16. SECURITY & ONBOARDING ────────────────────────────
model PendingRegistration {
  id               String   @id @default(uuid())
  email            String   @unique
  registrationType String   @map("registration_type") // school_group or single_campus
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

model StaffInvitation {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email     String
  role      UserRole
  campusId  String   @map("campus_id")
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  status    String   @default("pending") // pending, accepted
  profile   Json? // captured at invite time (fullName, phone, qualification, etc.)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([schoolId])
  @@map("staff_invitations")
}

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([schoolId])
  @@map("audit_logs")
}

// ─── 16b. PLATFORM CONFIG (Owner settings) ────────────────
model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("platform_config")
}

// ─── 17. SUPER ADMIN SECURITY ────────────────────────────

model SuperAdminAuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id") // nullable: the log outlives the actor
  user         User?    @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  action       String // login, logout, suspend_school, modify_school, password_change, view_dashboard, create_campus, delete_campus, etc.
  targetType   String?  @map("target_type") // school, campus, user, subscription
  targetId     String?  @map("target_id")
  targetName   String?  @map("target_name")
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent") @db.Text
  status       String   @default("success") // success, failed, attempted
  errorMessage String?  @map("error_message") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("super_admin_audit_logs")
}

model LoginSession {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId         String    @map("user_id")
  // Sessions are meaningless without their user, and blocked user deletion.
  user           User      @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @map("token_hash")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent") @db.Text
  loginAt        DateTime  @default(now()) @map("login_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  expiresAt      DateTime  @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  logoutAt       DateTime? @map("logout_at")

  @@index([userId])
  @@index([tokenHash])
  @@index([schoolId])
  @@map("login_sessions")
}

model PasswordHistory {
  id              String   @id @default(uuid())
  schoolId        String   @default("") @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId          String   @map("user_id")
  user            User     @relation("PasswordHistory", fields: [userId], references: [id], onDelete: Cascade)
  oldPasswordHash String   @map("old_password_hash")
  changedBy       String?  @map("changed_by")
  changeReason    String?  @map("change_reason") // user_request, admin_forced, password_expired
  ipAddress       String?  @map("ip_address")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([schoolId])
  @@map("password_history")
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  // A token must resolve to exactly one account. Email alone stopped being
  // unique when identity became tenant-scoped, so the reset is bound to the
  // user it was issued for.
  userId    String?  @map("user_id")
  user      User?    @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_resets")
}

// ─── 18. STUDENT CLASS HISTORY ────────────────────────────
model StudentClassHistory {
  id                String   @id @default(uuid())
  schoolId          String   @default("") @map("school_id")
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String   @map("student_id")
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId           String   @map("class_id")
  class             Class    @relation(fields: [classId], references: [id])
  campusId          String   @map("campus_id")
  campus            Campus   @relation(fields: [campusId], references: [id])
  rollNo            String   @map("roll_no")
  academicYear      Int      @map("academic_year")
  status            String   @default("ACTIVE") // ACTIVE, PROMOTED, TRANSFERRED, GRADUATED, DROPPED
  finalGrade        String?  @map("final_grade")
  finalPercentage   Float?   @map("final_percentage")
  promotedToClassId String?  @map("promoted_to_class_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([studentId, classId, academicYear])
  @@index([campusId, academicYear])
  @@index([schoolId])
  @@map("student_class_history")
}

// ─── 19. TEACHER ATTENDANCE ──────────────────────────────
model TeacherAttendance {
  id          String           @id @default(uuid())
  schoolId    String           @default("") @map("school_id")
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String           @map("campus_id")
  campus      Campus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  userId      String           @map("user_id")
  user        User             @relation("TeacherAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)
  checkInTime String?          @map("check_in_time") // "08:15"
  notes       String?          @db.Text
  markedAt    DateTime         @default(now()) @map("marked_at")

  @@unique([userId, date])
  @@index([campusId, date])
  @@index([schoolId])
  @@map("teacher_attendance")
}

// ─── Enums ────────────────────────────────────────────────

enum UserRole {
  APP_OWNER // Platform creator (Mohsin) — sees ALL schools
  SUPER_ADMIN // School group owner — scoped to their own school
  CAMPUS_ADMIN
  ADMIN // Kept for backward compatibility with existing accounts
  PRINCIPAL
  TEACHER
  PARENT
  STUDENT
  ACCOUNTANT
  LIBRARIAN
  RECEPTIONIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

// ─── ACADEMIC CYCLE ──────────────────────────────────────
model AcademicCycle {
  id           String    @id @default(uuid())
  schoolId     String    @default("") @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String    @map("campus_id")
  campus       Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  label        String
  academicYear Int       @map("academic_year")
  status       String    @default("DRAFT") // DRAFT, ACTIVE, PAUSED, ENDED
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([campusId, academicYear])
  @@index([campusId, status])
  @@index([schoolId])
  @@map("academic_cycles")
}

// ─── IN-APP NOTIFICATIONS ────────────────────────────────
model Notification {
  id        String    @id @default(uuid())
  schoolId  String    @default("") @map("school_id")
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String?   @map("campus_id")
  userId    String    @map("user_id")
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String    @db.Text
  icon      String?
  link      String?
  metadata  Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  actorId   String?   @map("actor_id")
  actorName String?   @map("actor_name")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([schoolId])
  @@map("notifications")
}

// ─── Module 14: Operations Suite ─────────────────────────

// Transport
model TransportRoute {
  id          String   @id @default(uuid())
  schoolId    String   @default("") @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String   @map("campus_id")
  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fare        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  vehicles RouteVehicle[]
  students Student[]      @relation("StudentTransportRoute")

  @@unique([campusId, title])
  @@index([schoolId])
  @@map("transport_routes")
}

model Vehicle {
  id          String   @id @default(uuid())
  schoolId    String   @default("") @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String   @map("campus_id")
  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  number      String
  model       String?
  driverName  String?  @map("driver_name")
  driverPhone String?  @map("driver_phone")
  capacity    Int?
  createdAt   DateTime @default(now()) @map("created_at")

  routes RouteVehicle[]

  @@unique([campusId, number])
  @@index([schoolId])
  @@map("vehicles")
}

model RouteVehicle {
  id        String         @id @default(uuid())
  schoolId  String         @default("") @map("school_id")
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routeId   String         @map("route_id")
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicleId String         @map("vehicle_id")
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([routeId, vehicleId])
  @@index([schoolId])
  @@map("route_vehicles")
}

// Dormitory
model DormRoomType {
  id          String   @id @default(uuid())
  schoolId    String   @default("") @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String   @map("campus_id")
  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /**
   * Charge per term, in paisa — same unit as every other money column.
   */
  costPerTerm Int      @default(0) @map("cost_per_term")
  createdAt   DateTime @default(now()) @map("created_at")

  rooms DormRoom[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("dorm_room_types")
}

model DormRoom {
  id         String       @id @default(uuid())
  schoolId   String       @default("") @map("school_id")
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String       @map("campus_id")
  campus     Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  roomTypeId String       @map("room_type_id")
  roomType   DormRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  number     String
  capacity   Int
  createdAt  DateTime     @default(now()) @map("created_at")

  students Student[] @relation("StudentDormRoom")

  @@unique([campusId, number])
  @@index([schoolId])
  @@map("dorm_rooms")
}

// Library
model BookCategory {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String   @map("campus_id")
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  books Book[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("book_categories")
}

model Book {
  id              String        @id @default(uuid())
  schoolId        String        @default("") @map("school_id")
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String        @map("campus_id")
  campus          Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  categoryId      String?       @map("category_id")
  category        BookCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title           String
  author          String?
  isbn            String?
  subject         String?
  copiesTotal     Int           @default(1) @map("copies_total")
  copiesAvailable Int           @default(1) @map("copies_available")
  createdAt       DateTime      @default(now()) @map("created_at")

  issues BookIssue[]

  @@index([schoolId])
  @@map("books")
}

model LibraryMember {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String   @map("campus_id")
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberNo  String   @map("member_no")
  createdAt DateTime @default(now()) @map("created_at")

  issues BookIssue[]

  @@unique([campusId, userId])
  @@unique([campusId, memberNo])
  @@index([schoolId])
  @@map("library_members")
}

model BookIssue {
  id         String        @id @default(uuid())
  schoolId   String        @default("") @map("school_id")
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bookId     String        @map("book_id")
  book       Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  memberId   String        @map("member_id")
  member     LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  issuedAt   DateTime      @default(now()) @map("issued_at")
  dueAt      DateTime      @map("due_at")
  returnedAt DateTime?     @map("returned_at")
  fine       Int           @default(0)
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([schoolId])
  @@map("book_issues")
}

// Inventory / POS
model ItemCategory {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String   @map("campus_id")
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  items Item[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("item_categories")
}

model Item {
  id         String        @id @default(uuid())
  schoolId   String        @default("") @map("school_id")
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String        @map("campus_id")
  campus     Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  categoryId String?       @map("category_id")
  category   ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name       String
  unit       String?
  createdAt  DateTime      @default(now()) @map("created_at")

  stock        ItemStock[]
  transactions ItemTransaction[]

  @@index([schoolId])
  @@map("items")
}

model ItemStore {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String   @map("campus_id")
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  stock        ItemStock[]
  transactions ItemTransaction[]

  @@unique([campusId, name])
  @@index([schoolId])
  @@map("item_stores")
}

model Supplier {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String   @map("campus_id")
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  transactions ItemTransaction[]

  @@index([schoolId])
  @@map("suppliers")
}

model ItemStock {
  id       String    @id @default(uuid())
  schoolId String    @default("") @map("school_id")
  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  itemId   String    @map("item_id")
  item     Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storeId  String    @map("store_id")
  store    ItemStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  quantity Int       @default(0)

  @@unique([itemId, storeId])
  @@index([schoolId])
  @@map("item_stock")
}

model ItemTransaction {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String    @map("campus_id")
  campus         Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  itemId         String    @map("item_id")
  item           Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storeId        String    @map("store_id")
  store          ItemStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind           String // RECEIVE | SELL | ISSUE | RETURN
  quantity       Int
  unitPrice      Int?      @map("unit_price")
  supplierId     String?   @map("supplier_id")
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  issuedToUserId String?   @map("issued_to_user_id")
  date           DateTime  @default(now())
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([schoolId])
  @@map("item_transactions")
}

// ─── Module 15: Front-Desk Logs ──────────────────────────

