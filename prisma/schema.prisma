// ====================================// SkooleeAI - Finalized Multi-Tenant Schema
// ====================================//
// TENANCY: every tenant-owned model carries `schoolId` with a real foreign
// key to `schools`. School A must never read or write School B's rows.
//
// The `@default("")` on those fields is NOT a meaningful fallback — it exists
// only so Prisma's generated create types don't demand a value that the tenant
// guard (src/lib/db/prisma.ts) already stamps on every write from the request's
// tenant context. An empty string can never satisfy the foreign key, so if the
// guard is ever bypassed and a row is written without a school, the insert
// fails loudly instead of silently landing in the wrong tenant.
//
// After adding or removing a model, re-run:
//   node scripts/gen-tenant-registry.mjs
// The guard refuses to query any model missing from that registry.

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

