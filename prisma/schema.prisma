// ─── 12. ACADEMIC INFRASTRUCTURE (ROOMS + PERIODS) ───────
model ClassRoom {
  id         String  @id @default(uuid())
  schoolId   String  @default("") @map("school_id")
  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId   String  @map("campus_id")
  roomNumber String  @map("room_number")
  capacity   Int     @default(0) // TEACHING seats; 0 = not set
  note       String?

  // ── Where the room is ──────────────────────────────────────────────
  // An invigilator handed a seating plan needs to find the room, and
  // "R-101" alone does not say which block or which floor.
  building String? // "Main Block", "Science Wing"
  floor    Int     @default(0) // 0 = ground, 1 = first, -1 = basement
  wing     String? // "East", "North"
  roomType String  @default("CLASSROOM") @map("room_type") // CLASSROOM | HALL | LAB | LIBRARY | AUDITORIUM

  // ── How the room is laid out ───────────────────────────────────────
  // Teaching capacity and exam capacity are NOT the same number, and
  // conflating them is how a 30-seat room gets handed 30 candidates who
  // then sit three-to-a-bench copying from each other.
  //
  //   teaching capacity = rows × benchesPerRow × seatsPerBench
  //   exam capacity     = rows × benchesPerRow × examSeatsPerBench
  //
  // A 30-seat room laid out as 5 rows × 2 benches × 3 seats holds only
  // 10 candidates once exam spacing (1 per bench) is applied.
  rows              Int     @default(0) // rows of benches, front to back
  benchesPerRow     Int     @default(0) // benches across one row
  seatsPerBench     Int     @default(1) // pupils per bench in a lesson
  examSeatsPerBench Int     @default(1) @map("exam_seats_per_bench") // pupils per bench in an exam
  isExamHall        Boolean @default(false) @map("is_exam_hall") // prefer this room when auto-allocating

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campus        Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  slots         TimetableSlot[]
  examSchedules ExamSchedule[]
  examRooms     ExamRoom[]

  @@unique([campusId, roomNumber])
  @@index([schoolId])
  @@map("class_rooms")
}

// Period definitions drive the timetable grid row headers and exam
// routines. Times are "HH:mm" and must not overlap within a timeType.
model PeriodDefinition {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  timeType     String   @default("CLASS") @map("time_type") // CLASS | EXAM
  periodNumber Int      @map("period_number") // 1-based sequence
  startTime    String   @map("start_time") // "HH:mm"
  endTime      String   @map("end_time") // "HH:mm"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campus        Campus         @relation(fields: [campusId], references: [id], onDelete: Cascade)
  examSchedules ExamSchedule[]

  @@unique([campusId, timeType, periodNumber])
  @@index([schoolId])
  @@map("period_definitions")
}

// ─── 15. TIMETABLES ───────────────────────────────────────
model Timetable {
  id           String    @id @default(uuid())
  schoolId     String    @default("") @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String    @map("campus_id")
  campus       Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classId      String    @map("class_id")
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear Int       @map("academic_year")
  term         String    @default("ANNUAL")
  status       String    @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  // SKO-403: the slot rows are the working draft; every edit bumps the revision. Families, students and
  // teachers read the published version in force, so editing never changes their view until publication.
  draftRevision Int      @default(1) @map("draft_revision")

  slots    TimetableSlot[]
  versions TimetableVersion[]

  @@unique([classId, academicYear, term])
  @@index([campusId])
  @@index([schoolId])
  @@map("timetables")
}

model TimetableSlot {
  substituteDuties SchoolAiSubstituteDuty[]
  id           String     @id @default(uuid())
  schoolId     String     @default("") @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableId  String     @map("timetable_id")
  timetable    Timetable  @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        @map("day_of_week") // 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  periodNumber Int        @map("period_number") // 1-8
  subjectId    String?    @map("subject_id")
  subject      Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId    String?    @map("teacher_id")
  teacher      User?      @relation("TimetableTeacher", fields: [teacherId], references: [id])
  roomId       String?    @map("room_id")
  room         ClassRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomNumber   String?    @map("room_number")
  startTime    String     @map("start_time") // "08:00"
  endTime      String     @map("end_time") // "08:40"
  slotType     String     @default("CLASS") @map("slot_type") // CLASS, BREAK, ASSEMBLY, PRAYER, ACTIVITY

  @@unique([timetableId, dayOfWeek, periodNumber])
  @@index([teacherId, dayOfWeek, periodNumber])
  @@index([schoolId])
  @@map("timetable_slots")
}

/// SKO-403: an immutable published timetable. Bound to the exact draft revision that was validated; the
/// previous version stays in force until this one's effective date.
model TimetableVersion {
  id            String    @id @default(uuid())
  schoolId      String    @default("") @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String    @map("campus_id")
  timetableId   String    @map("timetable_id")
  timetable     Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  version       Int
  draftRevision Int       @map("draft_revision")
  effectiveFrom DateTime  @db.Date @map("effective_from")
  slots         Json
  changes       Json      @default("[]")
  note          String?   @db.Text
  publishedById String?   @map("published_by_id")
  publishedAt   DateTime  @default(now()) @map("published_at")
  notifiedAt    DateTime? @map("notified_at")

  @@unique([timetableId, version])
  @@index([timetableId, effectiveFrom])
  @@index([schoolId])
  @@map("timetable_versions")
}

/// SKO-421: a guardian's request for a learner's future leave. A school decision is recorded here; the
/// register itself is only ever changed by staff marking it.
model LearnerLeaveRequest {
  id            String    @id @default(uuid())
  schoolId      String    @default("") @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String    @map("campus_id")
  studentId     String    @map("student_id")
  requestedById String    @map("requested_by_id")
  fromDate      DateTime  @db.Date @map("from_date")
  toDate        DateTime  @db.Date @map("to_date")
  reason        String    @db.Text
  status        String    @default("PENDING") // PENDING | CLARIFICATION | APPROVED | DECLINED | CANCELLED
  reviewNote    String?   @db.Text @map("review_note")
  reviewedById  String?   @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, studentId, fromDate])
  @@index([campusId, status])
  @@map("learner_leave_requests")
}

/// SKO-421: a school trip. Its terms live in numbered versions; families answer one exact version.
model Trip {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String    @map("campus_id")
  status         String    @default("OPEN") // OPEN | CANCELLED
  currentVersion Int       @default(1) @map("current_version")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  versions TripVersion[]
  invitees TripInvitee[]
  consents TripConsent[]

  @@index([campusId, status])
  @@index([schoolId])
  @@map("trips")
}

/// SKO-421: immutable trip terms. A material change publishes a new version that needs fresh answers.
model TripVersion {
  id            String   @id @default(uuid())
  schoolId      String   @default("") @map("school_id")
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tripId        String   @map("trip_id")
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  version       Int
  title         String
  destination   String
  departAt      DateTime @map("depart_at")
  returnAt      DateTime @map("return_at")
  costAmount    Int      @default(0) @map("cost_amount")
  costCurrency  String   @default("PKR") @map("cost_currency")
  contact       String
  instructions  String   @db.Text
  consentKind   String   @map("consent_kind") // fieldTrips | offsiteTravel
  signatoryRule String   @map("signatory_rule") // ANY_GUARDIAN | ALL_GUARDIANS
  respondBy     DateTime @map("respond_by")
  material      Boolean  @default(true)
  changeNote    String?  @db.Text @map("change_note")
  publishedById String   @map("published_by_id")
  publishedAt   DateTime @default(now()) @map("published_at")

  consents TripConsent[]

  @@unique([tripId, version])
  @@index([schoolId])
  @@map("trip_versions")
}

model TripInvitee {
  id        String @id @default(uuid())
  schoolId  String @default("") @map("school_id")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tripId    String @map("trip_id")
  trip      Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  studentId String @map("student_id")

  @@unique([tripId, studentId])
  @@index([schoolId])
  @@map("trip_invitees")
}

/// SKO-421: one guardian's answer to one exact trip version, kept forever; a withdrawal is a new row.
model TripConsent {
  id             String      @id @default(uuid())
  schoolId       String      @default("") @map("school_id")
  school         School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tripId         String      @map("trip_id")
  trip           Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripVersionId  String      @map("trip_version_id")
  tripVersion    TripVersion @relation(fields: [tripVersionId], references: [id], onDelete: Cascade)
  studentId      String      @map("student_id")
  guardianUserId String      @map("guardian_user_id")
  relationshipId String      @map("relationship_id")
  choice         String // GRANTED | DECLINED | WITHDRAWN
  signatoryRule  String      @map("signatory_rule")
  idempotencyKey String      @map("idempotency_key")
  receiptCode    String      @map("receipt_code")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@unique([tripVersionId, guardianUserId, idempotencyKey])
  @@unique([schoolId, receiptCode])
  @@index([tripId, studentId])
  @@index([schoolId])
  @@map("trip_consents")
}

/// SKO-423: a class's weekly family update. Built only from released evidence, reviewed and approved by a
/// teacher for an exact content version, then delivered once per child, guardian and channel.
model FamilyDigest {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  classId         String    @map("class_id")
  weekStart       DateTime  @db.Date @map("week_start")
  status          String    @default("DRAFT") // DRAFT | APPROVED | SCHEDULED | SENT | CANCELLED
  version         Int       @default(1)
  approvedVersion Int?      @map("approved_version")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  scheduledFor    DateTime? @map("scheduled_for")
  sentAt          DateTime? @map("sent_at")
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  entries    FamilyDigestEntry[]
  deliveries FamilyDigestDelivery[]

  @@unique([classId, weekStart])
  @@index([campusId, status])
  @@index([schoolId])
  @@map("family_digests")
}

/// One child's section of a digest: sourced statements, one home activity, and whether it is sent at all.
model FamilyDigestEntry {
  id        String       @id @default(uuid())
  schoolId  String       @default("") @map("school_id")
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  digestId  String       @map("digest_id")
  digest    FamilyDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)
  studentId String       @map("student_id")
  content   Json
  skipped   Boolean      @default(false)
  status    String       @default("PENDING") // PENDING | SENT | BLOCKED
  reason    String?

  deliveries FamilyDigestDelivery[]

  @@unique([digestId, studentId])
  @@index([schoolId])
  @@map("family_digest_entries")
}

/// A delivery to one guardian on one channel for one child's week; unique so a retry never sends twice.
model FamilyDigestDelivery {
  id             String            @id @default(uuid())
  schoolId       String            @default("") @map("school_id")
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  digestId       String            @map("digest_id")
  digest         FamilyDigest      @relation(fields: [digestId], references: [id], onDelete: Cascade)
  entryId        String            @map("entry_id")
  entry          FamilyDigestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  studentId      String            @map("student_id")
  guardianUserId String            @map("guardian_user_id")
  channel        String            @default("IN_APP")
  weekStart      DateTime          @db.Date @map("week_start")
  version        Int
  status         String            @default("SENT") // SENT | BLOCKED
  reason         String?
  seenAt         DateTime?         @map("seen_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([studentId, weekStart, guardianUserId, channel])
  @@index([schoolId, guardianUserId])
  @@map("family_digest_deliveries")
}

