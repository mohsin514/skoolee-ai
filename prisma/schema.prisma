  linkUrl     String?   @map("link_url")
  fileName    String?   @map("file_name")
  contentType String?   @map("content_type")
  sizeBytes   Int?      @map("size_bytes")
  description String
  uploadedAt  DateTime? @map("uploaded_at")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([resourceId, version])
  @@map("learning_resource_versions")
}

/// SKO-406: a reviewed decision that an objective in one curriculum version is the same as,
/// partly overlaps or is not equivalent to an objective in another. Matching titles or codes
/// never merge objectives; only these decisions relate them. Rows are append-only: the latest
/// decision for a pair is current, earlier ones remain as history.
model CurriculumObjectiveMapping {
  id            String   @id @default(uuid())
  schoolId      String   @default("") @map("school_id")
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String   @map("campus_id")
  fromRecordId  String   @map("from_record_id")
  fromVersion   Int      @map("from_version")
  fromOutcomeId String   @map("from_outcome_id")
  toRecordId    String   @map("to_record_id")
  toVersion     Int      @map("to_version")
  toOutcomeId   String   @map("to_outcome_id")
  relation      String   // SAME | PARTIAL | NOT_EQUIVALENT
  note          String   @default("")
  decidedById   String   @map("decided_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([schoolId, fromRecordId, fromVersion])
  @@index([schoolId, toRecordId, toVersion])
  @@map("curriculum_objective_mappings")
}

/// SKO-409: a teacher's assignment. The row holds the editable draft; every release freezes
/// instructions, rubric, audience and deadline into an immutable AssignmentVersion.
model Assignment {
  id              String    @id @default(uuid())
  schoolId        String    @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  classId         String    @map("class_id")
  subjectId       String?   @map("subject_id")
  title           String
  instructions    String    @default("")
  status          String    @default("DRAFT") // DRAFT | RELEASED | CLOSED
  submissionMode  String    @default("ONLINE") @map("submission_mode") // ONLINE | PAPER | BOTH
  allowedTypes    String[]  @default([]) @map("allowed_types")
  opensLocal      String?   @map("opens_local")
  dueLocal        String?   @map("due_local")
  latePolicy      String    @default("ACCEPT_FLAGGED") @map("late_policy") // ACCEPT_FLAGGED | REFUSE
  resubmission    String    @default("AFTER_RETURN") // NEVER | AFTER_RETURN
  rubric          Json      @default("[]")
  objectives      Json?
  resourceIds     String[]  @default([]) @map("resource_ids")
  // SKO-414: a temporary lesson group; empty means the whole class. Each release freezes its audience.
  audienceStudentIds String[] @default([]) @map("audience_student_ids")
  externalRef     String?   @map("external_ref")
  ownerId         String    @map("owner_id")
  currentVersion  Int?      @map("current_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  rubricVersions  AssignmentRubricVersion[]
  versions        AssignmentVersion[]
  extensions      AssignmentExtension[]
  submissions     AssignmentSubmission[]

  @@unique([schoolId, externalRef])
  @@index([schoolId, classId, status])
  @@map("assignments")
}

/// Immutable rubric snapshot; feedback always scores against the version a submission was made under.
model AssignmentRubricVersion {
  id           String     @id @default(uuid())
  schoolId     String     @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentId String     @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_rubric_versions_assignment_fkey")
  version      Int
  criteria     Json
  totalPoints  Int        @map("total_points")
  createdById  String     @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([assignmentId, version])
  @@map("assignment_rubric_versions")
}

/// Immutable release: what learners were given, who they were and when it was due.
model AssignmentVersion {
  id               String     @id @default(uuid())
  schoolId         String     @map("school_id")
  school           School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentId     String     @map("assignment_id")
  assignment       Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_versions_assignment_fkey")
  version          Int
  title            String
  instructions     String
  rubricVersion    Int        @map("rubric_version")
  audience         String[]
  submissionMode   String     @map("submission_mode")
  allowedTypes     String[]   @map("allowed_types")
  timezone         String
  opensAt          DateTime   @map("opens_at")
  dueAt            DateTime   @map("due_at")
  dueLocal         String     @map("due_local")
  latePolicy       String     @map("late_policy")
  resubmission     String
  objectives       Json?
  resourceIds      String[]   @map("resource_ids")
  releasedById     String     @map("released_by_id")
  releasedAt       DateTime   @default(now()) @map("released_at")

  @@unique([assignmentId, version])
  @@map("assignment_versions")
}

/// An approved individual extension. Append-only: the latest row for a learner is in force.
model AssignmentExtension {
  id           String     @id @default(uuid())
  schoolId     String     @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentId String     @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_extensions_assignment_fkey")
  studentId    String     @map("student_id")
  dueAt        DateTime   @map("due_at")
  dueLocal     String     @map("due_local")
  timezone     String
  reason       String
  grantedById  String     @map("granted_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([schoolId, assignmentId, studentId])
  @@map("assignment_extensions")
}

/// One learner's work on one assignment: the resumable draft plus its workflow status.
model AssignmentSubmission {
  id                 String     @id @default(uuid())
  schoolId           String     @map("school_id")
  school             School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentId       String     @map("assignment_id")
  assignment         Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_submissions_assignment_fkey")
  studentId          String     @map("student_id")
  status             String     @default("DRAFT") // DRAFT | SUBMITTED | RETURNED | REOPENED
  draftText          String     @default("") @map("draft_text")
  draftStorageKey    String?    @map("draft_storage_key")
  draftFileName      String?    @map("draft_file_name")
  draftContentType   String?    @map("draft_content_type")
  draftSizeBytes     Int?       @map("draft_size_bytes")
  draftSha256        String?    @map("draft_sha256")
  draftUploadedAt    DateTime?  @map("draft_uploaded_at")
  draftSavedAt       DateTime?  @map("draft_saved_at")
  latestVersion      Int        @default(0) @map("latest_version")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  versions           AssignmentSubmissionVersion[]

  @@unique([assignmentId, studentId])
  @@index([schoolId, studentId])
  @@map("assignment_submissions")
}

/// The server receipt for one submitted version. Immutable; earlier versions are always kept.
model AssignmentSubmissionVersion {
  id                String               @id @default(uuid())
  schoolId          String               @map("school_id")
  school            School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submissionId      String               @map("submission_id")
  submission        AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_submission_versions_submission_fkey")
  assignmentId      String               @map("assignment_id")
  studentId         String               @map("student_id")
  version           Int
  assignmentVersion Int                  @map("assignment_version")
  rubricVersion     Int                  @map("rubric_version")
  mode              String               // ONLINE | PAPER
  idempotencyKey    String               @map("idempotency_key")
  receiptCode       String               @map("receipt_code")
  text              String               @default("")
  storageKey        String?              @map("storage_key")
  fileName          String?              @map("file_name")
  contentType       String?              @map("content_type")
  sizeBytes         Int?                 @map("size_bytes")
  fileSha256        String?              @map("file_sha256")
  artifactSha256    String               @map("artifact_sha256")
  submittedAt       DateTime             @default(now()) @map("submitted_at")
  receivedAt        DateTime             @map("received_at")
  effectiveDueAt    DateTime             @map("effective_due_at")
  late              Boolean
  draftSavedAt      DateTime?            @map("draft_saved_at")
  recordedById      String               @map("recorded_by_id")

  feedback          AssignmentFeedback?

  @@unique([submissionId, version])
  @@unique([submissionId, idempotencyKey])
  @@unique([schoolId, receiptCode])
  @@map("assignment_submission_versions")
}

/// Formative, criterion-level feedback on one submitted version. Hidden from learners and
/// families until RETURNED; then immutable. A gradebook transfer is only ever a request here.
model AssignmentFeedback {
  id                  String                      @id @default(uuid())
  schoolId            String                      @map("school_id")
  school              School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submissionVersionId String                      @unique @map("submission_version_id")
  submissionVersion   AssignmentSubmissionVersion @relation(fields: [submissionVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignment_feedback_submission_version_fkey")
  rubricVersion       Int                         @map("rubric_version")
  criteria            Json
  comment             String                      @default("")
  totalPoints         Int?                        @map("total_points")
  status              String                      @default("DRAFT") // DRAFT | RETURNED
  gradebookTransfer   String                      @default("NOT_REQUESTED") @map("gradebook_transfer") // NOT_REQUESTED | REQUESTED (never applied here)
  markerId            String                      @map("marker_id")
  returnedAt          DateTime?                   @map("returned_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  @@map("assignment_feedback")
}

/// SKO-410: a learner's approved, time-bounded assessment access plan. Each revision is a new row;
/// only operational adjustments live here. Diagnosis or private context never belongs in `instructions`.
model AccommodationPlan {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  studentId       String    @map("student_id")
  version         Int
  status          String    @default("ACTIVE") // ACTIVE | SUPERSEDED | REVOKED
  validFrom       DateTime  @map("valid_from") @db.Date
  validUntil      DateTime  @map("valid_until") @db.Date
  assessmentTypes String[]  @map("assessment_types")
  extraMinutes    Int       @default(0) @map("extra_minutes")
  extraPercent    Int       @default(0) @map("extra_percent")
  breakMinutes    Int       @default(0) @map("break_minutes")
  capabilities    Json
  instructions    String    @default("")
  approvedById    String    @map("approved_by_id")
  approvedAt      DateTime  @default(now()) @map("approved_at")
  endedAt         DateTime? @map("ended_at")
  endedById       String?   @map("ended_by_id")
  endReason       String?   @map("end_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  supportRecords  AccommodationSupportRecord[]
  rehearsals      AccommodationRehearsal[]

  @@unique([schoolId, studentId, version])
  @@index([schoolId, campusId, status])
  @@map("accommodation_plans")
}

/// Confidential supporting context, readable only by designated approvers.
model AccommodationSupportRecord {
  id          String            @id @default(uuid())
  schoolId    String            @default("") @map("school_id")
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId      String            @map("plan_id")
  plan        AccommodationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  note        String
  createdById String            @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([schoolId, planId])
  @@map("accommodation_support_records")
}

/// A learner's practice check of the exact accessible mode before a formal attempt.
model AccommodationRehearsal {
  id          String            @id @default(uuid())
  schoolId    String            @default("") @map("school_id")
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId      String            @map("plan_id")
  plan        AccommodationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  studentId   String            @map("student_id")
  settings    Json
  completedAt DateTime          @default(now()) @map("completed_at")

  @@index([schoolId, studentId])
  @@map("accommodation_rehearsals")
}

/// An exceptional adjustment to a running attempt, with approver, reason and old/new deadline.
model AccommodationLiveAdjustment {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  assignmentId String   @map("assignment_id")
  attemptId    String   @map("attempt_id")
  studentId    String   @map("student_id")
  addedMinutes Int      @map("added_minutes")
  reason       String
  oldDeadline  DateTime @map("old_deadline")
  newDeadline  DateTime @map("new_deadline")
  approvedById String   @map("approved_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([schoolId, assignmentId])
  @@map("accommodation_live_adjustments")
}

/// SKO-449: a tested Safe Exam Browser delivery profile. Revisions are immutable rows; keys are the
/// Config Keys and Browser Exam Keys reported by the tested client, never derived from a user agent.
model SecureBrowserProfile {
  id               String    @id @default(uuid())
  schoolId         String    @default("") @map("school_id")
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId         String    @map("campus_id")
  profileKey       String    @map("profile_key")
  version          Int
  name             String
  status           String    @default("DRAFT") // DRAFT | APPROVED | RETIRED
  minClientVersion String    @map("min_client_version")
  configKeys       String[]  @map("config_keys")
  browserExamKeys  String[]  @map("browser_exam_keys")
  allowedResources String[]  @map("allowed_resources")
  testedDevices    Json      @map("tested_devices")
  createdById      String    @map("created_by_id")
  approvedById     String?   @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([schoolId, profileKey, version])
  @@index([schoolId, campusId, status])
  @@map("secure_browser_profiles")
}

/// An audited, per-learner supervised alternative for a SECURE_BROWSER exam (e.g. unsupported device or assistive tool).
model SecureBrowserException {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  assignmentId String   @map("assignment_id")
  studentId    String   @map("student_id")
  reason       String
  approvedById String   @map("approved_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([assignmentId, studentId])
  @@index([schoolId, assignmentId])
  @@map("secure_browser_exceptions")
}


/// SKO-408: a staff rehearsal of one exact paper version. Results are BLOCKING or ADVISORY; a blocking
/// result stands until a new paper version is rehearsed clean. Rows are append-only evidence.
model SchoolAiRehearsal {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  recordId     String   @map("record_id")
  paperVersion Int      @map("paper_version")
  results      Json
  blocking     Int      @default(0)
  actorId      String   @map("actor_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([schoolId, recordId, paperVersion])
  @@map("school_ai_rehearsals")
}

/// SKO-408 R17: an authorized, versioned notice to the candidates sitting an exam. The paper itself never changes.
model SchoolAiExamClarification {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String   @map("campus_id")
  assignmentId String   @map("assignment_id")
  /// Per-exam sequence; a revision is a new row that names the notice it revises.
  version      Int
  revisesId    String?  @map("revises_id")
  questionId   String?  @map("question_id")
  text         String   @db.Text
  /// { kind: "SITTING" } or { kind: "ATTEMPTS", attemptIds: string[] }
  audience     Json
  issuedById   String   @map("issued_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([assignmentId, version])
  @@index([schoolId, campusId, assignmentId])
  @@map("school_ai_exam_clarifications")
}

/// SKO-462: effective-dated teaching assignments. A teacher change closes the open row and opens a new
/// one, so who taught a class or subject on any date stays answerable after the assignment changes.
model TeachingAssignment {
  id            String    @id @default(uuid())
  schoolId      String    @default("") @map("school_id")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String    @map("campus_id")
  classId       String    @map("class_id")
  /// Null for the class-teacher role.
  subjectId     String?   @map("subject_id")
  role          String
  teacherId     String?   @map("teacher_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([schoolId, campusId, classId])
  @@index([subjectId])
  @@map("teaching_assignments")
}

/// SKO-408 R15.4: a supervised pause of one attempt, its reason, who paused and resumed it, and the time restored.
model SchoolAiExamPause {
  id           String    @id @default(uuid())
  schoolId     String    @default("") @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String    @map("campus_id")
  assignmentId String    @map("assignment_id")
  attemptId    String    @map("attempt_id")
  reason       String
  startedById  String    @map("started_by_id")
  startedAt    DateTime  @default(now()) @map("started_at")
  endedById    String?   @map("ended_by_id")
  endedAt      DateTime? @map("ended_at")
  restoredMs   Int?      @map("restored_ms")

  @@index([schoolId, campusId, assignmentId])
  @@index([attemptId])
  @@map("school_ai_exam_pauses")
}

/// SKO-408 R17.2: one display acknowledgement per notice per attempt.
model SchoolAiExamClarificationAck {
  id              String   @id @default(uuid())
  schoolId        String   @default("") @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String   @map("campus_id")
  clarificationId String   @map("clarification_id")
  attemptId       String   @map("attempt_id")
  acknowledgedAt  DateTime @default(now()) @map("acknowledged_at")

  @@unique([clarificationId, attemptId])
  @@index([schoolId, campusId, attemptId])
  @@map("school_ai_exam_clarification_acks")
}

/// SKO-408 R17.7-R17.12: a previewed, human-authorized result remedy for one item of a delivered exam.
model SchoolAiExamRemedy {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String    @map("campus_id")
  assignmentId   String    @map("assignment_id")
  type           String
  questionId     String    @map("question_id")
  reason         String    @db.Text
  /// The correction the remedy applies (a corrected key), when the type needs one.
  correction     Json?
  /// Per attempt: result version, previous, proposed and delta, computed at preview.
  preview        Json
  notify         Boolean   @default(true)
  status         String    @default("PROPOSED")
  proposedById   String    @map("proposed_by_id")
  authorizedById String?   @map("authorized_by_id")
  appliedAt      DateTime? @map("applied_at")
  /// Per attempt: APPLIED (with the new result version), SKIPPED_CHANGED or FAILED.
  outcomes       Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([schoolId, campusId, assignmentId])
  @@map("school_ai_exam_remedies")
}

/// SKO-408 R19: a frozen evidence pack — the files and Integrity_Manifest exactly as produced, so
/// every later download serves the same bytes the manifest digests. Append-only apart from
/// `downloadedAt`; production and each download are also written to the audit log.
model SchoolAiEvidencePack {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  assignmentId    String    @map("assignment_id")
  scopeKind       String    @map("scope_kind")
  scopeId         String    @map("scope_id")
  manifest        Json
  files           Json
  includedKeys    Boolean   @default(false) @map("included_keys")
  includedCapture Boolean   @default(false) @map("included_capture")
  captureReason   String?   @map("capture_reason")
  requestedById   String    @map("requested_by_id")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  downloadedAt    DateTime? @map("downloaded_at")

  @@index([schoolId, campusId, assignmentId, requestedAt])
  @@map("school_ai_evidence_packs")
}

/// SKO-408 R9.6, R9.7: a model observation over two language versions of one item. The proposal
/// carries no item edit; it waits for one recorded human decision, which is then frozen.
model SchoolAiLanguageProposal {
  id             String    @id @default(uuid())
  schoolId       String    @default("") @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId       String    @map("campus_id")
  formSetId      String    @map("form_set_id")
  recordId       String    @map("record_id")
  recordVersion  Int       @map("record_version")
  itemGroupId    String    @map("item_group_id")
  finding        String
  proposal       Json
  decisionOutcome String?  @map("decision_outcome")
  decisionReason String?   @map("decision_reason")
  decidedById    String?   @map("decided_by_id")
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([schoolId, formSetId, recordId, recordVersion])
  @@map("school_ai_language_proposals")
}

// ─── SKO-404: year-end rollover plans ──────────────────────
// One reviewed plan per campus and source year. Every eligible learner has one
// decision row; missing evidence is NEEDS_REVIEW, never pass or fail. Approval
// binds to an exact version; execution is bounded, resumable and revalidates.
model RolloverPlan {
  id                 String    @id @default(uuid())
  schoolId           String    @default("") @map("school_id")
  campusId           String    @map("campus_id")
  sourceYear         Int       @map("source_year")
  destinationYear    Int       @map("destination_year")
  version            Int       @default(1)
  status             String    @default("DRAFT") // DRAFT, APPROVED, EXECUTING, PAUSED, EXCEPTIONS, COMPLETED
  effectiveDate      DateTime  @db.Date @map("effective_date")
  classMap           Json      @default("{}") @map("class_map")
  approvedVersion    Int?      @map("approved_version")
  approvedById       String?   @map("approved_by_id")
  approvedAt         DateTime? @map("approved_at")
  baseline           Json?
  leaseUntil         DateTime? @map("lease_until")
  notifiedAt         DateTime? @map("notified_at")
  createdById        String    @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([campusId, sourceYear])
  @@index([schoolId])
  @@map("rollover_plans")
}

model RolloverDecision {
  id                 String    @id @default(uuid())
  schoolId           String    @default("") @map("school_id")
  planId             String    @map("plan_id")
  studentId          String    @map("student_id")
  sourceClassId      String    @map("source_class_id")
  sourceEnrollmentId String    @map("source_enrollment_id")
  sourceRollNo       String    @map("source_roll_no")
  evidence           String    // PASSED, FAILED, MISSING
  evidenceDetail     Json?     @map("evidence_detail")
  decision           String    // PROMOTE, RETAIN, GRADUATE, TRANSFER_OUT, NEEDS_REVIEW
  destinationClassId String?   @map("destination_class_id")
  reason             String?
  reviewedById       String?   @map("reviewed_by_id")
  reviewedAt         DateTime? @map("reviewed_at")
  executionStatus    String    @default("PENDING") @map("execution_status") // PENDING, DONE, BLOCKED, REVERSED
  executionNote      String?   @map("execution_note")
  newEnrollmentId    String?   @map("new_enrollment_id")
  newRollNo          String?   @map("new_roll_no")
  executedAt         DateTime? @map("executed_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([planId, studentId])
  @@index([planId, executionStatus])
  @@index([schoolId])
  @@map("rollover_decisions")
}

model RolloverEvent {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  planId    String   @map("plan_id")
  version   Int
  kind      String
  actorId   String   @map("actor_id")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([planId, createdAt])
  @@index([schoolId])
  @@map("rollover_events")
}

// ─── SKO-413: published exam datesheet versions ─────────────
// A session's datesheet and seating are drafts until an officer publishes a
// version, after every hard check passes. Families read only the published
// snapshot; a later change is a new reviewed version with its diff and the
// exact people it affects, and documents print the version they show.
model ExamDatesheetVersion {
  id            String   @id @default(uuid())
  schoolId      String   @default("") @map("school_id")
  campusId      String   @map("campus_id")
  sessionId     String   @map("session_id")
  version       Int
  snapshot      Json
  seatingHash   String   @map("seating_hash")
  changes       Json?
  affected      Json?
  reason        String?  @db.Text
  publishedById String   @map("published_by_id")
  publishedAt   DateTime @default(now()) @map("published_at")

  @@unique([sessionId, version])
  @@index([schoolId])
  @@map("exam_datesheet_versions")
}

// ─── SKO-461: teaching evidence follow-up ───────────────────
// Append-only notes beside the evidence view: a leader's reviewed support
// action or the teacher's own response. Never an employment decision, which
// is recorded outside analytics by an authorized person.
model TeacherSupportNote {
  id           String   @id @default(uuid())
  schoolId     String   @default("") @map("school_id")
  campusId     String   @map("campus_id")
  teacherId    String   @map("teacher_id")
  authorId     String   @map("author_id")
  academicYear Int      @map("academic_year")
  kind         String   // SUPPORT_ACTION, TEACHER_RESPONSE
  body         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([teacherId, academicYear])
  @@index([schoolId])
  @@map("teacher_support_notes")
}

// ─── SKO-414: lesson-plan working state ─────────────────────
// Per plan (inside a curriculum record): temporary private groups, what
// happened when it was taught, and the assignment drafts made from it.
// Kept apart from the curriculum so recording a lesson never reopens an
// approved curriculum; every change is versioned in LessonPlanEvent.
model LessonPlanState {
  id                  String   @id @default(uuid())
  schoolId            String   @default("") @map("school_id")
  campusId            String   @map("campus_id")
  curriculumId        String   @map("curriculum_id")
  planId              String   @map("plan_id")
  groups              Json     @default("[]")
  delivery            Json?
  publishedActivities Json     @default("[]") @map("published_activities")
  version             Int      @default(1)
  updatedById         String   @map("updated_by_id")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([curriculumId, planId])
  @@index([schoolId])
  @@map("lesson_plan_states")
}

model LessonPlanEvent {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  stateId   String   @map("state_id")
  version   Int
  kind      String
  actorId   String   @map("actor_id")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([stateId, createdAt])
  @@index([schoolId])
  @@map("lesson_plan_events")
}

// ─── SKO-425: learning-action check-ins and history ─────────
model InterventionCheckIn {
  id            String   @id @default(uuid())
  schoolId      String   @default("") @map("school_id")
  planId        String   @map("plan_id")
  planVersion   Int      @map("plan_version")
  dueOn         DateTime @map("due_on") @db.Date
  delivered     Boolean
  minutes       Int?
  participation String   // FULL, PARTIAL, ABSENT
  adjustment    String?  @db.Text
  pupilFeedback String?  @map("pupil_feedback") @db.Text
  recordedById  String   @map("recorded_by_id")
  recordedAt    DateTime @default(now()) @map("recorded_at")

  @@index([planId, dueOn])
  @@index([schoolId])
  @@map("intervention_check_ins")
}

model InterventionEvent {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  planId    String   @map("plan_id")
  version   Int
  kind      String
  actorId   String   @map("actor_id")
  reason    String?  @db.Text
  snapshot  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([planId, createdAt])
  @@index([schoolId])
  @@map("intervention_events")
}

// ─── SKO-430: pilot measurement (platform-level, owner-only; no tenant data columns)

/// A pilot charter. Linked to a school by reference only, so pilot evidence stays a platform
/// operator record; participants are recorded under pseudonyms, never as user ids.
model Pilot {
  id                  String    @id @default(uuid())
  name                String
  targetSchoolId      String?   @map("target_school_id")
  country             String
  curriculum          String
  language            String
  useCase             String    @map("use_case")
  startsOn            DateTime  @map("starts_on") @db.Date
  endsOn              DateTime? @map("ends_on") @db.Date
  championName        String    @map("champion_name")
  measurementOwnerId  String    @map("measurement_owner_id")
  /// [{ key, definition, successDefinition }]
  workflows           Json
  consentReference    String?   @map("consent_reference")
  consentRecordedAt   DateTime? @map("consent_recorded_at")
  /// NONE, AGGREGATE (anonymised figures only) or NAMED (the school may be identified).
  caseStudyPermission String    @default("NONE") @map("case_study_permission")
  permissionReference String?   @map("permission_reference")
  synthetic           Boolean   @default(false)
  status              String    @default("PLANNED")
  createdById         String    @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  observations PilotObservation[]
  measures     PilotMeasure[]
  claims       PilotClaim[]

  @@index([country, curriculum, language])
  @@map("pilots")
}

/// One timed task. Active, elapsed and correction time are separate and nullable: a missing
/// value is missing, never filled from another measure.
model PilotObservation {
  id                String   @id @default(uuid())
  pilotId           String   @map("pilot_id")
  pilot             Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  workflow          String
  phase             String
  participant       String
  task              String
  difficulty        String
  activeSeconds     Int?     @map("active_seconds")
  elapsedSeconds    Int?     @map("elapsed_seconds")
  correctionSeconds Int?     @map("correction_seconds")
  completed         Boolean
  assisted          Boolean  @default(false)
  failureNote       String?  @map("failure_note")
  source            String
  synthetic         Boolean  @default(false)
  excludedReason    String?  @map("excluded_reason")
  observedOn        DateTime @map("observed_on") @db.Date
  recordedById      String   @map("recorded_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([pilotId, workflow, phase])
  @@map("pilot_observations")
}

/// Correctness samples, adoption, support, cost, satisfaction and commercial evidence. `state`
/// keeps measured values apart from self-reports, targets and verbal intent.
model PilotMeasure {
  id           String    @id @default(uuid())
  pilotId      String    @map("pilot_id")
  pilot        Pilot     @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  kind         String
  workflow     String?
  periodStart  DateTime  @map("period_start") @db.Date
  periodEnd    DateTime  @map("period_end") @db.Date
  value        Float?
  denominator  Float?
  unit         String
  state        String
  method       String
  reference    String?
  synthetic    Boolean   @default(false)
  supersededAt DateTime? @map("superseded_at")
  recordedById String    @map("recorded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([pilotId, kind])
  @@map("pilot_measures")
}

/// A proposed external statement. Approval freezes the finding it rests on; a later change to
/// that finding makes the claim stale and blocks it from export until reviewed again.
model PilotClaim {
  id           String    @id @default(uuid())
  pilotId      String    @map("pilot_id")
  pilot        Pilot     @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  version      Int       @default(1)
  statement    String
  findingKey   String    @map("finding_key")
  identifiable Boolean   @default(false)
  status       String    @default("DRAFT")
  snapshot     Json?
  snapshotHash String?   @map("snapshot_hash")
  reviewNote   String?   @map("review_note")
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  history      Json      @default("[]")
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([pilotId, status])
  @@map("pilot_claims")
}

// ─── SKO-422: teacher interpretation of question-level evidence

/// A teacher's reading of one item (paper, version, question) in one curriculum version: a
/// misconception hypothesis citing reviewed answers, a dismissal, or a flag on the item itself.
/// `evidenceHash` freezes the evidence it was made on; a re-review or key correction makes it stale.
model ItemEvidenceDecision {
  id                String    @id @default(uuid())
  schoolId          String    @map("school_id")
  campusId          String    @map("campus_id")
  curriculumId      String    @map("curriculum_id")
  curriculumVersion Int       @map("curriculum_version")
  paperId           String    @map("paper_id")
  paperVersion      Int       @map("paper_version")
  questionId        String    @map("question_id")
  kind              String
  flagCategory      String?   @map("flag_category")
  statement         String
  reason            String
  citedAttemptIds   Json      @default("[]") @map("cited_attempt_ids")
  outcomeIds        Json      @default("[]") @map("outcome_ids")
  evidenceHash      String    @map("evidence_hash")
  status            String    @default("OPEN")
  groupStudentIds   Json      @default("[]") @map("group_student_ids")
  groupReason       String?   @map("group_reason")
  actionPlanIds     Json      @default("[]") @map("action_plan_ids")
  version           Int       @default(1)
  history           Json      @default("[]")
  createdById       String    @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, curriculumId, paperId, paperVersion, questionId])
  @@map("item_evidence_decisions")
}

// ─── SKO-424: marking moderation and independently approved corrections

/// A proposed change to a released result. It is applied only when a different authorized
/// reviewer approves it against the exact result version it was proposed on.
model SchoolAiResultCorrection {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  campusId     String    @map("campus_id")
  assignmentId String    @map("assignment_id")
  attemptId    String    @map("attempt_id")
  fromVersion  Int       @map("from_version")
  review       Json
  previousTotal Float    @map("previous_total")
  proposedTotal Float    @map("proposed_total")
  reason       String    @db.Text
  source       String
  appealId     String?   @map("appeal_id")
  proposedById String    @map("proposed_by_id")
  status       String    @default("PENDING")
  decidedById  String?   @map("decided_by_id")
  decidedAt    DateTime? @map("decided_at")
  decisionNote String?   @map("decision_note") @db.Text
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, campusId, assignmentId, status])
  @@index([attemptId, fromVersion])
  @@map("school_ai_result_corrections")
}

/// A second-marking sample: chosen by a recorded rule, assigned to a reviewer who did not mark the
/// sampled scripts, optionally blind, with a discrepancy threshold that flags scripts for decision.
model SchoolAiModerationSample {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  campusId     String   @map("campus_id")
  assignmentId String   @map("assignment_id")
  method       String
  size         Int
  threshold    Float
  blind        Boolean  @default(true)
  reviewerId   String   @map("reviewer_id")
  createdById  String   @map("created_by_id")
  status       String   @default("OPEN")
  /// [{ attemptId, originalVersion, originalTotal, originalMarkerId, secondMarks, secondTotal, discrepancy, flagged, outcome, note }]
  items        Json
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([schoolId, campusId, assignmentId])
  @@index([reviewerId, status])
  @@map("school_ai_moderation_samples")
}

// ─── SKO-426: practice sessions with hints and spaced revisits (separate from formal grades)

/// One learner's sitting of an approved practice set. Pausing keeps every accepted answer.
model PracticeSession {
  id               String    @id @default(uuid())
  schoolId         String    @map("school_id")
  campusId         String    @map("campus_id")
  studentId        String    @map("student_id")
  practiceRecordId String    @map("practice_record_id")
  revisionId       String    @map("revision_id")
  revisitId        String?   @map("revisit_id")
  status           String    @default("ACTIVE")
  expectedMinutes  Int       @map("expected_minutes")
  startedAt        DateTime  @default(now()) @map("started_at")
  pausedAt         DateTime? @map("paused_at")
  completedAt      DateTime? @map("completed_at")
  summary          Json?
  version          Int       @default(1)

  responses PracticeResponse[]

  @@index([schoolId, studentId, practiceRecordId])
  @@map("practice_sessions")
}

/// One answer. Hints used make it assisted; correctness is only computed for keyed choice items.
model PracticeResponse {
  id          String          @id @default(uuid())
  schoolId    String          @map("school_id")
  sessionId   String          @map("session_id")
  session     PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemKey     String          @map("item_key")
  hintsUsed   Int             @default(0) @map("hints_used")
  answer      String?
  correct     Boolean?
  assisted    Boolean         @default(false)
  confidence  Int?
  explanation String?
  answeredAt  DateTime?       @map("answered_at")

  @@unique([sessionId, itemKey])
  @@map("practice_responses")
}

/// A scheduled return to a practice set: set by the rule, the teacher or (within policy) the learner.
model PracticeRevisit {
  id               String    @id @default(uuid())
  schoolId         String    @map("school_id")
  campusId         String    @map("campus_id")
  studentId        String    @map("student_id")
  practiceRecordId String    @map("practice_record_id")
  dueOn            DateTime  @map("due_on") @db.Date
  originalDueOn    DateTime  @map("original_due_on") @db.Date
  reason           String
  source           String
  status           String    @default("SCHEDULED")
  history          Json      @default("[]")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, studentId, status])
  @@map("practice_revisits")
}

// ─── SKO-429: school policy assistant with cited answers

/// One version of a school policy. Only APPROVED versions whose effective interval contains the
/// question date, whose audience includes the asker and whose campus matches are ever searched.
model SchoolPolicy {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  campusId      String?   @map("campus_id")
  topic         String
  title         String
  office        String
  audience      String
  language      String    @default("en")
  version       Int       @default(1)
  status        String    @default("DRAFT")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  supersedesId  String?   @map("supersedes_id")
  /// [{ id, heading, text }]
  sections      Json
  createdById   String    @map("created_by_id")
  approvedById  String?   @map("approved_by_id")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, status, audience])
  @@index([schoolId, topic])
  @@map("school_policies")
}

/// A question as asked, with the answer exactly as given (status, quoted sections, versions).
model PolicyQuestion {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  campusId      String?   @map("campus_id")
  askedById     String    @map("asked_by_id")
  audience      String
  question      String
  answer        Json
  status        String
  feedback      String?
  feedbackNote  String?   @map("feedback_note")
  escalation    Json?
  escalatedAt   DateTime? @map("escalated_at")
  resolvedAt    DateTime? @map("resolved_at")
  resolvedById  String?   @map("resolved_by_id")
  resolution    String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([schoolId, askedById, createdAt])
  @@index([schoolId, escalatedAt])
  @@map("policy_questions")
}

/// A policy owner's check: this question should be answered from this policy and section.
model PolicyEvalCase {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  question        String
  audience        String
  expectedTopic   String   @map("expected_topic")
  expectedSection String?  @map("expected_section")
  expectNoAnswer  Boolean  @default(false) @map("expect_no_answer")
  createdById     String   @map("created_by_id")
  /// [{ at, passed, status, cited }]
  runs            Json     @default("[]")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([schoolId])
  @@map("policy_eval_cases")
}

// ─── SKO-436: copy-level lending, reservations and versioned fine rules

/// One physical copy of a title. ISBN identifies the title; the barcode identifies this copy.
model BookCopy {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  campusId  String   @map("campus_id")
  bookId    String   @map("book_id")
  barcode   String
  condition String   @default("GOOD")
  status    String   @default("AVAILABLE")
  holdFor   String?  @map("hold_for")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([campusId, barcode])
  @@index([bookId, status])
  @@map("book_copies")
}

/// Loan and fine rules. A new version is added, never edited, and each loan keeps the version it used.
model LibraryLoanPolicy {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  campusId     String   @map("campus_id")
  version      Int
  loanDays     Int      @map("loan_days")
  maxLoans     Int      @map("max_loans")
  maxRenewals  Int      @map("max_renewals")
  graceDays    Int      @map("grace_days")
  finePerDay   Int      @map("fine_per_day")
  fineCap      Int      @map("fine_cap")
  lostCharge   Int      @map("lost_charge")
  holdDays     Int      @map("hold_days")
  currency     String
  /// ["2026-12-25", ...] days on which no fine accrues and nothing falls due
  closures     Json     @default("[]")
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([campusId, version])
  @@map("library_loan_policies")
}

/// A reader's place in the queue for a title. A returned copy is held for the first waiting reader.
model BookReservation {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  campusId   String    @map("campus_id")
  bookId     String    @map("book_id")
  memberId   String    @map("member_id")
  status     String    @default("WAITING")
  copyId     String?   @map("copy_id")
  readyUntil DateTime? @map("ready_until")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([bookId, status, createdAt])
  @@index([memberId, status])
  @@map("book_reservations")
}

/// A fine, lost-copy or damage charge. Waivers record who authorised them and why; handoff to
/// fees is recorded here rather than written into the fee ledger.
model LibraryCharge {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  campusId    String    @map("campus_id")
  issueId     String    @map("issue_id")
  memberId    String    @map("member_id")
  kind        String
  amount      Int
  currency    String
  detail      Json
  status      String    @default("OPEN")
  waivedById  String?   @map("waived_by_id")
  waiverReason String?  @map("waiver_reason")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([issueId, kind])
  @@index([memberId, status])
  @@map("library_charges")
}

// ─── SKO-435: purchasing, budgets, receipts, invoices and assets

/// A cost centre's budget for a period. Committed and spent amounts are computed from orders.
model PurchaseBudget {
  id            String   @id @default(uuid())
  schoolId      String   @map("school_id")
  campusId      String   @map("campus_id")
  costCenter    String   @map("cost_center")
  period        String
  amount        Int
  currency      String
  /// Orders above this total need a principal or administrator; at or below, a campus admin may approve.
  approvalLimit Int      @map("approval_limit")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([campusId, costCenter, period])
  @@map("purchase_budgets")
}

/// A purchase request that becomes an order on approval. Changing an approved order's lines,
/// supplier or total withdraws the approval.
model PurchaseRequest {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  campusId     String    @map("campus_id")
  budgetId     String    @map("budget_id")
  poNumber     String    @map("po_number")
  title        String
  supplierId   String?   @map("supplier_id")
  quoteRef     String?   @map("quote_ref")
  /// [{ itemId?, description, quantity, unitPrice, asset }]
  lines        Json
  /// per line: quantity received so far
  received     Json      @default("[]")
  total        Int
  status       String    @default("DRAFT")
  requestedById String   @map("requested_by_id")
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  approvedHash String?   @map("approved_hash")
  version      Int       @default(1)
  history      Json      @default("[]")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([campusId, poNumber])
  @@index([budgetId, status])
  @@map("purchase_requests")
}

/// One delivery against an order. The idempotency key makes a retried receipt a no-op.
model GoodsReceipt {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  campusId       String   @map("campus_id")
  requestId      String   @map("request_id")
  idempotencyKey String   @map("idempotency_key")
  deliveryNote   String?  @map("delivery_note")
  /// [{ line, quantity, storeId, overDelivered }]
  lines          Json
  discrepancies  Json     @default("[]")
  receivedById   String   @map("received_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([requestId, idempotencyKey])
  @@map("goods_receipts")
}

/// A supplier invoice matched against what was ordered and received.
model SupplierInvoice {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  campusId    String    @map("campus_id")
  requestId   String    @map("request_id")
  supplierId  String?   @map("supplier_id")
  invoiceNo   String    @map("invoice_no")
  amount      Int
  status      String
  issues      Json      @default("[]")
  recordedById String   @map("recorded_by_id")
  resolvedById String?  @map("resolved_by_id")
  resolution  String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([requestId])
  @@index([schoolId, invoiceNo])
  @@map("supplier_invoices")
}

/// A tracked asset with its own tag, custodian/location history and service schedule.
model SchoolAsset {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  campusId      String    @map("campus_id")
  tag           String
  description   String
  requestId     String?   @map("request_id")
  receiptId     String?   @map("receipt_id")
  location      String?
  custodian     String?
  status        String    @default("ACTIVE")
  nextServiceOn DateTime? @map("next_service_on") @db.Date
  history       Json      @default("[]")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([campusId, tag])
  @@map("school_assets")
}

/// A maintenance job. Completing it records the work done and the next due date.
model AssetService {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  assetId     String    @map("asset_id")
  dueOn       DateTime  @map("due_on") @db.Date
  status      String    @default("SCHEDULED")
  work        String?
  completedOn DateTime? @map("completed_on") @db.Date
  nextDueOn   DateTime? @map("next_due_on") @db.Date
  completedById String? @map("completed_by_id")
  cancelReason String?  @map("cancel_reason")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([assetId, status])
  @@map("asset_services")
}

// ─── SKO-434: payroll policies, provider exports, frozen run versions and submissions

/// A versioned, effective-dated payroll policy for one employing entity (campus) and currency. It is
/// a school-configured local rule package, not a certified statutory engine.
model PayrollPolicy {
  id                  String   @id @default(uuid())
  schoolId            String   @map("school_id")
  campusId            String   @map("campus_id")
  entityName          String   @map("entity_name")
  version             Int
  currency            String
  effectiveFrom       DateTime @map("effective_from") @db.Date
  /// e.g. "KSA-demo v2"; shown with scopeNote wherever the policy is used.
  packageLabel        String   @map("package_label")
  scopeNote           String   @map("scope_note")
  /// CALENDAR_DAYS | FIXED_30
  prorationBasis      String   @map("proration_basis")
  /// CALENDAR_DAYS | FIXED_30 — what one unpaid leave day costs
  leaveDivisor        String   @map("leave_divisor")
  leaveYearStartMonth Int      @map("leave_year_start_month")
  /// HALF_UP | DOWN, to the currency's minor unit
  rounding            String
  requireSeparation   Boolean  @default(true) @map("require_separation")
  createdById         String   @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([campusId, version])
  @@index([schoolId])
  @@map("payroll_policies")
}

/// A provider's export mapping. Versions are immutable; a change creates the next version.
model PayrollProvider {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  campusId    String   @map("campus_id")
  code        String
  name        String
  version     Int
  currencies  String[]
  /// [{ header, field }] in export order
  columns     Json
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([campusId, code, version])
  @@index([schoolId])
  @@map("payroll_providers")
}

/// Per-employee payroll identity: provider employee ids and the last working day, if leaving.
model PayrollEmployee {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  campusId    String    @map("campus_id")
  userId      String    @map("user_id")
  /// { providerCode: employeeId }
  providerIds Json      @default("{}") @map("provider_ids")
  leavingDate DateTime? @map("leaving_date") @db.Date
  updatedById String    @map("updated_by_id")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([schoolId, userId])
  @@index([campusId])
  @@map("payroll_employees")
}

/// An authorized one-off earning or deduction for one employee and pay period.
model PayrollAdjustment {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  campusId    String    @map("campus_id")
  userId      String    @map("user_id")
  year        Int
  month       Int
  /// EARNING | DEDUCTION
  kind        String
  label       String
  amount      Int
  reason      String
  enteredById String    @map("entered_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  voidedAt    DateTime? @map("voided_at")
  voidedById  String?   @map("voided_by_id")

  @@index([campusId, year, month])
  @@index([schoolId])
  @@map("payroll_adjustments")
}

/// One version of a pay period's calculation, with its frozen inputs. Approval binds inputHash; a
/// changed input makes an approved version STALE and a new version must be prepared.
model PayrollCalculation {
  id              String    @id @default(uuid())
  schoolId        String    @map("school_id")
  campusId        String    @map("campus_id")
  year            Int
  month           Int
  version         Int
  /// DRAFT | APPROVED | STALE | EXPORTED | SUPERSEDED
  status          String    @default("DRAFT")
  policyId        String    @map("policy_id")
  policyVersion   Int       @map("policy_version")
  currency        String
  entityName      String    @map("entity_name")
  providerId      String    @map("provider_id")
  /// A correction version covers only the rows a provider rejected in this earlier version.
  correctionOfId  String?   @map("correction_of_id")
  scopeUserIds    String[]  @map("scope_user_ids")
  inputs          Json
  inputHash       String    @map("input_hash")
  lines           Json
  exceptions      Json      @default("[]")
  totalNet        Int       @map("total_net")
  preparedById    String    @map("prepared_by_id")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  staleReason     String?   @map("stale_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([campusId, year, month, version])
  @@index([schoolId])
  @@map("payroll_calculations")
}

/// The provider submission of one approved version. A retry reuses the reference and resends only
/// rows without an accepted outcome; exported does not mean paid.
model PayrollSubmission {
  id             String    @id @default(uuid())
  schoolId       String    @map("school_id")
  campusId       String    @map("campus_id")
  calculationId  String    @unique @map("calculation_id")
  reference      String
  /// SUBMITTED | PARTIAL | ACKNOWLEDGED | REJECTED
  status         String    @default("SUBMITTED")
  file           String
  /// [{ userId, providerEmployeeId, net, outcome: PENDING|ACCEPTED|REJECTED, reason? }]
  rows           Json
  attempts       Int       @default(1)
  history        Json      @default("[]")
  submittedById  String    @map("submitted_by_id")
  submittedAt    DateTime  @default(now()) @map("submitted_at")
  lastAttemptAt  DateTime  @default(now()) @map("last_attempt_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  @@unique([schoolId, reference])
  @@map("payroll_submissions")
}

// ─── SKO-453: capacity and staffing scenario planning (never writes live records)

/// A dated, versioned snapshot of a campus's enrollment, rooms, periods, staff and subject demand.
model PlanningBaseline {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  campusId     String   @map("campus_id")
  version      Int
  takenAt      DateTime @default(now()) @map("taken_at")
  /// hash of the live inputs; a different live hash means the baseline is stale
  fingerprint  String
  data         Json
  /// [{ code, detail }] — inputs that were missing when the snapshot was taken
  missing      Json     @default("[]")
  createdById  String   @map("created_by_id")

  @@unique([campusId, version])
  @@index([schoolId])
  @@map("planning_baselines")
}

/// Assumptions evaluated against one baseline. Changing assumptions recomputes the result only.
model PlanningScenario {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  campusId     String   @map("campus_id")
  baselineId   String   @map("baseline_id")
  name         String
  assumptions  Json
  result       Json
  version      Int      @default(1)
  /// set when this scenario was copied onto a newer baseline
  copiedFromId String?  @map("copied_from_id")
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([campusId, baselineId])
  @@index([schoolId])
  @@map("planning_scenarios")
}

/// A reviewed implementation plan from a scenario. Approval re-checks live resources; it never
/// changes enrollment, staffing or timetables itself.
model PlanningHandoff {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  campusId      String    @map("campus_id")
  scenarioId    String    @map("scenario_id")
  scenarioVersion Int     @map("scenario_version")
  ownerId       String    @map("owner_id")
  /// [{ kind, detail, estimate? }]
  items         Json
  note          String
  /// PROPOSED | APPROVED | REJECTED
  status        String    @default("PROPOSED")
  proposedById  String    @map("proposed_by_id")
  decidedById   String?   @map("decided_by_id")
  decidedAt     DateTime? @map("decided_at")
  decisionNote  String?   @map("decision_note")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([scenarioId])
  @@index([schoolId])
  @@map("planning_handoffs")
}

// ─── SKO-454: teacher question review network. Platform-global by design: items cross schools, so
// every read and write enforces school, audience, network membership and embargo explicitly.

/// An invited network of schools that review and reuse each other's shared questions.
model QuestionNetwork {
  id            String   @id @default(uuid())
  name          String
  ownerSchoolId String   @map("owner_school_id")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([ownerSchoolId])
  @@map("question_networks")
}

model QuestionNetworkMember {
  id             String    @id @default(uuid())
  networkId      String    @map("network_id")
  memberSchoolId String    @map("member_school_id")
  /// INVITED | ACTIVE
  status         String    @default("INVITED")
  invitedById    String    @map("invited_by_id")
  acceptedById   String?   @map("accepted_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  acceptedAt     DateTime? @map("accepted_at")

  @@unique([networkId, memberSchoolId])
  @@index([memberSchoolId])
  @@map("question_network_members")
}

/// One version of a shared question: a de-identified copy of an approved bank question with its
/// rights, audience and provenance. The answer key is stored apart and only served to teaching staff.
model QuestionNetworkItem {
  id                  String    @id @default(uuid())
  /// stable across versions, e.g. Q-3F9A21
  shareKey            String    @map("share_key")
  version             Int
  contributorSchoolId String    @map("contributor_school_id")
  contributorCampusId String    @map("contributor_campus_id")
  contributedById     String    @map("contributed_by_id")
  /// { paperId, paperVersion, questionId, paperTitle, approvedAt }
  source              Json
  /// SCHOOL | NETWORK | PUBLIC
  audience            String
  networkId           String?   @map("network_id")
  /// { basis, holder, licence, attribution, permits, confirmedById, confirmedAt }
  rights              Json
  /// { subject, grade, curriculum, language }
  tags                Json
  content             Json
  answerKey           Json      @map("answer_key")
  /// AWAITING_AUTHORITY | IN_REVIEW | CHANGES_REQUESTED | PUBLISHED | SUPERSEDED | WITHDRAWN
  status              String
  embargoUntil        DateTime? @map("embargo_until")
  authorizedById      String?   @map("authorized_by_id")
  correctionOfId      String?   @map("correction_of_id")
  changeNote          String?   @map("change_note")
  adjudication        Json?
  publishedAt         DateTime? @map("published_at")
  withdrawnAt         DateTime? @map("withdrawn_at")
  withdrawReason      String?   @map("withdraw_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([shareKey, version])
  @@index([contributorSchoolId])
  @@index([status, audience])
  @@map("question_network_items")
}

/// A reviewer's decision on one version, with declared expertise and any conflict of interest.
model QuestionNetworkReview {
  id               String   @id @default(uuid())
  itemId           String   @map("item_id")
  version          Int
  reviewerId       String   @map("reviewer_id")
  reviewerSchoolId String   @map("reviewer_school_id")
  /// { subject, language }
  expertise        Json
  conflict         Boolean  @default(false)
  conflictNote     String?  @map("conflict_note")
  /// [{ code, detail }]
  issues           Json     @default("[]")
  /// APPROVE | REQUEST_CHANGES | REJECT
  decision         String
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([itemId, reviewerId])
  @@map("question_network_reviews")
}

/// A school's adoption of a shared question. The adopted version stays fixed until the school accepts
/// a correction; completed assessments are never touched.
model QuestionNetworkAdoption {
  id              String   @id @default(uuid())
  shareKey        String   @map("share_key")
  itemId          String   @map("item_id")
  adopterSchoolId String   @map("adopter_school_id")
  adoptedById     String   @map("adopted_by_id")
  /// ACTIVE | CORRECTION_AVAILABLE | WITHDRAWN_UPSTREAM
  status          String   @default("ACTIVE")
  history         Json     @default("[]")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([adopterSchoolId, shareKey])
  @@index([itemId])
  @@map("question_network_adoptions")
}

/// Aggregated use evidence a school reports for a version: counts and a mean score only, no learners.
model QuestionNetworkStat {
  id               String   @id @default(uuid())
  shareKey         String   @map("share_key")
  version          Int
  reporterSchoolId String   @map("reporter_school_id")
  reportedById     String   @map("reported_by_id")
  sampleSize       Int      @map("sample_size")
  /// mean proportion of marks, 0..1
  meanScore        Float    @map("mean_score")
  context          String
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([shareKey, version, reporterSchoolId, context])
  @@map("question_network_stats")
}

// ─── SKO-455: careers, counselling and alumni pathways

/// Staff designated by a school leader to hold counselling appointments and confidential notes.
model PathwayCounsellor {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  campusId    String    @map("campus_id")
  userId      String    @map("user_id")
  grantedById String    @map("granted_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  @@index([schoolId, userId])
  @@map("pathway_counsellors")
}

/// A goal the student owns. `audience` lists who besides the student may see it: COUNSELLOR, GUARDIAN.
model PathwayGoal {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  campusId     String    @map("campus_id")
  studentId    String    @map("student_id")
  title        String
  detail       String?
  audience     String[]
  /// ACTIVE | ACHIEVED | ARCHIVED
  status       String    @default("ACTIVE")
  nextReviewOn DateTime? @map("next_review_on") @db.Date
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, studentId])
  @@map("pathway_goals")
}

/// A next action with a deadline and an owner. No likelihood or prediction is ever stored.
model PathwayAction {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  goalId        String    @map("goal_id")
  studentId     String    @map("student_id")
  title         String
  /// STUDENT | COUNSELLOR | GUARDIAN
  owner         String
  dueOn         DateTime  @map("due_on") @db.Date
  opportunityId String?   @map("opportunity_id")
  evidenceLink  String?   @map("evidence_link")
  /// OPEN | DONE
  status        String    @default("OPEN")
  doneAt        DateTime? @map("done_at")
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([goalId])
  @@map("pathway_actions")
}

/// An opportunity with its source and when it was last checked.
model PathwayOpportunity {
  id             String    @id @default(uuid())
  schoolId       String    @map("school_id")
  campusId       String    @map("campus_id")
  title          String
  provider       String
  /// UNIVERSITY | SCHOLARSHIP | INTERNSHIP | COURSE | OTHER
  kind           String
  sourceUrl      String    @map("source_url")
  eligibility    String
  deadline       DateTime? @map("deadline") @db.Date
  lastVerifiedAt DateTime  @map("last_verified_at")
  verifiedById   String    @map("verified_by_id")
  /// ACTIVE | WITHDRAWN
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([schoolId, campusId, status])
  @@map("pathway_opportunities")
}

/// A counselling appointment. The general calendar shows only `publicLabel`.
model CounsellingAppointment {
  id            String   @id @default(uuid())
  schoolId      String   @map("school_id")
  campusId      String   @map("campus_id")
  studentId     String   @map("student_id")
  counsellorId  String   @map("counsellor_id")
  startsAt      DateTime @map("starts_at")
  minutes       Int
  publicLabel   String   @map("public_label")
  /// REQUESTED | CONFIRMED | HELD | CANCELLED
  status        String   @default("REQUESTED")
  requestedById String   @map("requested_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([schoolId, counsellorId, startsAt])
  @@index([schoolId, studentId])
  @@map("counselling_appointments")
}

/// Confidential counselling notes: designated counsellors only, every read logged, never exported.
model CounsellingNote {
  id            String   @id @default(uuid())
  schoolId      String   @map("school_id")
  campusId      String   @map("campus_id")
  studentId     String   @map("student_id")
  appointmentId String?  @map("appointment_id")
  authorId      String   @map("author_id")
  body          String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([schoolId, studentId])
  @@map("counselling_notes")
}

/// An alumnus who opted in. Contact details stay with designated staff; mentoring is school-mediated.
model AlumniProfile {
  id                 String    @id @default(uuid())
  schoolId           String    @map("school_id")
  campusId           String    @map("campus_id")
  studentId          String?   @map("student_id")
  displayName        String    @map("display_name")
  pathway            String
  contactEmail       String    @map("contact_email")
  dateOfBirth        DateTime  @map("date_of_birth") @db.Date
  /// STAFF_ONLY | STUDENTS
  visibility         String
  mentoring          Boolean   @default(false)
  consentEvidence    String    @map("consent_evidence")
  consentGivenAt     DateTime  @map("consent_given_at")
  consentWithdrawnAt DateTime? @map("consent_withdrawn_at")
  reviewDueOn        DateTime  @map("review_due_on") @db.Date
  recordedById       String    @map("recorded_by_id")
  history            Json      @default("[]")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, campusId])
  @@map("alumni_profiles")
}

/// A student's request to meet an alumnus, reviewed by a designated counsellor. Introductions are
/// always school-mediated; no contact details reach the student.
model MentoringRequest {
  id                   String    @id @default(uuid())
  schoolId             String    @map("school_id")
  campusId             String    @map("campus_id")
  reference            String
  studentId            String    @map("student_id")
  alumniId             String    @map("alumni_id")
  purpose              String
  /// REQUESTED | CLARIFY | APPROVED | DECLINED | CANCELLED
  status               String    @default("REQUESTED")
  requestedById        String    @map("requested_by_id")
  reviewedById         String?   @map("reviewed_by_id")
  reviewNote           String?   @map("review_note")
  guardianConsent      Boolean   @default(false) @map("guardian_consent")
  safeguardingChecked  Boolean   @default(false) @map("safeguarding_checked")
  decidedAt            DateTime? @map("decided_at")
  history              Json      @default("[]")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@unique([schoolId, reference])
  @@index([schoolId, alumniId, status])
  @@map("mentoring_requests")
}

// SKO-450: improvement and accreditation evidence. A framework is a school-configured reference (name + version);
// evidence points at one source record and the version it had when linked; actions reference SKO-425 plans
// without changing them; packs freeze a manifest with a digest. No accreditation outcome is ever stored.
model EvidenceFramework {
  id          String   @id @default(uuid())
  schoolId    String   @default("") @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String?  @map("campus_id")
  name        String
  version     String
  status      String   @default("ACTIVE") // ACTIVE, RETIRED
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  criteria    EvidenceCriterion[]
  items       EvidenceItem[]
  actions     ImprovementAction[]
  grants      EvidenceReviewerGrant[]
  packs       EvidencePack[]

  @@unique([schoolId, name, version])
  @@map("evidence_frameworks")
}

model EvidenceCriterion {
  id                         String            @id @default(uuid())
  schoolId                   String            @default("") @map("school_id")
  frameworkId                String            @map("framework_id")
  framework                  EvidenceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  code                       String
  title                      String
  interpretation             String?           @db.Text
  interpretationApprovedById String?           @map("interpretation_approved_by_id")
  interpretationApprovedAt   DateTime?         @map("interpretation_approved_at")
  sortOrder                  Int               @default(0) @map("sort_order")

  @@unique([frameworkId, code])
  @@index([schoolId])
  @@map("evidence_criteria")
}

model EvidenceItem {
  id            String            @id @default(uuid())
  schoolId      String            @default("") @map("school_id")
  frameworkId   String            @map("framework_id")
  framework     EvidenceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  criterionIds  String[]          @map("criterion_ids")
  sourceType    String            @map("source_type") // INTERVENTION, REPORT_CARD, CLINIC_VISIT, CARE_PLAN, DOCUMENT
  sourceId      String?           @map("source_id")
  sourceVersion String            @map("source_version")
  sourceDate    DateTime          @map("source_date") @db.Date
  title         String
  note          String?           @db.Text
  ownerId       String            @map("owner_id")
  audience      String            @default("STAFF") // STAFF, REVIEWER, EXTERNAL
  sensitivity   String            @default("NONE") // NONE, PUPIL, CLINIC
  stance        String            @default("SUPPORTS") // SUPPORTS, CONTRADICTS
  reviewBy      DateTime          @map("review_by") @db.Date
  reviewState   String            @default("PENDING") @map("review_state") // PENDING, ACCEPTED, MORE_REQUESTED
  reviewedById  String?           @map("reviewed_by_id")
  reviewedAt    DateTime?         @map("reviewed_at")
  reviewNote    String?           @map("review_note") @db.Text
  createdById   String            @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([schoolId, frameworkId])
  @@map("evidence_items")
}

model ImprovementAction {
  id                   String            @id @default(uuid())
  schoolId             String            @default("") @map("school_id")
  frameworkId          String            @map("framework_id")
  framework            EvidenceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  criterionIds         String[]          @map("criterion_ids")
  title                String
  ownerId              String            @map("owner_id")
  dueDate              DateTime          @map("due_date") @db.Date
  expectedMeasure      String            @map("expected_measure") @db.Text
  interventionPlanId   String?           @map("intervention_plan_id")
  milestones           Json              @default("[]")
  reassessment         Json?
  reflection           String?           @db.Text
  status               String            @default("OPEN") // OPEN, COMPLETED
  completionEvidenceId String?           @map("completion_evidence_id")
  completedById        String?           @map("completed_by_id")
  completedAt          DateTime?         @map("completed_at")
  version              Int               @default(1)
  createdById          String            @map("created_by_id")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([schoolId, frameworkId])
  @@map("improvement_actions")
}

model EvidenceReviewerGrant {
  id           String            @id @default(uuid())
  schoolId     String            @default("") @map("school_id")
  frameworkId  String            @map("framework_id")
  framework    EvidenceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  userId       String            @map("user_id")
  criterionIds String[]          @map("criterion_ids")
  expiresAt    DateTime          @map("expires_at")
  revokedAt    DateTime?         @map("revoked_at")
  grantedById  String            @map("granted_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([schoolId, userId])
  @@map("evidence_reviewer_grants")
}

model EvidencePack {
  id          String            @id @default(uuid())
  schoolId    String            @default("") @map("school_id")
  frameworkId String            @map("framework_id")
  framework   EvidenceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  version     Int
  audience    String // STAFF, EXTERNAL
  manifest    Json
  digest      String
  createdById String            @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@unique([frameworkId, version])
  @@index([schoolId])
  @@map("evidence_packs")
}

// ─── SKO-456: optional canteen, boarding and specialist packages per campus

/// An optional package for one campus: named operators, a setup checklist, and enable, disable and
/// archive steps. Disabled stops new transactions; archive needs every obligation closed.
model CampusPackage {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  campusId    String    @map("campus_id")
  /// CANTEEN | BOARDING | SPECIALIST
  package     String
  /// SETUP | ENABLED | DISABLED | ARCHIVED
  status      String    @default("SETUP")
  /// { ROLE: [userId] }
  operators   Json      @default("{}")
  /// { itemKey: { by, at, note } }
  checklist   Json      @default("{}")
  settings    Json      @default("{}")
  enabledById String?   @map("enabled_by_id")
  enabledAt   DateTime? @map("enabled_at")
  history     Json      @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([campusId, package])
  @@index([schoolId])
  @@map("campus_packages")
}

/// One meal on one service date, with a fixed capacity and declared allergens.
model CanteenItem {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  campusId    String   @map("campus_id")
  serviceDate DateTime @map("service_date") @db.Date
  name        String
  price       Int
  currency    String
  capacity    Int
  sold        Int      @default(0)
  allergens   String[]
  /// ACTIVE | WITHDRAWN
  status      String   @default("ACTIVE")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId, serviceDate])
  @@map("canteen_items")
}

/// A meal order. HOLD means trained staff must check it against the student's dietary record first.
model CanteenOrder {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  campusId       String   @map("campus_id")
  itemId         String   @map("item_id")
  studentId      String   @map("student_id")
  quantity       Int
  amount         Int
  currency       String
  /// PLACED | HOLD | CANCELLED | SERVED
  status         String
  holdReason     String?  @map("hold_reason")
  idempotencyKey String   @map("idempotency_key")
  orderedById    String   @map("ordered_by_id")
  history        Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, studentId])
  @@index([itemId])
  @@map("canteen_orders")
}

/// The charge and refund of an order, each at most once.
model CanteenLedgerEntry {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  campusId    String   @map("campus_id")
  studentId   String   @map("student_id")
  orderId     String   @map("order_id")
  /// CHARGE | REFUND
  kind        String
  amount      Int
  currency    String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([orderId, kind])
  @@index([schoolId, studentId])
  @@map("canteen_ledger_entries")
}

/// A guardian's daily canteen spending limit for a student.
model CanteenSpendLimit {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  studentId  String   @map("student_id")
  dailyLimit Int      @map("daily_limit")
  setById    String   @map("set_by_id")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, studentId])
  @@map("canteen_spend_limits")
}

/// Dietary and allergen information with its source and date. Restricted to the campus dietary lead
/// and the student's guardians; never a guarantee of allergen safety.
model DietaryRecord {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  campusId      String    @map("campus_id")
  studentId     String    @map("student_id")
  allergens     String[]
  diet          String?
  /// GUARDIAN | CLINIC | DOCTOR_LETTER
  source        String
  sourceDate    DateTime  @map("source_date") @db.Date
  /// NEEDS_CONFIRMATION | CONFIRMED | UNCERTAIN
  status        String    @default("NEEDS_CONFIRMATION")
  recordedById  String    @map("recorded_by_id")
  confirmedById String?   @map("confirmed_by_id")
  confirmedAt   DateTime? @map("confirmed_at")
  history       Json      @default("[]")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([schoolId, studentId])
  @@map("dietary_records")
}

/// Authorized boarding leave with departure and return handovers.
model BoardingLeave {
  id               String    @id @default(uuid())
  schoolId         String    @map("school_id")
  campusId         String    @map("campus_id")
  studentId        String    @map("student_id")
  departAt         DateTime  @map("depart_at")
  expectedReturnAt DateTime  @map("expected_return_at")
  destination      String
  collectedBy      String    @map("collected_by")
  approvedById     String    @map("approved_by_id")
  /// PLANNED | OUT | RETURNED | CANCELLED
  status           String    @default("PLANNED")
  departedAt       DateTime? @map("departed_at")
  returnedAt       DateTime? @map("returned_at")
  returnedTo       String?   @map("returned_to")
  receivedById     String?   @map("received_by_id")
  lateReason       String?   @map("late_reason")
  history          Json      @default("[]")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([schoolId, campusId, status])
  @@map("boarding_leaves")
}

/// A boarding roll call. Missing students and overdue returns become exceptions for designated staff.
model BoardingRollCall {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  campusId   String   @map("campus_id")
  label      String
  takenAt    DateTime @default(now()) @map("taken_at")
  takenById  String   @map("taken_by_id")
  /// [{ studentId, status: PRESENT | ABSENT | ON_LEAVE }]
  entries    Json
  /// [{ studentId, kind: MISSING | LEAVE_OVERDUE, resolvedAt?, resolution?, resolvedById? }]
  exceptions Json     @default("[]")

  @@index([schoolId, campusId, takenAt])
  @@map("boarding_roll_calls")
}

// SKO-451: platform capacity. A resource policy is an operator's scoped, expiring, audited limit on background
// work (platform default when targetSchoolId is null); revoking it restores the previous effective value. A
// performance run records one measured workload against its objectives; neither implies a capacity claim.
model ResourcePolicy {
  id             String    @id @default(uuid())
  targetSchoolId String?   @map("target_school_id")
  scope          String // BACKGROUND_REQUESTS, BACKGROUND_JOBS
  limitValue     Int       @map("limit_value")
  reason         String    @db.Text
  expiresAt      DateTime? @map("expires_at")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")
  revokedById    String?   @map("revoked_by_id")
  revokeReason   String?   @map("revoke_reason") @db.Text

  @@index([targetSchoolId, scope])
  @@map("resource_policies")
}

model PerformanceRun {
  id           String   @id @default(uuid())
  runId        String   @unique @map("run_id")
  profile      String
  environment  String
  release      String
  dataset      Json
  concurrency  Json
  results      Json
  objectives   Json
  passed       Boolean
  policyIds    String[] @map("policy_ids")
  notes        String?  @db.Text
  startedAt    DateTime @map("started_at")
  finishedAt   DateTime @map("finished_at")
  recordedById String   @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("performance_runs")
}

// ─── SKO-472: assessment repair map. A flawed released question is repaired through the existing owners
// (result revisions, gradebook marks, report successors, learning actions, family notices). The repair stores
// the deterministic impact, a fingerprint of every record it read, the ordered plan and a durable per-step
// receipt, so a stale preview is refused and an interrupted repair resumes without repeating a step.
model SchoolAiAssessmentRepair {
  id                String    @id @default(uuid())
  schoolId          String    @map("school_id")
  campusId          String    @map("campus_id")
  assignmentId      String    @map("assignment_id")
  paperVersion      Int       @map("paper_version")
  questionId        String    @map("question_id")
  correction        Json
  reason            String    @db.Text
  publicExplanation String    @map("public_explanation") @db.Text
  status            String    @default("PENDING_REVIEW") // PENDING_REVIEW, APPLYING, APPLIED, PARTIAL, REJECTED, STALE
  fingerprint       String
  impact            Json
  plan              Json
  receipt           Json      @default("[]")
  idempotencyKey    String    @map("idempotency_key")
  proposedById      String    @map("proposed_by_id")
  decidedById       String?   @map("decided_by_id")
  decidedAt         DateTime? @map("decided_at")
  decisionNote      String?   @map("decision_note") @db.Text
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, campusId, assignmentId, status])
  @@map("school_ai_assessment_repairs")
}

// ─── SKO-471: learning transfer bridge. A receiving school imports permissioned evidence from another
// school or curriculum for a learner it already enrolls (no new identity, no universal score, no automatic
// placement). One case per learner and source learner reference: a replayed export is the same case; a new
// source version makes every mapping and the bridge stale. Reading the evidence needs a guardian's current
// consent; teachers review every mapping (one-to-many and "not comparable" allowed) before a bridge plan.
model LearningTransferCase {
  id                   String    @id @default(uuid())
  schoolId             String    @map("school_id")
  campusId             String    @map("campus_id")
  studentId            String    @map("student_id")
  sourceInstitution    String    @map("source_institution")
  sourceLearnerRef     String    @map("source_learner_ref")
  sourceCurriculumId   String    @map("source_curriculum_id")
  sourceCurriculumName String    @map("source_curriculum_name")
  sourceVersion        String    @map("source_version")
  sourceLanguage       String?   @map("source_language")
  sourceHash           String    @map("source_hash")
  evidence             Json
  destinationRecordId  String?   @map("destination_record_id")
  destinationVersion   Int?      @map("destination_version")
  consentGuardianId    String?   @map("consent_guardian_id")
  consentScope         Json      @default("[]") @map("consent_scope")
  consentGrantedAt     DateTime? @map("consent_granted_at")
  consentExpiresAt     DateTime? @map("consent_expires_at")
  consentRevokedAt     DateTime? @map("consent_revoked_at")
  status               String    @default("DRAFT") // DRAFT, MAPPING, PLANNED, STALE
  bridge               Json?
  bridgePlanId         String?   @map("bridge_plan_id")
  downloads            Json      @default("[]")
  createdById          String    @map("created_by_id")
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  mappings             LearningTransferMapping[]

  @@unique([schoolId, studentId, sourceInstitution, sourceLearnerRef])
  @@index([schoolId, campusId, status])
  @@map("learning_transfer_cases")
}

model LearningTransferMapping {
  id                     String    @id @default(uuid())
  schoolId               String    @map("school_id")
  caseId                 String    @map("case_id")
  transferCase           LearningTransferCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceObjectiveId      String    @map("source_objective_id")
  sourceObjectiveVersion String    @map("source_objective_version")
  sourceVersion          String    @map("source_version")
  destinationVersion     Int?      @map("destination_version")
  targetOutcomeIds       Json      @default("[]") @map("target_outcome_ids")
  suggestion             Json?
  decision               String    @default("PROPOSED") // PROPOSED, ACCEPTED, NOT_COMPARABLE, REJECTED
  note                   String?   @db.Text
  stale                  Boolean   @default(false)
  reviewedById           String?   @map("reviewed_by_id")
  reviewedAt             DateTime? @map("reviewed_at")
  version                Int       @default(1)

  @@unique([caseId, sourceObjectiveId])
  @@index([schoolId, caseId])
  @@map("learning_transfer_mappings")
}

// ─── SKO-500 (SKO-408 slice 1): the Exam Chain — taught boundary and paper slots ───
/// The teacher's dated "taught up to here", kept beside the approved curriculum and never inside it.
model TeachingProgress {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  campusId          String   @map("campus_id")
  subjectId         String   @map("subject_id")
  classId           String   @map("class_id")
  curriculumId      String   @map("curriculum_id")
  curriculumVersion Int      @map("curriculum_version")
  outcomeId         String   @map("outcome_id")
  taughtOn          DateTime @map("taught_on") @db.Date
  recordedAt        DateTime @default(now()) @map("recorded_at")
  timetableSlotId   String?  @map("timetable_slot_id")
  teacherId         String   @map("teacher_id")
  note              String?  @db.Text
  evidenceSourceId  String?  @map("evidence_source_id")

  @@unique([schoolId, campusId, subjectId, classId, curriculumId, outcomeId])
  @@index([schoolId, campusId, subjectId, classId, taughtOn])
  @@map("teaching_progress")
}

/// One paper for one subject of one grade in one term exam: the office's request and the chain's ledger row.
/// Status is derived from the linked records (src/lib/school-ai/paper-slot-status.ts), never stored.
model ExamPaperSlot {
  id                String      @id @default(uuid())
  schoolId          String      @map("school_id")
  campusId          String      @map("campus_id")
  examSessionId     String      @map("exam_session_id")
  examSession       ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  subjectName       String      @map("subject_name")
  gradeName         String      @map("grade_name")
  schedules         ExamSchedule[]
  requestedById     String      @map("requested_by_id")
  requestedAt       DateTime    @default(now()) @map("requested_at")
  dueOn             DateTime    @map("due_on") @db.Date
  marksDueOn        DateTime?   @map("marks_due_on") @db.Date
  totalMarks        Int         @map("total_marks")
  durationMinutes   Int         @map("duration_minutes")
  deliveryKind      String      @default("PAPER") @map("delivery_kind")
  languages         Json        @default("[\"en\"]")
  formCount         Int         @default(1) @map("form_count")
  coverageRule      String      @default("TAUGHT") @map("coverage_rule")
  explicitCoverage  Json?       @map("explicit_coverage")
  authorUserId      String?     @map("author_user_id")
  moderatorUserId   String?     @map("moderator_user_id")
  markerOverrides   Json?       @map("marker_overrides")
  briefRecordId     String?     @map("brief_record_id")
  paperRecordId     String?     @map("paper_record_id")
  paperVersion      Int?        @map("paper_version")
  formReleaseId     String?     @map("form_release_id")
  sealedAt          DateTime?   @map("sealed_at")
  sealedSittingDate DateTime?   @map("sealed_sitting_date") @db.Date
  copiesRequested   Int?        @map("copies_requested")
  printedById       String?     @map("printed_by_id")
  printedAt         DateTime?   @map("printed_at")
  printedHash       String?     @map("printed_hash")
  cancelledAt       DateTime?   @map("cancelled_at")
  cancelReason      String?     @map("cancel_reason")
  lastNudgeAt       DateTime?   @map("last_nudge_at")
  nudgeCount        Int         @default(0) @map("nudge_count")
  /// SKO-501: the Seal. The content hash the approver sealed, who sealed it and why.
  sealHash          String?     @map("seal_hash")
  sealedById        String?     @map("sealed_by_id")
  sealReason        String?     @map("seal_reason") @db.Text
  /// SKO-501: a sealed paper reported compromised (cancel the sitting or release the reserve form).
  compromisedAt     DateTime?   @map("compromised_at")
  compromiseReason  String?     @map("compromise_reason") @db.Text
  /// SKO-501: corrigenda against the seal: [{ id, text, questionId?, at, byId, hashPrefix }], read out in every room.
  corrigenda        Json        @default("[]")
  /// SKO-503: spare copies per print run, as a percentage of candidates (default 5).
  spareCopiesPercent Int        @default(5) @map("spare_copies_percent")
  moderations       ExamPaperModeration[]
  version           Int         @default(1)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@unique([examSessionId, subjectName, gradeName])
  @@index([schoolId, campusId, authorUserId, dueOn])
  @@index([schoolId, campusId, moderatorUserId])
  @@map("exam_paper_slots")
}

/// SKO-503: a printed script for one candidate of a paper sitting (one per date-sheet row and pupil).
/// The cover's QR carries a signed code naming this row; a script is scanned once; marks are entered
/// per question after the teacher marks the paper by hand.
model ExamPaperScript {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  campusId     String    @map("campus_id")
  slotId       String    @map("slot_id")
  scheduleId   String    @map("schedule_id")
  studentId    String    @map("student_id")
  candidateNo  Int       @map("candidate_no")
  sealPrefix   String    @map("seal_prefix")
  printedAt    DateTime  @default(now()) @map("printed_at")
  scannedAt    DateTime? @map("scanned_at")
  scannedById  String?   @map("scanned_by_id")
  pageKeys     Json      @default("[]") @map("page_keys")
  marks        Json?     // { questionId: number }
  total        Float?
  markedById   String?   @map("marked_by_id")
  markedAt     DateTime? @map("marked_at")
  version      Int       @default(1)

  @@unique([scheduleId, studentId])
  @@index([schoolId, campusId, slotId])
  @@map("exam_paper_scripts")
}

/// SKO-503: the room sheet. ABSENT is authoritative: no mark can be entered until the office reopens it.
model ExamAttendance {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  campusId     String    @map("campus_id")
  scheduleId   String    @map("schedule_id")
  studentId    String    @map("student_id")
  status       String    // PRESENT | ABSENT
  recordedById String    @map("recorded_by_id")
  recordedAt   DateTime  @default(now()) @map("recorded_at")
  reopenedAt   DateTime? @map("reopened_at")
  reopenedById String?   @map("reopened_by_id")
  reopenReason String?   @map("reopen_reason") @db.Text

  @@unique([scheduleId, studentId])
  @@index([schoolId, campusId, scheduleId])
  @@map("exam_attendance")
}

/// SKO-503: one print of a sealed paper for a section or room: covers equal to candidates, copies with spares.
model ExamPrintRun {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  campusId    String   @map("campus_id")
  slotId      String   @map("slot_id")
  scheduleId  String   @map("schedule_id")
  groupLabel  String   @map("group_label")
  candidates  Int
  copies      Int
  sealPrefix  String   @map("seal_prefix")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId, slotId])
  @@map("exam_print_runs")
}

/// SKO-501: a moderator's decision on a requested paper, bound to the exact content it was taken on.
/// The content hash (not the record version) is the binding, so an approval's version bump does not
/// undo a signature while any content change does.
model ExamPaperModeration {
  id            String        @id @default(uuid())
  schoolId      String        @map("school_id")
  campusId      String        @map("campus_id")
  slotId        String        @map("slot_id")
  slot          ExamPaperSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  paperRecordId String        @map("paper_record_id")
  paperVersion  Int           @map("paper_version")
  contentHash   String        @map("content_hash")
  decision      String        // SIGNED | RETURNED
  comments      Json          @default("[]")   // [{ questionId?, text }]
  conformance   Json          @default("[]")   // the report the moderator saw
  moderatorId   String        @map("moderator_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([schoolId, campusId, slotId, createdAt])
  @@map("exam_paper_moderations")
}

/// SKO-504: one sentence per learner per sitting for the family, in the guardian's language, drafted
/// from that learner's own moderated marks (`deriveFeedback`), edited by the teacher and sent explicitly.
/// Families read only SENT notes; sending waits for the report card unless the session opts in.
model FamilyResultNote {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  campusId      String    @map("campus_id")
  assignmentId  String    @map("assignment_id")
  attemptId     String    @map("attempt_id")
  studentId     String    @map("student_id")
  resultVersion Int       @map("result_version")
  language      String    @default("en")
  sentence      String    @db.Text
  status        String    @default("DRAFT") // DRAFT | SENT
  createdById   String    @map("created_by_id")
  sentById      String?   @map("sent_by_id")
  sentAt        DateTime? @map("sent_at")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([attemptId])
  @@index([schoolId, campusId, assignmentId])
  @@index([schoolId, studentId, status])
  @@map("family_result_notes")
}

/// SKO-505 Family Exam Brief: a guardian's acknowledgement of one published date-sheet version for one child.
/// Families of children whose papers changed are asked to acknowledge; the office reads who has.
model ExamBriefReceipt {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  campusId       String   @map("campus_id")
  versionId      String   @map("version_id")
  studentId      String   @map("student_id")
  guardianUserId String   @map("guardian_user_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  @@unique([versionId, studentId, guardianUserId])
  @@index([schoolId, versionId])
  @@map("exam_brief_receipts")
}
