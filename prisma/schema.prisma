  auditLogs                     SuperAdminAuditLog[]     @relation("AuditLogUser")
  loginSessions                 LoginSession[]           @relation("UserSessions")
  passwordHistory               PasswordHistory[]        @relation("PasswordHistory")
  teacherAttendance             TeacherAttendance[]      @relation("TeacherAttendanceUser")
  notifications                 Notification[]           @relation("UserNotifications")
  lastLogin                     DateTime?                @map("last_login")
  lastPasswordChange            DateTime?                @map("last_password_change")
  assignedQueries               AdmissionQuery[]         @relation("QueryAssignee")
  queryFollowUps                AdmissionQueryFollowUp[] @relation("QueryFollowUpActor")
  staffProfile                  StaffProfile?
  managedStaff                  StaffProfile[]           @relation("StaffManager")
  headedDepartments             Department[]             @relation("DepartmentHead")
  departmentMemberships         DepartmentMember[]
  staffAppointments             StaffAppointment[]       @relation("StaffAppointments")
  appointmentsAsManager         StaffAppointment[]       @relation("AppointmentManager")
  approvedAppointments          StaffAppointment[]       @relation("AppointmentApprover")
  secondaryReportingLines       StaffReportingLine[]     @relation("SecondaryReports")
  secondaryDirectReports        StaffReportingLine[]     @relation("SecondaryManagers")
  staffDocuments                StaffDocument[]
  staffTimelineEvents           StaffTimelineEvent[]
  leaveAllocations              LeaveAllocation[]
  leaveRequests                 LeaveRequest[]
  reviewedLeaveRequests         LeaveRequest[]           @relation("LeaveReviewedBy")
  payrollLines                  PayrollLine[]
