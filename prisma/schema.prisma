  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([schoolId, campusId, status])
  @@index([relatedType, relatedId])
  @@map("ai_review_items")
}

model InterventionPlan {
  id              String    @id @default(uuid())
  schoolId        String    @default("") @map("school_id")
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String    @map("campus_id")
  studentId       String?   @map("student_id")
  createdBy       String    @map("created_by")
  title           String
  summary         String    @db.Text
  recommendations Json?
  status          String    @default("DRAFT")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([schoolId, campusId, status])
  @@index([studentId])
  @@map("intervention_plans")
}

model PromptTemplate {
  id           String   @id @default(uuid())
  schoolId     String?  @map("school_id")
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId     String?  @map("campus_id")
  role         String
  feature      String
  version      String
  systemPrompt String   @map("system_prompt") @db.Text
  userPrompt   String   @map("user_prompt") @db.Text
  content      Json?
  isActive     Boolean  @default(true) @map("is_active")
  status       String   @default("APPROVED")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId, role, feature])
  @@map("prompt_templates")
}

model ParentConversation {
  id        String   @id @default(uuid())
  schoolId  String   @default("") @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String?  @map("campus_id")
  userId    String   @map("user_id")
  studentId String?  @map("student_id")
  question  String   @db.Text
  answer    String   @db.Text
  source    String   @default("APPROVED_FAQ")
  status    String   @default("DRAFT")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId, userId])
  @@map("parent_conversations")
}

model ConsentLog {
  id          String   @id @default(uuid())
  schoolId    String   @default("") @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String?  @map("campus_id")
  userId      String   @map("user_id")
  feature     String
  consentType String   @map("consent_type")
  status      String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([schoolId, campusId, userId])
  @@map("consent_logs")
}

model NotificationTemplate {
  id                   String   @id @default(uuid())
  schoolId             String?  @map("school_id")
  school               School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId             String?  @map("campus_id")
  campus               Campus?  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  key                  String
  channel              String
  title                String
  subject              String?
  body                 String   @db.Text
  variables            Json?
  isSensitive          Boolean  @default(false) @map("is_sensitive")
  requiresApprovedData Boolean  @default(false) @map("requires_approved_data")
  status               String   @default("APPROVED")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([schoolId, campusId, key, channel])
  @@map("notification_templates")
}

model ParentCommunication {
  id                String    @id @default(uuid())
  schoolId          String    @default("") @map("school_id")
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId          String?   @map("campus_id")
  campus            Campus?   @relation(fields: [campusId], references: [id], onDelete: SetNull)
  studentId         String?   @map("student_id")
  student           Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  parentUserId      String?   @map("parent_user_id")
  parent            User?     @relation("ParentCommunicationParent", fields: [parentUserId], references: [id], onDelete: SetNull)
  createdById       String?   @map("created_by_id")
  createdBy         User?     @relation("ParentCommunicationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  templateKey       String    @map("template_key")
  channel           String
  recipientName     String?   @map("recipient_name")
  recipient         String
  subject           String?
  body              String    @db.Text
  attachmentUrl     String?   @map("attachment_url")
  relatedType       String?   @map("related_type")
  relatedId         String?   @map("related_id")
  status            String    @default("PENDING")
  providerMessageId String?   @map("provider_message_id")
  failedReason      String?   @map("failed_reason") @db.Text
