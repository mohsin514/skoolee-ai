// A support incident is the school-approved reason for bounded vendor support.
// Actor IDs are immutable audit identities and intentionally have no User FK.
model SupportIncident {
  id               String   @id @default(uuid())
  schoolId         String   @map("school_id")
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reference        String   @unique
  purpose          String   @db.Text
  impact           String   @db.Text
  status           String   @default("open")
  ownerActorId     String   @map("owner_actor_id")
  closureEvidence String?  @map("closure_evidence") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  closedAt         DateTime? @map("closed_at")
  grants           SupportGrant[]

  @@index([schoolId, status, updatedAt])
  @@map("support_incidents")
}

model SupportGrant {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  incidentId      String   @map("incident_id")
  incident        SupportIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  requestedById   String   @map("requested_by_id")
  approvedById    String?  @map("approved_by_id")
  purpose         String   @db.Text
  scope           String[]
  actions         String[] @default(["read"])
  status          String   @default("pending")
  expiresAt       DateTime @map("expires_at")
  startedAt       DateTime? @map("started_at")
