{
  "name": "skoolee-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/check-commercial-contract.ts && npm run check:ui && npm run check:capabilities && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:authz && pnpm run test:navigation && pnpm run test:notifications && pnpm run test:tour && pnpm run test:locale && pnpm run test:commercial && pnpm run test:deployment && pnpm run test:pilots && pnpm run test:db-pool && pnpm run test:dashboard && pnpm run test:realtime && pnpm run test:students && pnpm run test:otp && pnpm run test:email && pnpm run test:educator-eval && pnpm run test:audit-trail && pnpm run test:guardian-consent && pnpm run test:teaching-mode && pnpm run test:password-reset && pnpm run test:logo && pnpm run test:grade-weights && pnpm run test:weekend && pnpm run test:subject-setup && pnpm run test:year-dates",
    "test:password-reset": "node --import tsx --test tests/password-reset/*.test.ts",
    "test:teaching-mode": "node --import ./tests/support/server-only.mjs --import tsx --test tests/academic/teaching-mode.test.ts",
    "test:weekend": "node --import ./tests/support/server-only.mjs --import tsx --test tests/academic/weekend-rules.test.ts",
    "test:grade-weights": "node --import ./tests/support/server-only.mjs --import tsx --test tests/academic/grade-weights.test.ts",
    "test:year-dates": "node --import ./tests/support/server-only.mjs --import tsx --test tests/academic/year-dates.test.ts",
    "test:subject-setup": "node --import ./tests/support/server-only.mjs --import tsx --test tests/academic/subject-setup.test.ts",
    "test:class-setup": "node --import ./tests/support/server-only.mjs --import tsx --test tests/academic/class-setup.test.ts",
    "test:audit-trail": "node --import ./tests/support/server-only.mjs --import tsx --test tests/audit/audit-trail.test.ts",
    "test:educator-eval": "node --import ./tests/support/server-only.mjs --import tsx --test tests/ai-evaluation/*.test.ts",
    "eval:educator": "node --import ./tests/support/server-only.mjs --import tsx scripts/eval-educator.ts",
    "test:guardian-consent": "node --experimental-test-module-mocks --import ./tests/support/server-only.mjs --import tsx --test --test-force-exit tests/family/guardian-consent.test.ts",
    "test:students": "node --import ./tests/support/server-only.mjs --import tsx --test tests/students/*.test.ts",
    "test:period-setup": "node --experimental-test-module-mocks --import ./tests/support/server-only.mjs --import tsx --test --test-force-exit tests/timetable/period-setup.test.ts",
    "test:realtime": "node --import tsx --test tests/realtime/*.test.ts",
    "test:email": "node --import ./tests/support/server-only.mjs --import tsx --test tests/email/*.test.ts",
    "test:otp": "node --import ./tests/support/server-only.mjs --import tsx --test tests/otp/*.test.ts",
    "test:db-pool": "node --import tsx --test tests/deployment/db-pool.test.ts",
    "test:dashboard": "node --import ./tests/support/server-only.mjs --import tsx --experimental-test-module-mocks --test --test-force-exit tests/dashboard/*.test.ts",
    "test:logo": "node --import ./tests/support/server-only.mjs --import tsx --test tests/school/logo-policy.test.ts",
    "check:ui": "node --import tsx --test tests/design-system/adoption.test.ts",
    "check:capabilities": "node --import ./tests/support/server-only.mjs --import tsx scripts/ai-workflows/check-capabilities.ts",
    "test:pilots": "node --import ./tests/support/server-only.mjs --import tsx --test tests/pilots/charter.test.ts tests/pilots/findings.test.ts tests/pilots/scoped-exchange.test.ts tests/pilots/qa-seed-plan.test.ts tests/pilots/readiness-service.test.ts tests/pilots/go-no-go.test.ts",
    "test:pilots:db": "node --import ./tests/support/server-only.mjs --import tsx --test tests/pilots/scoped-exchange.database.test.ts",
    "test:navigation": "node --import ./tests/support/server-only.mjs --import tsx --test \"tests/navigation/*.test.{ts,tsx}\"",
    "test:tour": "node --import ./tests/support/server-only.mjs --import tsx --test tests/tour/*.test.ts",
    "test:authz": "node --import ./tests/support/server-only.mjs --import tsx --test tests/authz/*.test.ts",
    "test:notifications": "node --import ./tests/support/server-only.mjs --import tsx --test tests/notifications/links.test.ts",
    "test:school-ai": "node scripts/run-school-ai-tests.mjs",
    "test:school-ai:db": "node scripts/run-school-ai-tests.mjs --database",
    "test:ai-workflows": "node scripts/run-ai-workflows-tests.mjs",
    "test:ai-workflows:db": "node scripts/run-ai-workflows-tests.mjs --database",
    "test:ai-workflows:load": "node --import ./tests/support/server-only.mjs --import tsx scripts/ai-workflows/load-test.ts",
    "test:ai-workflows:live": "node --import ./tests/support/server-only.mjs --import tsx scripts/ai-workflows/live-smoke.ts",
    "test:school-ai:e2e": "playwright test --config tests/school-ai/playwright.config.ts",
    "audit:ui": "node --import tsx scripts/ui-adoption-inventory.ts",
    "worker:outbox": "tsx src/workers/outbox-worker.ts",
    "test:whatsapp": "node --import ./tests/support/server-only.mjs --import tsx --test tests/whatsapp/*.test.ts",
    "test:outbox": "node --import tsx --test tests/outbox/outbox.test.ts",
    "test:outbox:api": "node --import ./tests/support/server-only.mjs --import tsx --test tests/outbox/api.test.ts",
    "test:logout": "node --import tsx --test \"tests/logout/*.test.ts\"",
    "test:logout:remote": "TEST_TARGET=remote node --import tsx --test \"tests/logout/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:remote": "TEST_TARGET=remote playwright test",
    "db:reset": "prisma db push --force-reset --accept-data-loss",
    "db:seed": "prisma db seed",
    "db:sync": "prisma db push",
    "app:sync": "cap sync",
    "app:android": "cap sync android && cap open android",
    "app:ios": "cap sync ios && cap open ios",
    "app:desktop:dev": "tauri dev",
    "app:desktop:build": "tauri build",
    "app:icons": "tauri icon public/icon-1024.png",
    "test:report-versions": "node --import ./tests/support/server-only.mjs --import tsx --test tests/report-versions/version.test.ts",
    "test:onboarding": "node --import tsx --test tests/onboarding/setup-state.test.ts tests/onboarding/launch-plan.test.ts",
    "test:onboarding:launch": "playwright test --config tests/onboarding/launch-guide.config.ts",
    "test:onboarding:db": "node --import tsx --test tests/onboarding/setup.database.test.ts",
    "test:onboarding:browser": "node --import tsx --test --test-concurrency=1 tests/onboarding/onboarding.browser.test.ts",
    "test:commercial": "node --import ./tests/support/server-only.mjs --import tsx --test tests/commercial/contract.test.ts tests/commercial/ai-cost-report.test.ts",
    "test:commercial:db": "node --import tsx --test tests/commercial/contract.database.test.ts",
    "check:commercial": "tsx scripts/check-commercial-contract.ts",
    "check:ai-release": "tsx scripts/check-ai-release.ts",
    "check:audit-coverage": "node scripts/audit-coverage.mjs --check",
    "test:mfa": "node --import tsx --test tests/mfa/*.test.ts",
    "test:locale": "node --import ./tests/support/server-only.mjs --import tsx --test tests/locale/package.test.ts",
    "test:locale:db": "node --import tsx --test tests/locale/database.test.ts",
    "test:cohort-cycle": "node --import ./tests/support/server-only.mjs --import tsx --test tests/school-ai/cohort-cycle.test.ts",
    "test:assessment-locale": "node --import ./tests/support/server-only.mjs --import tsx --test tests/school-ai/mixed-math-locale.test.ts tests/school-ai/paper-print.test.ts tests/school-ai/paper-accessibility.test.ts",
    "test:corrections": "node --import tsx --test tests/corrections/domain.test.ts tests/corrections/integration.test.ts",
    "test:support-access:local": "tsx scripts/sko-215-local-acceptance.ts",
    "test:support-ui:local": "tsx scripts/sko-215-ui-acceptance.ts",
    "test:school-ai:load": "node --import tsx scripts/school-ai-exam-load.ts",
    "calibrate:school-ai": "node --import tsx scripts/school-ai-calibration.ts",
    "seed:curriculum-packs": "node --import ./tests/support/server-only.mjs --import tsx scripts/seed-curriculum-packs.ts",
    "test:curriculum-packs": "node --import ./tests/support/server-only.mjs --import tsx --test tests/school-ai/curriculum-pack-registry.test.ts tests/school-ai/curriculum-contract.test.ts",
    "test:curriculum-packs:db": "node --import ./tests/support/server-only.mjs --import tsx --test --test-force-exit --test-concurrency=1 tests/school-ai/curriculum-packs.database.test.ts tests/school-ai/curriculum-pack-enforcement.database.test.ts",
    "qa:seed": "node --import ./tests/support/server-only.mjs --import tsx scripts/qa/seed-pilot.ts",
    "test:deployment": "node --test tests/deployment/*.test.mjs",
    "smoke:deployment": "node scripts/deployment/smoke.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1027.0",
