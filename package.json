    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.39",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "playwright": "^1.62.1",
