# ──────────────────────────────────────────────
# SkooleeAI — PRODUCTION environment (Vercel: skoolee-ai-prod, branch: production)
# Placeholders only. Real values go in the Vercel project's Env Vars.
# Shared Supabase DB across ALL environments — see docs/ENVIRONMENTS.md.
# ──────────────────────────────────────────────

# ── Per-environment (DIFFERS per env) ─────────
NEXT_PUBLIC_APP_URL="https://app.skooleeai.com"
EMAIL_DEV_MODE="false"

# ── Database (THIS ENV'S OWN Supabase project — not shared) ──
DATABASE_URL="postgres://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
POSTGRES_PRISMA_URL="postgres://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ── Supabase (THIS ENV'S OWN project) ──────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWT_SECRET=""

# ── Auth (SHARED — same secret so sessions validate across envs) ──
AUTH_SECRET=""                 # openssl rand -base64 32

# ── AI Providers (SHARED) ─────────────────────
# OpenAI only, on purpose — student data + DPA. Do NOT add pollinations.
AI_PROVIDER="openai"
AI_PROVIDER_ORDER="openai"
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
OLLAMA_MODEL="llama3.2"

# ── Email / SMTP (SHARED) ─────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""                   # Gmail App Password
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Skoolee AI"

# ── Redis / BullMQ (SHARED) ───────────────────
REDIS_URL=""

# ── Payments / Storage / WhatsApp (optional, SHARED) ──
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_BASIC_PRICE_ID=""
# STRIPE_PRO_PRICE_ID=""
