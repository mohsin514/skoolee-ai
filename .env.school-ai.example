# Additive School AI configuration. Do not put live secrets in this example.
# The existing text gateway requires AI_PROVIDER=openai and OPENAI_API_KEY.
# Choose a model approved and evaluated for your school deployment.
AI_PROVIDER=openai
OPENAI_MODEL=

# Media cannot be pseudonymized by the text gateway. Keep it disabled until an
# appropriate document/audio processing policy is approved for the deployment.
SCHOOL_AI_MEDIA_EGRESS_APPROVED=false
SCHOOL_AI_DOCUMENT_MODEL=
SCHOOL_AI_TRANSCRIPTION_MODEL=

# Original evidence: use the existing private S3 configuration OR a durable,
# private, absolute filesystem volume. Never use public/ or an ephemeral volume.
SCHOOL_AI_STORAGE_DIR=
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_ENDPOINT=

# Announcements use the app's existing server-side email provider and outbox
# worker configuration (including Redis). Keep outbound guards on for local QA.
EMAIL_DEV_MODE=true
DISABLE_OUTBOUND_MESSAGES=true
# Review real provider configuration before enabling delivery in a deployment.
# Provider acceptance is not a verified delivery/read receipt.

# Optional SMS delivery through an approved Twilio Messaging Service.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=

# Optional WhatsApp delivery. Choose the supported Graph API version for your
# deployment. Only exact, approved, static BODY-only templates are accepted.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=
# Template JSON is configuration, never generated from a model response.
# WHATSAPP_ANNOUNCEMENT_TEMPLATES_JSON=[{"id":"school_notice_en","name":"school_notice","language":"en","providerLanguage":"en","subject":"School notice","body":"The school office is open today."}]
# Each guardian channel also requires current communication rights, explicit
# consent and verified contact evidence recorded in the application.

# The selected exam deployment is standard browser, without device lockdown.
# Optional camera/screen recording is configured per assignment before the
# first attempt. Private storage and the outbox worker are required for clip
# storage/retention. Candidate consent remains optional; no audio is captured.
# No variable enables operating-system or browser-tab lockdown.
