# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.codex-deps
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.env*.local

# ── native app build artifacts (sources android/ ios/ src-tauri are committed) ──
# android
/android/.gradle/
/android/.idea/
/android/build/
/android/app/build/
/android/local.properties
/android/capacitor-cordova-android-plugins/src

# ios
/ios/App/Pods/
/ios/App/build/
/ios/DerivedData/

# tauri / rust
/src-tauri/target/
/src-tauri/gen/
/src-tauri/Cargo.lock

# runtime-generated report card PDFs (contain student PII)
/public/generated/

# QA fixtures — regenerable, and must never be published.
# fixtures.json holds signed skoolee_token JWTs for every test persona. They are
# signed with the real AUTH_SECRET, so on a public repo they are credentials,
# not test data. Rebuild with:
#   node scripts/qa/seed-fixtures.mjs && node scripts/qa/capture-tokens.mjs
docs/qa/fixtures.json
# Full database dump taken as a pre-QA restore point (~18MB).
docs/qa/evidence/*.sql

# JetBrains local caches (not shared config)
.idea/caches/
